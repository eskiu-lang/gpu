// The glTF loader against tests/data/textured_quad.glb and skin_anim.gltf
// (made by tools/gen_test_models.py): values, sparse accessors, strips,
// animation sampling, joint matrices, and errors on damaged files.
import <io>;
import <mem>;
import <fs>;
import <libc>;
import <gpu/math>;
import <gpu/gltf>;
import <gpu/image>;

int fails = 0;

void check(string what, bool ok) {
    if (!ok) {
        printf("FAIL %s\n", what);
        fails++;
    }
}

bool near(float a, float b) {
    return fabs((double)(a - b)) < 0.0001;
}

bool near3(Vec3 a, Vec3 b) {
    return near(a.x, b.x) && near(a.y, b.y) && near(a.z, b.z);
}

void quad() {
    Result<Gltf, string> r = gltf_load("tests/data/textured_quad.glb");
    check("load textured_quad.glb", r.ok);
    if (!r.ok) {
        printf("  %s\n", r.error);
        return;
    }
    Gltf g = r.value;
    defer g.free();
    check("one mesh, one primitive", g.meshes.size == 1 && g.meshes.data[0].primitives.size == 1);
    GltfPrimitive* p = &g.meshes.data[0].primitives.data[0];
    check("4 vertices, 6 indices", p.vertex_count == 4 && p.index_count == 6);
    check("sparse positions", near(p.positions[3], 1.0) && near(p.positions[4], -1.0) && near(p.positions[7], 1.0));
    check("uvs", p.uvs != null && near(p.uvs[1], 1.0) && near(p.uvs[2], 1.0));
    check("indices", p.indices[3] == 0 && p.indices[4] == 2 && p.indices[5] == 3);
    GltfMaterial* m = &g.materials.data[0];
    check("unlit material with a texture", m.unlit && m.base_color_texture.texture == 0 && near(m.base_color.w, 1.0));
    check("nearest clamped sampler", g.samplers.size == 1 && g.samplers.data[0].mag_filter == 9728 && g.samplers.data[0].wrap_s == 33071);
    GltfImage* im = &g.images.data[0];
    Result<Image, string> dec = image_decode(im.data, im.len);
    check("embedded png decodes", dec.ok && dec.value.width == 4 && dec.value.rgba[0] == 255 && dec.value.rgba[1] == 0);
    if (dec.ok) dec.value.free();
}

void skin() {
    Result<Gltf, string> r = gltf_load("tests/data/skin_anim.gltf");
    check("load skin_anim.gltf", r.ok);
    if (!r.ok) {
        printf("  %s\n", r.error);
        return;
    }
    Gltf g = r.value;
    defer g.free();
    GltfPrimitive* p = &g.meshes.data[0].primitives.data[0];
    check("strip of 6 becomes 4 triangles", p.mode == GLTF_TRIANGLES && p.index_count == 12);
    check("strip winding alternates", p.indices[3] == 1 && p.indices[4] == 3 && p.indices[5] == 2);
    check("joints and weights", p.joints[8] == 0 && p.joints[9] == 1 && near(p.weights[9], 0.5) && p.joints[16] == 1);
    check("hierarchy", g.nodes.data[2].parent == 1 && g.roots.size == 2);
    GltfAnimation* a = &g.animations.data[0];
    check("animation duration 2", near(a.duration, 2.0) && a.channels.size == 3);

    g.animate(0, 0.5);
    Quat q = g.nodes.data[2].rotation;
    Quat want = quat_axis_angle(Vec3{0.0, 0.0, 1.0}, 0.7853982);
    check("linear rotation is slerped", near(q.x, want.x) && near(q.z, want.z) && near(q.w, want.w));
    check("step translation holds the first key", near3(g.nodes.data[1].translation, Vec3{0.0, 0.0, 0.0}));
    g.animate(0, 1.0);
    check("step translation at the second key", near3(g.nodes.data[1].translation, Vec3{1.0, 0.0, 0.0}));
    check("cubic scale with flat tangents", near3(g.nodes.data[1].scale, Vec3{2.0, 2.0, 2.0}));
    g.animate(0, 3.0);
    check("time wraps around the duration", near3(g.nodes.data[1].scale, Vec3{2.0, 2.0, 2.0}));

    g.animate(0, 0.0);
    *Mat4 world = alloc<Mat4>(g.nodes.size);
    defer free(world);
    g.world(world);
    Mat4[2] jm;
    g.joint_matrices(0, world, &jm[0]);
    check("rest pose joint matrices are identity", near3(jm[1].point(Vec3{0.3, 2.0, 0.0}), Vec3{0.3, 2.0, 0.0}));
    g.animate(0, 1.0);
    g.world(world);
    g.joint_matrices(0, world, &jm[0]);
    Vec3 tip = jm[1].point(Vec3{0.0, 2.0, 0.0});
    check("bent tip: scaled by 2, rotated 90 about z, moved by 1", near3(tip, Vec3{-1.0, 2.0, 0.0}));
}

void errors() {
    *uint8 junk = alloc<uint8>(64);
    defer free(junk);
    check("not json", !gltf_parse(junk, 64, null).ok);
    string bad = "{\"asset\":{\"version\":\"2.0\"},\"extensionsRequired\":[\"KHR_draco_mesh_compression\"]}";
    Result<Gltf, string> d = gltf_parse((*uint8)bad, (uint64)strlen(bad), null);
    check("draco is rejected", !d.ok && strstr(d.error, "KHR_draco_mesh_compression") != null);
    string v1 = "{\"asset\":{\"version\":\"1.0\"}}";
    check("glTF 1.0 is rejected", !gltf_parse((*uint8)v1, (uint64)strlen(v1), null).ok);
    string idx = "{\"asset\":{\"version\":\"2.0\"},\"meshes\":[{\"primitives\":[{\"attributes\":{\"POSITION\":7}}]}]}";
    check("a missing accessor is an error", !gltf_parse((*uint8)idx, (uint64)strlen(idx), null).ok);

    int64 n = 0;
    *uint8 glb = fs_read_all("tests/data/textured_quad.glb", &n);
    defer free(glb);
    *uint8 copy = alloc<uint8>(n);
    defer free(copy);
    int ok = 0;
    for (cut in 0..n) {
        Result<Gltf, string> r = gltf_parse(glb, (uint64)cut, null);
        if (r.ok) {
            ok++;
            r.value.free();
        }
    }
    check("every truncated glb is rejected", ok == 0);
    uint32 seed = 12345;
    for (round in 0..400) {
        memcpy(copy, glb, n);
        for (k in 0..4) {
            seed = seed * 1103515245 + 12345;
            int64 at = (int64)(seed >> 8) % n;
            copy[at] = (uint8)(seed >> 3);
        }
        Result<Gltf, string> r = gltf_parse(copy, (uint64)n, null);
        if (r.ok) r.value.free();
    }
}

int main() {
    quad();
    skin();
    errors();
    printf("gltf: %d failures\n", fails);
    return fails == 0 ? 0 : 1;
}
