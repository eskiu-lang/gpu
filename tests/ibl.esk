// Image-based lighting (<gpu/ibl>) against analytic results:
// - a constant environment gives the same constant back in the irradiance cube
//   and in every level of the specular cube (any roughness);
// - an environment of radiance max(y, 0) (the sky brighter towards the
//   zenith, black below the horizon) gives the cosine-weighted average
//   radiance 2/3 for a normal pointing up, 2/(3 pi) for a horizontal one and 0
//   pointing down;
// - the BRDF table: at the smallest roughness scale and bias are
//   1 - (1 - NdotV)^5 and (1 - NdotV)^5 (H = N, visibility 1), and other texels
//   match a numerical quadrature of the same integral (Smith-Schlick, k = a/2)
//   computed in Python; scale + bias never exceeds 1.
// Tolerances absorb half floats, GGX sampling and software rasterizers.
import <io>;
import <mem>;
import <math>;
import <gpu>;
import <gpu/image>;
import <gpu/ibl>;

int fails = 0;

void check(string what, bool ok) {
    if (!ok) {
        printf("FAIL %s\n", what);
        fails++;
    }
}

float half_to_float(uint16 h) {
    int e = (int)((h >> 10) & 31);
    int m = (int)(h & 1023);
    float v = 0.0;
    if (e == 0) v = (float)m / 1024.0 / 16384.0;
    else v = (1.0 + (float)m / 1024.0) * (float)pow(2.0, (double)(e - 15));
    return (h & 0x8000) != 0 ? -v : v;
}

void near(string what, float got, float want, float tol) {
    if (fabs((double)(got - want)) > (double)tol) {
        printf("FAIL %s: %f, want %f (+-%f)\n", what, (double)got, (double)want, (double)tol);
        fails++;
    }
}

// Texel (x, y) of an RGBA16Float level read back into px (w texels a row).
float red(*uint16 px, int w, int x, int y) {
    return half_to_float(px[(y * w + x) * 4]);
}

Result<int, string> constant(*Gpu gpu) {
    HdrBitmap env = HdrBitmap{16, 8, alloc<float>(16 * 8 * 4)};
    defer env.free();
    for (i in 0..16 * 8) {
        env.rgba[i * 4] = 0.5;
        env.rgba[i * 4 + 1] = 0.25;
        env.rgba[i * 4 + 2] = 2.0;
        env.rgba[i * 4 + 3] = 1.0;
    }
    GpuIblOptions o = GpuIblOptions{environment_size: 32, irradiance_size: 8, specular_size: 16, specular_mips: 4,
        brdf_size: 8, samples: 64, brdf_samples: 64};
    GpuIbl ibl = gpu.ibl(&env, &o)?;
    defer ibl.release();
    check("irradiance cube", ibl.irradiance.width == 8 && ibl.irradiance.layers == 6);
    check("specular mips", ibl.specular.mips == 4 && ibl.max_lod() == 3.0);
    check("brdf format", ibl.brdf.format == WGPUTextureFormat_RG16Float);
    uint16[1024] px;
    float worst = 0.0;
    for (face in 0..6) {
        ibl.irradiance.read_level((uint32)face, 0, &px[0])?;
        for (i in 0..64) {
            float[3] want = {0.5, 0.25, 2.0};
            for (c in 0..3) {
                float d = (float)fabs((double)(half_to_float(px[i * 4 + c]) - want[c])) / want[c];
                if (d > worst) worst = d;
            }
        }
    }
    near("constant environment: irradiance (worst relative error)", worst, 0.0, 0.01);
    worst = 0.0;
    for (mip in 0..4) {
        int w = 16 >> mip;
        for (face in 0..6) {
            ibl.specular.read_level((uint32)face, (uint32)mip, &px[0])?;
            for (i in 0..w * w) {
                float d = (float)fabs((double)(half_to_float(px[i * 4 + 2]) - 2.0)) / 2.0;
                if (d > worst) worst = d;
            }
        }
    }
    near("constant environment: prefiltered specular, every roughness (worst relative error)", worst, 0.0, 0.01);
    return Ok<int, string>(0);
}

Result<int, string> sky(*Gpu gpu) {
    int w = 128;
    int h = 64;
    HdrBitmap env = HdrBitmap{(uint32)w, (uint32)h, alloc<float>(w * h * 4)};
    defer env.free();
    for (y in 0..h) {
        double lat = (0.5 - ((double)y + 0.5) / (double)h) * 3.14159265358979;
        float l = (float)sin(lat);
        if (l < 0.0) l = 0.0;
        for (x in 0..w) {
            for (c in 0..3) env.rgba[(y * w + x) * 4 + c] = l;
            env.rgba[(y * w + x) * 4 + 3] = 1.0;
        }
    }
    GpuIblOptions o = GpuIblOptions{environment_size: 64, irradiance_size: 8, specular_size: 8, specular_mips: 1,
        brdf_size: 8, samples: 16, brdf_samples: 16};
    GpuIbl ibl = gpu.ibl(&env, &o)?;
    defer ibl.release();
    uint16[256] px;
    // Faces +X, -X, +Y, -Y, +Z, -Z; the four texels around each face's center.
    float[6] want = {0.2122, 0.2122, 0.6667, 0.0, 0.2122, 0.2122};
    string[6] names = {"+X", "-X", "+Y", "-Y", "+Z", "-Z"};
    for (face in 0..6) {
        ibl.irradiance.read_level((uint32)face, 0, &px[0])?;
        float avg = (red(&px[0], 8, 3, 3) + red(&px[0], 8, 4, 3) + red(&px[0], 8, 3, 4) + red(&px[0], 8, 4, 4)) / 4.0;
        printf("  irradiance %s: %f\n", names[face], (double)avg);
        near("sky irradiance at a face center", avg, want[face], 0.03);
    }
    return Ok<int, string>(0);
}

Result<int, string> brdf(*Gpu gpu) {
    GpuTexture lut = gpu.brdf_lut(32, 1024)?;
    defer lut.release();
    uint16[2048] px;
    lut.read(&px[0])?;
    int[5] xs = {0, 4, 12, 20, 31};
    for (k in 0..5) {
        int x = xs[k];
        float nv = ((float)x + 0.5) / 32.0;
        float b = (float)pow(1.0 - (double)nv, 5.0);
        near("brdf scale at roughness 0", half_to_float(px[x * 2]), 1.0 - b, 0.02);
        near("brdf bias at roughness 0", half_to_float(px[x * 2 + 1]), b, 0.02);
    }
    // (x, y, scale, bias) from tests' quadrature of the split-sum integral.
    float[20] refs = {15.0, 15.0, 0.7315, 0.0215, 31.0, 31.0, 0.3239, 0.0, 7.0, 23.0, 0.6001, 0.0233,
        24.0, 8.0, 0.9695, 0.0012, 31.0, 16.0, 0.8783, 0.0};
    for (k in 0..5) {
        int x = (int)refs[k * 4];
        int y = (int)refs[k * 4 + 1];
        int i = (y * 32 + x) * 2;
        near("brdf scale against quadrature", half_to_float(px[i]), refs[k * 4 + 2], 0.03);
        near("brdf bias against quadrature", half_to_float(px[i + 1]), refs[k * 4 + 3], 0.02);
    }
    float most = 0.0;
    for (i in 0..32 * 32) {
        float s = half_to_float(px[i * 2]) + half_to_float(px[i * 2 + 1]);
        if (s > most) most = s;
    }
    near("brdf scale + bias stays within 1", most < 1.0 ? 1.0 : most, 1.0, 0.01);
    return Ok<int, string>(0);
}

int main() {
    Result<Gpu, string> g = gpu_open();
    if (!g.ok) {
        printf("error: %s\n", g.error);
        return 1;
    }
    Gpu gpu = g.value;
    defer gpu.release();
    Result<int, string> r = constant(&gpu);
    if (r.ok) r = sky(&gpu);
    if (r.ok) r = brdf(&gpu);
    if (!r.ok) {
        printf("error: %s\n", r.error);
        return 1;
    }
    printf("ibl: %d failures\n", fails);
    return fails == 0 ? 0 : 1;
}
