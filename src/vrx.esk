// vrx.esk: ViroReact's .vrx models, the FBX files that Viro's ViroFBX tool converts.
//
// vrx_load returns the same Gltf that gltf_load does, so <gpu/model> and <scene> draw and
// animate a .vrx file as they do a glTF one:
//
//     Gltf data = vrx_load("pug.vrx")?;
//     defer data.free();
//
// A .vrx file is a zlib-compressed protobuf (`viro.Node`): an outer node holding the
// skeleton and the model's root nodes. Each node has a position, a rotation in degrees
// (applied as ViroReact applies Euler angles: X, then Y, then Z) and a scale. Its geometry
// is one interleaved vertex buffer described by sources (position, normal, texture
// coordinate, tangent, color) and one element (index list) per material; each element
// becomes a primitive of the node's mesh, and element i takes material i modulo the number
// of materials, as Viro does.
//
// Materials follow Viro's lighting models: Constant is unlit, Lambert is fully rough,
// Blinn and Phong map the shininess to a roughness, and PhysicallyBased reads its roughness
// and metalness (separate textures in the file, joined into glTF's metallic-roughness
// texture: roughness in green, metalness in blue). The diffuse color and texture are the
// base color, transparency below 1 blends, the normal and ambient occlusion maps carry over,
// and the specular, reflective and emission maps are dropped, as Viro's loader drops them.
// Textures (PNG, JPEG, or KTX as Viro's Android projects ship them) are read relative to
// the file's directory; a missing one leaves the material untextured.
//
// A skinned geometry gets the skeleton as joint nodes under its own node, with the inverse
// bind matrices Viro computes (each bone's bind transform times the geometry's), so the
// joint matrices equal Viro's bone transforms. Skeletal animations become translation,
// rotation and scale channels on the joints, and keyframe animations channels on their
// node; animations of the same name on several nodes are one animation, as ViroReact plays
// a model's animation by name over its whole hierarchy. The rest pose is the first frame of
// the first skeletal animation, as in Viro.

import <io>;
import <mem>;
import <string>;
import <list>;
import <result>;
import <fs>;
import <path>;
import <libc>;
import <math>;
import <gpu/math>;
import <gpu/gltf>;
import <gpu/inflate>;
import <gpu/image>;
import <gpu/ktx2>;

// A protobuf reader over [p, end).
struct _Pb {
    *uint8 p;
    *uint8 end;
}

uint64 _pb_varint(*_Pb b) {
    uint64 r = 0;
    int s = 0;
    while (b.p < b.end) {
        uint8 c = b.p[0];
        b.p = b.p + 1;
        if (s < 64) r = r | ((uint64)(c & 0x7F) << (uint64)s);
        s += 7;
        if (c < 0x80) return r;
    }
    return r;
}

// The next field's number and wire type; false at the end.
bool _pb_next(*_Pb b, *int field, *int wire) {
    if (b.p >= b.end) return false;
    uint64 t = _pb_varint(b);
    *field = (int)(t >> 3);
    *wire = (int)(t & 7);
    return true;
}

// The bytes of a length-delimited field.
_Pb _pb_bytes(*_Pb b) {
    uint64 n = _pb_varint(b);
    uint64 left = (uint64)(b.end - b.p);
    if (n > left) n = left;
    _Pb s = _Pb{b.p, b.p + (int64)n};
    b.p = b.p + (int64)n;
    return s;
}

void _pb_ahead(*_Pb b, int64 n) {
    if (b.end - b.p < n) b.p = b.end;
    else b.p = b.p + n;
}

void _pb_skip(*_Pb b, int wire) {
    if (wire == 0) _pb_varint(b);
    else if (wire == 1) _pb_ahead(b, 8);
    else if (wire == 2) _pb_bytes(b);
    else if (wire == 5) _pb_ahead(b, 4);
    else b.p = b.end;
}

float _pb_f32(*_Pb b) {
    if (b.end - b.p < 4) {
        b.p = b.end;
        return 0.0;
    }
    float f = 0.0;
    memcpy(&f, b.p, 4);
    b.p = b.p + 4;
    return f;
}

// A float field: one value (fixed32) or a packed run of them.
void _pb_floats(*_Pb b, int wire, *List<float> out) {
    if (wire == 5) {
        List_push(out, _pb_f32(b));
    } else if (wire == 2) {
        _Pb s = _pb_bytes(b);
        while (s.end - s.p >= 4) List_push(out, _pb_f32(&s));
    } else {
        _pb_skip(b, wire);
    }
}

float _pb_float(*_Pb b, int wire) {
    if (wire == 5) return _pb_f32(b);
    if (wire == 0) return (float)(int64)_pb_varint(b);
    _pb_skip(b, wire);
    return 0.0;
}

int64 _pb_int(*_Pb b, int wire) {
    if (wire == 0) return (int64)_pb_varint(b);
    _pb_skip(b, wire);
    return 0;
}

// An integer field: one varint or a packed run of them.
void _pb_ints(*_Pb b, int wire, *List<int> out) {
    if (wire == 0) {
        List_push(out, (int)_pb_varint(b));
    } else if (wire == 2) {
        _Pb s = _pb_bytes(b);
        while (s.p < s.end) List_push(out, (int)_pb_varint(&s));
    } else {
        _pb_skip(b, wire);
    }
}

void _pb_string(*_Pb b, int wire, *String out) {
    if (wire != 2) {
        _pb_skip(b, wire);
        return;
    }
    _Pb s = _pb_bytes(b);
    String_clear(out);
    for (*uint8 q = s.p; q < s.end; q = q + 1) String_push(out, (char)q[0]);
}

// A viro.Node.Matrix (16 floats, column-major); false when it does not hold 16.
bool _vrx_matrix(_Pb m, *Mat4 out) {
    List<float> v;
    defer List_free(&v);
    int f = 0;
    int w = 0;
    while (_pb_next(&m, &f, &w)) {
        if (f == 1) _pb_floats(&m, w, &v);
        else _pb_skip(&m, w);
    }
    if (v.size != 16) return false;
    for (i in 0..16) out.m[i] = v.data[i];
    return true;
}

// A bone of the skeleton: its parent's index (-1 for a root) and its name.
struct _VrxBone {
    int parent;
    String name;
}

// A geometry source: what it holds, where in which buffer.
struct _VrxSource {
    int semantic;
    int count;
    bool floats;
    int comps;
    int bpc;
    int offset;
    int stride;
    bool own;
    _Pb data;
}

// A material visual (diffuse, normal, roughness, ...).
struct _VrxVisual {
    bool has;
    List<float> color;
    String texture;
    float intensity;
    int wrap_s;
    int wrap_t;
    int min;
    int mag;
    int mip;
}

// A joined metallic-roughness texture, by the names it was made of.
struct _VrxJoined {
    String rough;
    String metal;
    int texture;
}

// A skeleton made for a skinned node, which a sibling with the same transform, bind
// matrices and skeletal animations reuses.
struct _VrxRig {
    int parent;
    Vec3 t;
    Quat r;
    Vec3 s;
    int joint0;
    *Mat4 bind;
    List<_Pb> anims;
    List<_Pb> keys;
}

struct _Vrx {
    Gltf g;
    List<_VrxRig> rigs;
    String dir;
    List<_VrxBone> bones;
    List<String> image_paths;
    List<_VrxJoined> joined;
}

const int _VRX_VERTEX = 0;
const int _VRX_NORMAL = 1;
const int _VRX_COLOR = 2;
const int _VRX_TEXCOORD = 3;
const int _VRX_TANGENT = 4;

string _vrx_fail(string what, string detail) {
    String s;
    String_append(&s, "vrx: ");
    String_append(&s, what);
    if (detail != null) String_append(&s, detail);
    return s.data;
}

_VrxSource _vrx_source(_Pb b) {
    _VrxSource s = _VrxSource{floats: false, own: false};
    int f = 0;
    int w = 0;
    while (_pb_next(&b, &f, &w)) {
        if (f == 1) s.semantic = (int)_pb_int(&b, w);
        else if (f == 2) s.count = (int)_pb_int(&b, w);
        else if (f == 3) s.floats = _pb_int(&b, w) != 0;
        else if (f == 4) s.comps = (int)_pb_int(&b, w);
        else if (f == 5) s.bpc = (int)_pb_int(&b, w);
        else if (f == 6) s.offset = (int)_pb_int(&b, w);
        else if (f == 7) s.stride = (int)_pb_int(&b, w);
        else if (f == 8 && w == 2) {
            s.data = _pb_bytes(&b);
            s.own = true;
        } else _pb_skip(&b, w);
    }
    if (s.stride == 0) s.stride = s.comps * s.bpc;
    return s;
}

// Component c of vertex i of a source (0 past its data or its components).
float _vrx_comp(*_VrxSource s, _Pb buf, int i, int c) {
    if (c >= s.comps) return 0.0;
    _Pb d = s.own ? s.data : buf;
    int64 at = (int64)i * (int64)s.stride + (int64)s.offset + (int64)c * (int64)s.bpc;
    if (at < 0 || at + (int64)s.bpc > d.end - d.p) return 0.0;
    *uint8 p = d.p + at;
    if (s.floats && s.bpc == 4) {
        float f = 0.0;
        memcpy(&f, p, 4);
        return f;
    }
    if (s.bpc == 1) return (float)p[0];
    if (s.bpc == 2) return (float)((uint32)p[0] | (uint32)p[1] << 8);
    if (s.bpc == 4) return (float)((uint32)p[0] | (uint32)p[1] << 8 | (uint32)p[2] << 16 | (uint32)p[3] << 24);
    return 0.0;
}

_VrxVisual _vrx_visual(_Pb b) {
    _VrxVisual v = _VrxVisual{has: true, intensity: 1.0};
    int f = 0;
    int w = 0;
    while (_pb_next(&b, &f, &w)) {
        if (f == 1) _pb_floats(&b, w, &v.color);
        else if (f == 2) _pb_string(&b, w, &v.texture);
        else if (f == 3) v.intensity = _pb_float(&b, w);
        else if (f == 5) v.wrap_s = (int)_pb_int(&b, w);
        else if (f == 6) v.wrap_t = (int)_pb_int(&b, w);
        else if (f == 7) v.min = (int)_pb_int(&b, w);
        else if (f == 8) v.mag = (int)_pb_int(&b, w);
        else if (f == 9) v.mip = (int)_pb_int(&b, w);
        else _pb_skip(&b, w);
    }
    return v;
}

void _vrx_visual_free(*_VrxVisual v) {
    List_free(&v.color);
    String_free(&v.texture);
}

bool _vrx_textured(*_VrxVisual v) {
    return v.has && v.texture.len > 0;
}

// The image file name (relative to the model's directory) as an image index, -1 when it
// cannot be read.
int _vrx_image(*_Vrx v, string name) {
    String full;
    defer String_free(&full);
    if (v.dir.data != null && v.dir.len > 0 && path_is_absolute(name) == 0) path_join(&full, v.dir.data, name);
    else String_append(&full, name);
    for (i in 0..v.image_paths.size) {
        if (strcmp(v.image_paths.data[i].data, full.data) == 0) return i;
    }
    int64 n = 0;
    *uint8 data = fs_read_all(full.data, &n);
    if (data == null) return -1;
    GltfImage img;
    String_append(&img.name, name);
    String ext;
    defer String_free(&ext);
    path_extension(&ext, name);
    bool jpeg = ext.data != null && (strcasecmp(ext.data, ".jpg") == 0 || strcasecmp(ext.data, ".jpeg") == 0);
    String_append(&img.mime, ktx_is_ktx(data, (uint64)n) ? "image/ktx" : jpeg ? "image/jpeg" : "image/png");
    img.data = data;
    img.len = (uint64)n;
    img.owned = true;
    List_push(&v.g.images, img);
    String copy;
    String_append(&copy, full.data);
    List_push(&v.image_paths, copy);
    return v.g.images.size - 1;
}

int _vrx_wrap(int w) {
    if (w == 1) return 10497;
    if (w == 3) return 33648;
    return 33071;
}

// A sampler of the visual's wrap and filter modes (shared with an equal one).
int _vrx_sampler(*_Vrx v, *_VrxVisual vis) {
    int mag = vis.mag == 1 ? 9728 : 9729;
    int min = vis.min == 1 ? 9728 : 9729;
    if (vis.mip == 1) min = vis.min == 1 ? 9984 : 9985;
    else if (vis.mip == 2) min = vis.min == 1 ? 9986 : 9987;
    GltfSampler s = GltfSampler{mag, min, _vrx_wrap(vis.wrap_s), _vrx_wrap(vis.wrap_t)};
    for (i in 0..v.g.samplers.size) {
        *GltfSampler o = &v.g.samplers.data[i];
        if (o.mag_filter == s.mag_filter && o.min_filter == s.min_filter && o.wrap_s == s.wrap_s && o.wrap_t == s.wrap_t) return i;
    }
    List_push(&v.g.samplers, s);
    return v.g.samplers.size - 1;
}

int _vrx_texture_of(*_Vrx v, int image, *_VrxVisual vis) {
    if (image < 0) return -1;
    List_push(&v.g.textures, GltfTexture{image, _vrx_sampler(v, vis)});
    return v.g.textures.size - 1;
}

// The texture of a visual, -1 when it has none or its file cannot be read.
int _vrx_texture(*_Vrx v, *_VrxVisual vis) {
    if (!_vrx_textured(vis)) return -1;
    return _vrx_texture_of(v, _vrx_image(v, vis.texture.data), vis);
}

uint32[256] _vrx_crc_table;
bool _vrx_crc_ready = false;

uint32 _vrx_crc(*uint8 p, uint64 n, uint32 crc) {
    if (!_vrx_crc_ready) {
        for (i in 0..256) {
            uint32 c = (uint32)i;
            for (k in 0..8) c = (c & 1) != 0 ? (uint32)0xEDB88320 ^ (c >> 1) : c >> 1;
            _vrx_crc_table[i] = c;
        }
        _vrx_crc_ready = true;
    }
    uint32 c = crc ^ (uint32)0xFFFFFFFF;
    for (i in 0..n) c = _vrx_crc_table[(int)((c ^ (uint32)p[i]) & 255)] ^ (c >> 8);
    return c ^ (uint32)0xFFFFFFFF;
}

void _vrx_be32(*uint8 p, uint32 v) {
    p[0] = (uint8)(v >> 24);
    p[1] = (uint8)(v >> 16);
    p[2] = (uint8)(v >> 8);
    p[3] = (uint8)v;
}

// An RGBA image as a PNG with stored (uncompressed) deflate blocks, so a joined texture
// goes through the same decoder as the file's own images.
*uint8 _vrx_png(*uint8 rgba, uint32 width, uint32 height, *uint64 out_len) {
    uint64 row = (uint64)width * 4 + 1;
    uint64 raw_len = row * (uint64)height;
    uint64 blocks = (raw_len + 65534) / 65535;
    if (blocks == 0) blocks = 1;
    uint64 z_len = 2 + raw_len + blocks * 5 + 4;
    uint64 total = 8 + 25 + 12 + z_len + 12;
    *uint8 out = alloc<uint8>((int64)total);
    uint8[8] sig = {0x89, 'P', 'N', 'G', 0x0D, 0x0A, 0x1A, 0x0A};
    memcpy(out, &sig[0], 8);
    *uint8 ihdr = out + 8;
    _vrx_be32(ihdr, 13);
    memcpy(ihdr + 4, (*uint8)"IHDR", 4);
    _vrx_be32(ihdr + 8, width);
    _vrx_be32(ihdr + 12, height);
    ihdr[16] = 8;
    ihdr[17] = 6;
    ihdr[18] = 0;
    ihdr[19] = 0;
    ihdr[20] = 0;
    _vrx_be32(ihdr + 21, _vrx_crc(ihdr + 4, 17, 0));
    *uint8 idat = ihdr + 25;
    _vrx_be32(idat, (uint32)z_len);
    memcpy(idat + 4, (*uint8)"IDAT", 4);
    *uint8 z = idat + 8;
    z[0] = 0x78;
    z[1] = 0x01;
    uint64 at = 2;
    uint32 a = 1;
    uint32 b = 0;
    uint64 done = 0;
    uint64 block_left = 0;
    for (y in 0..height) {
        for (x in 0..row) {
            if (block_left == 0) {
                uint64 n = raw_len - done;
                if (n > 65535) n = 65535;
                z[at] = done + n == raw_len ? 1 : 0;
                z[at + 1] = (uint8)n;
                z[at + 2] = (uint8)(n >> 8);
                z[at + 3] = (uint8)~n;
                z[at + 4] = (uint8)(~n >> 8);
                at += 5;
                block_left = n;
            }
            uint8 byte = x == 0 ? 0 : rgba[(uint64)y * (uint64)width * 4 + x - 1];
            z[at] = byte;
            at++;
            done++;
            block_left--;
            a = (a + (uint32)byte) % 65521;
            b = (b + a) % 65521;
        }
    }
    _vrx_be32(z + at, (b << 16) | a);
    _vrx_be32(idat + 8 + z_len, _vrx_crc(idat + 4, z_len + 4, 0));
    *uint8 iend = idat + 12 + z_len;
    _vrx_be32(iend, 0);
    memcpy(iend + 4, (*uint8)"IEND", 4);
    _vrx_be32(iend + 8, _vrx_crc(iend + 4, 4, 0));
    *out_len = total;
    return out;
}

// The red channel of image (0 when it is null) at (x, y) of a w x h grid.
uint8 _vrx_red(*Bitmap img, uint32 x, uint32 y, uint32 w, uint32 h) {
    if (img == null || img.rgba == null) return 255;
    uint32 sx = (uint32)((uint64)x * (uint64)img.width / (uint64)w);
    uint32 sy = (uint32)((uint64)y * (uint64)img.height / (uint64)h);
    return img.rgba[((uint64)sy * (uint64)img.width + (uint64)sx) * 4];
}

bool _vrx_decode(*_Vrx v, int image, *Bitmap out) {
    if (image < 0) return false;
    *GltfImage gi = &v.g.images.data[image];
    Result<Bitmap, string> r = image_decode(gi.data, gi.len);
    if (!r.ok) return false;
    *out = r.value;
    return true;
}

// The metallic-roughness texture joined from the roughness and metalness visuals (green
// from the roughness map, blue from the metalness map, each 255 without a map), -1 when
// neither has a readable map.
int _vrx_joined(*_Vrx v, *_VrxVisual rough, *_VrxVisual metal) {
    string rn = _vrx_textured(rough) ? rough.texture.data : "";
    string mn = _vrx_textured(metal) ? metal.texture.data : "";
    for (i in 0..v.joined.size) {
        *_VrxJoined j = &v.joined.data[i];
        if (strcmp(j.rough.data != null ? j.rough.data : "", rn) == 0 && strcmp(j.metal.data != null ? j.metal.data : "", mn) == 0) return j.texture;
    }
    Bitmap r;
    Bitmap m;
    bool hr = _vrx_textured(rough) && _vrx_decode(v, _vrx_image(v, rn), &r);
    bool hm = _vrx_textured(metal) && _vrx_decode(v, _vrx_image(v, mn), &m);
    int tex = -1;
    if (hr || hm) {
        uint32 w = hr ? r.width : m.width;
        uint32 h = hr ? r.height : m.height;
        if (hm && m.width > w) w = m.width;
        if (hm && m.height > h) h = m.height;
        *uint8 px = alloc<uint8>((int64)w * (int64)h * 4);
        for (y in 0..h) {
            for (x in 0..w) {
                uint64 at = ((uint64)y * (uint64)w + (uint64)x) * 4;
                px[at] = 255;
                px[at + 1] = _vrx_red(hr ? &r : null, x, y, w, h);
                px[at + 2] = _vrx_red(hm ? &m : null, x, y, w, h);
                px[at + 3] = 255;
            }
        }
        GltfImage img;
        String_append(&img.name, "metallic_roughness");
        String_append(&img.mime, "image/png");
        img.data = _vrx_png(px, w, h, &img.len);
        img.owned = true;
        free(px);
        List_push(&v.g.images, img);
        String key;
        String_append(&key, "\001joined");
        List_push(&v.image_paths, key);
        tex = _vrx_texture_of(v, v.g.images.size - 1, hr ? rough : metal);
    }
    if (hr) Bitmap_free(&r);
    if (hm) Bitmap_free(&m);
    _VrxJoined j;
    String_append(&j.rough, rn);
    String_append(&j.metal, mn);
    j.texture = tex;
    List_push(&v.joined, j);
    return tex;
}

// Whether the texture's image is a PNG with an alpha channel (gray-alpha, RGBA, or a tRNS
// chunk): Viro blends a material whose diffuse texture has alpha.
bool _vrx_has_alpha(*_Vrx v, int texture) {
    if (texture < 0) return false;
    *GltfImage img = &v.g.images.data[v.g.textures.data[texture].image];
    if (img.len < 33 || img.data[0] != 0x89 || img.data[1] != 'P') return false;
    int ct = (int)img.data[25];
    if (ct == 4 || ct == 6) return true;
    uint64 at = 8;
    while (at + 8 <= img.len) {
        uint64 n = (uint64)img.data[at] << 24 | (uint64)img.data[at + 1] << 16 | (uint64)img.data[at + 2] << 8 | (uint64)img.data[at + 3];
        *uint8 t = img.data + at + 4;
        if (t[0] == 't' && t[1] == 'R' && t[2] == 'N' && t[3] == 'S') return true;
        if (t[0] == 'I' && t[1] == 'D' && t[2] == 'A' && t[3] == 'T') return false;
        at = at + 12 + n;
    }
    return false;
}

// A viro.Node.Geometry.Material as a glTF material; returns its index.
int _vrx_material(*_Vrx v, _Pb b) {
    GltfTextureRef none = GltfTextureRef{-1, 0, 1.0};
    GltfMaterial m = GltfMaterial{base_color: Vec4{1.0, 1.0, 1.0, 1.0}, metallic: 0.0, roughness: 0.5,
        base_color_texture: none, metallic_roughness_texture: none, normal_texture: none,
        occlusion_texture: none, emissive_texture: none, alpha_cutoff: 0.5};
    float shininess = 2.0;
    float transparency = 1.0;
    int model = 2;
    _VrxVisual diffuse;
    _VrxVisual normal;
    _VrxVisual rough;
    _VrxVisual metal;
    _VrxVisual ao;
    int f = 0;
    int w = 0;
    while (_pb_next(&b, &f, &w)) {
        if (f == 1) _pb_string(&b, w, &m.name);
        else if (f == 2) shininess = _pb_float(&b, w);
        else if (f == 4) transparency = _pb_float(&b, w);
        else if (f == 5) model = (int)_pb_int(&b, w);
        else if (f == 11 && w == 2) diffuse = _vrx_visual(_pb_bytes(&b));
        else if (f == 13 && w == 2) normal = _vrx_visual(_pb_bytes(&b));
        else if (f == 17 && w == 2) rough = _vrx_visual(_pb_bytes(&b));
        else if (f == 18 && w == 2) metal = _vrx_visual(_pb_bytes(&b));
        else if (f == 19 && w == 2) ao = _vrx_visual(_pb_bytes(&b));
        else _pb_skip(&b, w);
    }
    if (diffuse.has && diffuse.color.size >= 3) {
        m.base_color = Vec4{diffuse.color.data[0], diffuse.color.data[1], diffuse.color.data[2], 1.0};
    }
    m.base_color_texture.texture = _vrx_texture(v, &diffuse);
    m.normal_texture.texture = _vrx_texture(v, &normal);
    m.occlusion_texture.texture = _vrx_texture(v, &ao);
    if (model == 0) {
        m.unlit = true;
    } else if (model == 1) {
        m.roughness = 1.0;
    } else if (model == 4) {
        m.roughness = rough.has && rough.color.size > 0 && !_vrx_textured(&rough) ? rough.color.data[0] : 1.0;
        m.metallic = metal.has && metal.color.size > 0 && !_vrx_textured(&metal) ? metal.color.data[0] : 0.0;
        if (_vrx_textured(&rough) || _vrx_textured(&metal)) {
            int t = _vrx_joined(v, &rough, &metal);
            if (t >= 0) {
                m.metallic_roughness_texture.texture = t;
                if (_vrx_textured(&metal)) m.metallic = 1.0;
                if (_vrx_textured(&rough)) m.roughness = 1.0;
            }
        }
    } else {
        // Blinn-Phong's exponent as the roughness of a comparable highlight
        float s = shininess < 0.0 ? 0.0 : shininess;
        m.roughness = (float)sqrt(2.0 / ((double)s + 2.0));
    }
    if (transparency < 1.0) {
        m.base_color.w = transparency;
        m.alpha_mode = GLTF_BLEND;
    }
    if (_vrx_has_alpha(v, m.base_color_texture.texture)) m.alpha_mode = GLTF_BLEND;
    _vrx_visual_free(&diffuse);
    _vrx_visual_free(&normal);
    _vrx_visual_free(&rough);
    _vrx_visual_free(&metal);
    _vrx_visual_free(&ao);
    List_push(&v.g.materials, m);
    return v.g.materials.size - 1;
}

// The element's indices as a triangle, line or point list (a strip is unrolled into
// triangles); *mode is the glTF mode.
void _vrx_indices(_Pb e, *List<uint32> out, *int mode) {
    _Pb data = _Pb{null, null};
    int prim = 0;
    int count = 0;
    int bpi = 4;
    int f = 0;
    int w = 0;
    while (_pb_next(&e, &f, &w)) {
        if (f == 1 && w == 2) data = _pb_bytes(&e);
        else if (f == 2) prim = (int)_pb_int(&e, w);
        else if (f == 3) count = (int)_pb_int(&e, w);
        else if (f == 4) bpi = (int)_pb_int(&e, w);
        else _pb_skip(&e, w);
    }
    if (bpi != 1 && bpi != 2 && bpi != 4) bpi = 4;
    int64 n = data.p == null ? 0 : (data.end - data.p) / (int64)bpi;
    List<uint32> raw;
    defer List_free(&raw);
    for (i in 0..n) {
        *uint8 p = data.p + i * (int64)bpi;
        uint32 x = bpi == 1 ? (uint32)p[0] : bpi == 2 ? (uint32)p[0] | (uint32)p[1] << 8
            : (uint32)p[0] | (uint32)p[1] << 8 | (uint32)p[2] << 16 | (uint32)p[3] << 24;
        List_push(&raw, x);
    }
    *mode = GLTF_TRIANGLES;
    if (prim == 1) {
        for (i in 2..raw.size) {
            uint32 a = raw.data[i - 2];
            uint32 b2 = raw.data[i - 1];
            uint32 c = raw.data[i];
            if (a == b2 || b2 == c || a == c) continue;
            if ((i & 1) == 0) {
                List_push(out, a);
                List_push(out, b2);
            } else {
                List_push(out, b2);
                List_push(out, a);
            }
            List_push(out, c);
        }
        return;
    }
    int want = prim == 2 ? count * 2 : prim == 3 ? count : count * 3;
    if (prim == 2) *mode = GLTF_LINES;
    if (prim == 3) *mode = GLTF_POINTS;
    if (want <= 0 || want > raw.size) want = raw.size;
    if (*mode == GLTF_TRIANGLES) want = want / 3 * 3;
    for (i in 0..want) List_push(out, raw.data[i]);
}

// The node's geometry as a mesh; returns the mesh index. skin, when not null, holds the
// bone indices and weights of the vertices.
int _vrx_geometry(*_Vrx v, _Pb b, *_Pb skin) {
    _Pb buf = _Pb{null, null};
    List<_VrxSource> sources;
    defer List_free(&sources);
    List<_Pb> elements;
    defer List_free(&elements);
    GltfMesh mesh;
    int mat_base = v.g.materials.size;
    int f = 0;
    int w = 0;
    while (_pb_next(&b, &f, &w)) {
        if (f == 1) _pb_string(&b, w, &mesh.name);
        else if (f == 2 && w == 2) buf = _pb_bytes(&b);
        else if (f == 3 && w == 2) List_push(&sources, _vrx_source(_pb_bytes(&b)));
        else if (f == 4 && w == 2) List_push(&elements, _pb_bytes(&b));
        else if (f == 5 && w == 2) _vrx_material(v, _pb_bytes(&b));
        else _pb_skip(&b, w);
    }
    int nmat = v.g.materials.size - mat_base;
    int[5] by;
    for (k in 0..5) by[k] = -1;
    int vcount = 0;
    for (i in 0..sources.size) {
        int sem = sources.data[i].semantic;
        if (sem >= 0 && sem < 5 && by[sem] < 0) by[sem] = i;
        if (sem == _VRX_VERTEX && sources.data[i].count > vcount) vcount = sources.data[i].count;
    }
    if (by[_VRX_VERTEX] >= 0) {
        // no more vertices than the buffer holds
        *_VrxSource ps = &sources.data[by[_VRX_VERTEX]];
        _Pb d = ps.own ? ps.data : buf;
        int64 bytes = d.p == null ? 0 : d.end - d.p;
        int64 most = ps.stride > 0 ? bytes / (int64)ps.stride + 1 : 1;
        if ((int64)vcount > most) vcount = (int)most;
    }
    if (vcount < 0) vcount = 0;
    _VrxSource bi = _VrxSource{comps: 0};
    _VrxSource bw = _VrxSource{comps: 0};
    if (skin != null) {
        _Pb s = *skin;
        while (_pb_next(&s, &f, &w)) {
            if (f == 3 && w == 2) bi = _vrx_source(_pb_bytes(&s));
            else if (f == 4 && w == 2) bw = _vrx_source(_pb_bytes(&s));
            else _pb_skip(&s, w);
        }
    }
    bool skinned = skin != null && bi.comps > 0 && bw.comps > 0;
    *int remap = alloc<int>((int64)vcount + 1);
    for (e in 0..elements.size) {
        List<uint32> idx;
        int mode = GLTF_TRIANGLES;
        _vrx_indices(elements.data[e], &idx, &mode);
        if (idx.size == 0 || by[_VRX_VERTEX] < 0) {
            List_free(&idx);
            continue;
        }
        for (i in 0..vcount) remap[i] = -1;
        List<int> used;
        defer List_free(&used);
        for (i in 0..idx.size) {
            uint32 x = idx.data[i];
            if ((int64)x >= (int64)vcount) x = 0;
            if (remap[x] < 0) {
                remap[x] = used.size;
                List_push(&used, (int)x);
            }
            idx.data[i] = (uint32)remap[x];
        }
        GltfPrimitive p;
        p.mode = mode;
        p.material = nmat > 0 ? mat_base + e % nmat : -1;
        p.vertex_count = (uint32)used.size;
        p.index_count = (uint32)idx.size;
        p.indices = idx.data;
        int nv = used.size;
        p.positions = alloc<float>((int64)nv * 3 + 1);
        if (by[_VRX_NORMAL] >= 0) p.normals = alloc<float>((int64)nv * 3 + 1);
        if (by[_VRX_TEXCOORD] >= 0) p.uvs = alloc<float>((int64)nv * 2 + 1);
        if (by[_VRX_TANGENT] >= 0) p.tangents = alloc<float>((int64)nv * 4 + 1);
        if (by[_VRX_COLOR] >= 0) p.colors = alloc<float>((int64)nv * 4 + 1);
        if (skinned) {
            p.joints = alloc<uint32>((int64)nv * 4 + 1);
            p.weights = alloc<float>((int64)nv * 4 + 1);
        }
        for (k in 0..nv) {
            int src = used.data[k];
            *_VrxSource s = &sources.data[by[_VRX_VERTEX]];
            for (c in 0..3) p.positions[k * 3 + c] = _vrx_comp(s, buf, src, c);
            if (p.normals != null) {
                s = &sources.data[by[_VRX_NORMAL]];
                for (c in 0..3) p.normals[k * 3 + c] = _vrx_comp(s, buf, src, c);
            }
            if (p.uvs != null) {
                s = &sources.data[by[_VRX_TEXCOORD]];
                for (c in 0..2) p.uvs[k * 2 + c] = _vrx_comp(s, buf, src, c);
            }
            if (p.tangents != null) {
                s = &sources.data[by[_VRX_TANGENT]];
                for (c in 0..4) p.tangents[k * 4 + c] = _vrx_comp(s, buf, src, c);
                if (s.comps < 4) p.tangents[k * 4 + 3] = 1.0;
            }
            if (p.colors != null) {
                s = &sources.data[by[_VRX_COLOR]];
                for (c in 0..4) p.colors[k * 4 + c] = c < s.comps ? _vrx_comp(s, buf, src, c) : 1.0;
            }
            if (skinned) {
                float sum = 0.0;
                for (c in 0..4) {
                    float j = _vrx_comp(&bi, buf, src, c);
                    float wt = _vrx_comp(&bw, buf, src, c);
                    // a weight on a bone the skeleton does not have, or a negative one, drops
                    if (j < 0.0 || j >= (float)v.bones.size || !(wt > 0.0)) {
                        j = 0.0;
                        wt = 0.0;
                    }
                    p.joints[k * 4 + c] = (uint32)j;
                    p.weights[k * 4 + c] = wt;
                    sum += wt;
                }
                if (sum > 0.0) {
                    for (c in 0..4) p.weights[k * 4 + c] = p.weights[k * 4 + c] / sum;
                } else {
                    p.weights[k * 4] = 1.0;
                }
            }
        }
        p.min = Vec3{p.positions[0], p.positions[1], p.positions[2]};
        p.max = p.min;
        for (k in 0..nv) {
            Vec3 q = Vec3{p.positions[k * 3], p.positions[k * 3 + 1], p.positions[k * 3 + 2]};
            p.min = Vec3{q.x < p.min.x ? q.x : p.min.x, q.y < p.min.y ? q.y : p.min.y, q.z < p.min.z ? q.z : p.min.z};
            p.max = Vec3{q.x > p.max.x ? q.x : p.max.x, q.y > p.max.y ? q.y : p.max.y, q.z > p.max.z ? q.z : p.max.z};
        }
        List_push(&mesh.primitives, p);
    }
    free(remap);
    if (mesh.primitives.size == 0) {
        String_free(&mesh.name);
        return -1;
    }
    List_push(&v.g.meshes, mesh);
    return v.g.meshes.size - 1;
}

// A matrix as translation, rotation and scale (a negative determinant flips the X scale).
void _vrx_decompose(Mat4 m, *Vec3 t, *Quat r, *Vec3 s) {
    *t = Vec3{m.m[12], m.m[13], m.m[14]};
    Vec3 c0 = Vec3{m.m[0], m.m[1], m.m[2]};
    Vec3 c1 = Vec3{m.m[4], m.m[5], m.m[6]};
    Vec3 c2 = Vec3{m.m[8], m.m[9], m.m[10]};
    float sx = c0.length();
    float sy = c1.length();
    float sz = c2.length();
    if (c0.dot(c1.cross(c2)) < 0.0) sx = -sx;
    *s = Vec3{sx, sy, sz};
    if (sx != 0.0) c0 = c0 / sx;
    if (sy != 0.0) c1 = c1 / sy;
    if (sz != 0.0) c2 = c2 / sz;
    // rows of the rotation: r[row][col] with columns c0, c1, c2
    float m00 = c0.x;
    float m10 = c0.y;
    float m20 = c0.z;
    float m01 = c1.x;
    float m11 = c1.y;
    float m21 = c1.z;
    float m02 = c2.x;
    float m12 = c2.y;
    float m22 = c2.z;
    float tr = m00 + m11 + m22;
    Quat q;
    if (tr > 0.0) {
        float k = (float)sqrt((double)(tr + 1.0)) * 2.0;
        q = Quat{(m21 - m12) / k, (m02 - m20) / k, (m10 - m01) / k, 0.25 * k};
    } else if (m00 > m11 && m00 > m22) {
        float k = (float)sqrt((double)(1.0 + m00 - m11 - m22)) * 2.0;
        q = Quat{0.25 * k, (m01 + m10) / k, (m02 + m20) / k, (m21 - m12) / k};
    } else if (m11 > m22) {
        float k = (float)sqrt((double)(1.0 + m11 - m00 - m22)) * 2.0;
        q = Quat{(m01 + m10) / k, 0.25 * k, (m12 + m21) / k, (m02 - m20) / k};
    } else {
        float k = (float)sqrt((double)(1.0 + m22 - m00 - m11)) * 2.0;
        q = Quat{(m02 + m20) / k, (m12 + m21) / k, 0.25 * k, (m10 - m01) / k};
    }
    *r = q.normalize();
}

// The animation called name (made when there is none).
int _vrx_animation(*_Vrx v, *String name) {
    for (i in 0..v.g.animations.size) {
        if (strcmp(v.g.animations.data[i].name.data, name.data) == 0) return i;
    }
    GltfAnimation a;
    String_append(&a.name, name.data);
    List_push(&v.g.animations, a);
    return v.g.animations.size - 1;
}

// Adds a linear channel driving path of node with count keys.
void _vrx_channel(*_Vrx v, int anim, int node, int path, *float times, *float values, int count, int width) {
    *GltfAnimation a = &v.g.animations.data[anim];
    GltfAnimSampler s = GltfAnimSampler{count: (uint32)count, width: width, interpolation: GLTF_LINEAR, value_count: (uint32)count};
    s.times = alloc<float>((int64)count + 1);
    s.values = alloc<float>((int64)count * (int64)width + 1);
    memcpy(s.times, times, (int64)count * 4);
    memcpy(s.values, values, (int64)count * (int64)width * 4);
    List_push(&a.samplers, s);
    List_push(&a.channels, GltfAnimChannel{node: node, path: path, sampler: a.samplers.size - 1, material: -1, slot: 0});
    if (count > 0 && times[count - 1] > a.duration) a.duration = times[count - 1];
}

// The animation's name, or prefix and its index when it has none.
void _vrx_anim_name(*String name, string prefix, int i) {
    if (name.len > 0) return;
    String_append(name, prefix);
    String_appendf(name, "%d", i);
}

// A keyframe animation of node.
void _vrx_keyframes(*_Vrx v, _Pb b, int node, int index) {
    String name;
    defer String_free(&name);
    float duration = 0.0;
    List<float> times;
    defer List_free(&times);
    List<float> tv;
    defer List_free(&tv);
    List<float> rv;
    defer List_free(&rv);
    List<float> sv;
    defer List_free(&sv);
    bool ht = false;
    bool hr = false;
    bool hs = false;
    int f = 0;
    int w = 0;
    List<_Pb> frames;
    defer List_free(&frames);
    while (_pb_next(&b, &f, &w)) {
        if (f == 1) _pb_string(&b, w, &name);
        else if (f == 2 && w == 2) List_push(&frames, _pb_bytes(&b));
        else if (f == 3) duration = _pb_float(&b, w);
        else _pb_skip(&b, w);
    }
    for (k in 0..frames.size) {
        _Pb fr = frames.data[k];
        float time = 0.0;
        List<float> t;
        List<float> r;
        List<float> s;
        while (_pb_next(&fr, &f, &w)) {
            if (f == 1) time = _pb_float(&fr, w);
            else if (f == 2) _pb_floats(&fr, w, &t);
            else if (f == 3) _pb_floats(&fr, w, &r);
            else if (f == 4) _pb_floats(&fr, w, &s);
            else _pb_skip(&fr, w);
        }
        List_push(&times, time * duration / 1000.0);
        if (t.size >= 3) ht = true;
        if (r.size >= 4) hr = true;
        if (s.size >= 3) hs = true;
        for (c in 0..3) List_push(&tv, c < t.size ? t.data[c] : 0.0);
        Quat q = r.size >= 4 ? Quat{r.data[0], r.data[1], r.data[2], r.data[3]} : quat_identity();
        if (k > 0) {
            int at = (k - 1) * 4;
            if (q.x * rv.data[at] + q.y * rv.data[at + 1] + q.z * rv.data[at + 2] + q.w * rv.data[at + 3] < 0.0) {
                q = Quat{-q.x, -q.y, -q.z, -q.w};
            }
        }
        List_push(&rv, q.x);
        List_push(&rv, q.y);
        List_push(&rv, q.z);
        List_push(&rv, q.w);
        for (c in 0..3) List_push(&sv, c < s.size ? s.data[c] : 1.0);
        List_free(&t);
        List_free(&r);
        List_free(&s);
    }
    if (frames.size == 0 || !(ht || hr || hs)) return;
    _vrx_anim_name(&name, "fbx_kf_animation_", index);
    int a = _vrx_animation(v, &name);
    if (ht) _vrx_channel(v, a, node, GLTF_TRANSLATION, times.data, tv.data, frames.size, 3);
    if (hr) _vrx_channel(v, a, node, GLTF_ROTATION, times.data, rv.data, frames.size, 4);
    if (hs) _vrx_channel(v, a, node, GLTF_SCALE, times.data, sv.data, frames.size, 3);
}

// The bones' local transforms from their model-space ones.
void _vrx_locals(*_Vrx v, *Mat4 model, *Mat4 local) {
    for (j in 0..v.bones.size) {
        int p = v.bones.data[j].parent;
        local[j] = p >= 0 && p < v.bones.size ? model[p].inverse() * model[j] : model[j];
    }
}

// Applies a skeletal animation frame to model (the bones' model-space transforms): a
// legacy frame (no local transforms) holds T with Viro's skin matrix inverse(bind) T bind,
// a newer one the bone's model-space transform.
void _vrx_frame(*_Vrx v, _Pb fr, *Mat4 bind, *Mat4 model, *float time) {
    List<int> idx;
    defer List_free(&idx);
    List<Mat4> mats;
    defer List_free(&mats);
    bool local = false;
    int f = 0;
    int w = 0;
    *time = 0.0;
    while (_pb_next(&fr, &f, &w)) {
        if (f == 1) *time = _pb_float(&fr, w);
        else if (f == 2) _pb_ints(&fr, w, &idx);
        else if (f == 3 && w == 2) {
            Mat4 m = mat4_identity();
            _vrx_matrix(_pb_bytes(&fr), &m);
            List_push(&mats, m);
        } else if (f == 4) {
            local = true;
            _pb_skip(&fr, w);
        } else _pb_skip(&fr, w);
    }
    for (i in 0..idx.size) {
        int j = idx.data[i];
        if (j < 0 || j >= v.bones.size || i >= mats.size) continue;
        model[j] = local ? mats.data[i] : bind[j].inverse() * mats.data[i];
    }
}

// A skeletal animation over the joints joint0.. (one per bone).
void _vrx_skeletal(*_Vrx v, _Pb b, int joint0, *Mat4 bind, *Mat4 rest, int index) {
    String name;
    defer String_free(&name);
    float duration = 0.0;
    List<_Pb> frames;
    defer List_free(&frames);
    int f = 0;
    int w = 0;
    while (_pb_next(&b, &f, &w)) {
        if (f == 1) _pb_string(&b, w, &name);
        else if (f == 2 && w == 2) List_push(&frames, _pb_bytes(&b));
        else if (f == 3) duration = _pb_float(&b, w);
        else _pb_skip(&b, w);
    }
    int nb = v.bones.size;
    int nf = frames.size;
    // keys for every bone at every frame: a file asking for more than 64M is not a model
    if (nf == 0 || nb == 0 || (int64)nb * (int64)nf > 67108864) return;
    *Mat4 model = alloc<Mat4>((int64)nb);
    *Mat4 local = alloc<Mat4>((int64)nb);
    *bool moved = alloc<bool>((int64)nb);
    *float times = alloc<float>((int64)nf);
    *float tv = alloc<float>((int64)nb * (int64)nf * 3);
    *float rv = alloc<float>((int64)nb * (int64)nf * 4);
    *float sv = alloc<float>((int64)nb * (int64)nf * 3);
    for (j in 0..nb) model[j] = rest[j];
    for (k in 0..nf) {
        float t = 0.0;
        _vrx_frame(v, frames.data[k], bind, model, &t);
        times[k] = t * duration / 1000.0;
        _vrx_locals(v, model, local);
        for (j in 0..nb) {
            Vec3 tr = Vec3{0.0, 0.0, 0.0};
            Quat q = quat_identity();
            Vec3 sc = Vec3{1.0, 1.0, 1.0};
            _vrx_decompose(local[j], &tr, &q, &sc);
            int64 at = (int64)j * (int64)nf + (int64)k;
            if (k > 0) {
                *float pq = rv + (at - 1) * 4;
                if (q.x * pq[0] + q.y * pq[1] + q.z * pq[2] + q.w * pq[3] < 0.0) q = Quat{-q.x, -q.y, -q.z, -q.w};
                *float pt = tv + (at - 1) * 3;
                *float ps = sv + (at - 1) * 3;
                if (fabsf(pt[0] - tr.x) + fabsf(pt[1] - tr.y) + fabsf(pt[2] - tr.z) > 1e-6
                    || fabsf(pq[0] - q.x) + fabsf(pq[1] - q.y) + fabsf(pq[2] - q.z) + fabsf(pq[3] - q.w) > 1e-6
                    || fabsf(ps[0] - sc.x) + fabsf(ps[1] - sc.y) + fabsf(ps[2] - sc.z) > 1e-6) {
                    moved[j] = true;
                }
            }
            tv[at * 3] = tr.x;
            tv[at * 3 + 1] = tr.y;
            tv[at * 3 + 2] = tr.z;
            rv[at * 4] = q.x;
            rv[at * 4 + 1] = q.y;
            rv[at * 4 + 2] = q.z;
            rv[at * 4 + 3] = q.w;
            sv[at * 3] = sc.x;
            sv[at * 3 + 1] = sc.y;
            sv[at * 3 + 2] = sc.z;
        }
    }
    _vrx_anim_name(&name, "fbx_skel_animation_", index);
    int a = _vrx_animation(v, &name);
    for (j in 0..nb) {
        // a bone that holds still keeps one key, so the animation still poses it
        int n = moved[j] ? nf : 1;
        int64 at = (int64)j * (int64)nf;
        _vrx_channel(v, a, joint0 + j, GLTF_TRANSLATION, times, tv + at * 3, n, 3);
        _vrx_channel(v, a, joint0 + j, GLTF_ROTATION, times, rv + at * 4, n, 4);
        _vrx_channel(v, a, joint0 + j, GLTF_SCALE, times, sv + at * 3, n, 3);
    }
    free(model);
    free(local);
    free(moved);
    free(times);
    free(tv);
    free(rv);
    free(sv);
}

bool _vrx_same_bytes(_Pb a, _Pb b) {
    int64 n = a.end - a.p;
    return n == b.end - b.p && (n == 0 || memcmp(a.p, b.p, n) == 0);
}

// A rig of node's parent and transform with these bind matrices and animations, -1 when
// there is none.
int _vrx_find_rig(*_Vrx v, int node, *Mat4 bind, *List<_Pb> anims, *List<_Pb> keys) {
    *GltfNode n = &v.g.nodes.data[node];
    for (i in 0..v.rigs.size) {
        *_VrxRig r = &v.rigs.data[i];
        if (r.parent != n.parent || r.anims.size != anims.size || r.keys.size != keys.size) continue;
        Vec3 dt = r.t - n.translation;
        Vec3 ds = r.s - n.scale;
        float dr = fabsf(r.r.x - n.rotation.x) + fabsf(r.r.y - n.rotation.y) + fabsf(r.r.z - n.rotation.z) + fabsf(r.r.w - n.rotation.w);
        if (dt.length() > 1e-6 || ds.length() > 1e-6 || dr > 1e-6) continue;
        bool same = true;
        for (j in 0..v.bones.size) {
            for (k in 0..16) {
                if (fabsf(r.bind[j].m[k] - bind[j].m[k]) > 1e-5) same = false;
            }
        }
        for (a in 0..anims.size) {
            if (!_vrx_same_bytes(r.anims.data[a], anims.data[a])) same = false;
        }
        for (a in 0..keys.size) {
            if (!_vrx_same_bytes(r.keys.data[a], keys.data[a])) same = false;
        }
        if (same) return i;
    }
    return -1;
}

void _vrx_add_skin(*_Vrx v, int node, int joint0, *Mat4 bind) {
    int nb = v.bones.size;
    GltfSkin sk;
    sk.skeleton = -1;
    sk.inverse_bind = alloc<float>((int64)nb * 16 + 1);
    for (j in 0..nb) {
        List_push(&sk.joints, joint0 + j);
        for (k in 0..16) sk.inverse_bind[j * 16 + k] = bind[j].m[k];
    }
    List_push(&v.g.skins, sk);
    v.g.nodes.data[node].skin = v.g.skins.size - 1;
}

// Skins the mesh of node with the skeleton: joint nodes under node, the inverse bind
// matrices, the rest pose, and the skeletal animations. A sibling with the same transform,
// bind matrices, skeletal and keyframe animations (keys) shares the joints.
void _vrx_skin(*_Vrx v, _Pb skin, int node, *List<_Pb> anims, *List<_Pb> keys) {
    int nb = v.bones.size;
    Mat4 geo_bind = mat4_identity();
    *Mat4 bind = alloc<Mat4>((int64)nb + 1);
    for (j in 0..nb) bind[j] = mat4_identity();
    int bi = 0;
    int f = 0;
    int w = 0;
    _Pb s = skin;
    List<Mat4> bone_space;
    defer List_free(&bone_space);
    while (_pb_next(&s, &f, &w)) {
        if (f == 1 && w == 2) _vrx_matrix(_pb_bytes(&s), &geo_bind);
        else if (f == 2 && w == 2) {
            Mat4 m = mat4_identity();
            _vrx_matrix(_pb_bytes(&s), &m);
            List_push(&bone_space, m);
        } else _pb_skip(&s, w);
    }
    for (j in 0..nb) {
        Mat4 bs = j < bone_space.size ? bone_space.data[j] : mat4_identity();
        bind[j] = bs * geo_bind;
    }
    int shared = _vrx_find_rig(v, node, bind, anims, keys);
    if (shared >= 0) {
        _vrx_add_skin(v, node, v.rigs.data[shared].joint0, bind);
        free(bind);
        return;
    }
    // the rest pose: undeformed, then the first frame of the first animation
    *Mat4 model = alloc<Mat4>((int64)nb + 1);
    *Mat4 local = alloc<Mat4>((int64)nb + 1);
    for (j in 0..nb) model[j] = bind[j].inverse();
    if (anims.size > 0) {
        _Pb a = anims.data[0];
        while (_pb_next(&a, &f, &w)) {
            if (f == 2 && w == 2) {
                float t = 0.0;
                _vrx_frame(v, _pb_bytes(&a), bind, model, &t);
                break;
            }
            _pb_skip(&a, w);
        }
    }
    _vrx_locals(v, model, local);
    int joint0 = v.g.nodes.size;
    for (j in 0..nb) {
        GltfNode n;
        String_append(&n.name, v.bones.data[j].name.data != null ? v.bones.data[j].name.data : "");
        n.mesh = -1;
        n.skin = -1;
        _vrx_decompose(local[j], &n.translation, &n.rotation, &n.scale);
        int p = v.bones.data[j].parent;
        n.parent = p >= 0 && p < nb ? joint0 + p : node;
        List_push(&v.g.nodes, n);
    }
    for (j in 0..nb) List_push(&v.g.nodes.data[v.g.nodes.data[joint0 + j].parent].children, joint0 + j);
    _vrx_add_skin(v, node, joint0, bind);
    for (i in 0..anims.size) _vrx_skeletal(v, anims.data[i], joint0, bind, model, i);
    free(model);
    free(local);
    // the joints live under node, so a sibling reusing them needs node's transform
    *GltfNode n = &v.g.nodes.data[node];
    _VrxRig r = _VrxRig{parent: n.parent, t: n.translation, r: n.rotation, s: n.scale, joint0: joint0, bind: bind};
    for (i in 0..anims.size) List_push(&r.anims, anims.data[i]);
    for (i in 0..keys.size) List_push(&r.keys, keys.data[i]);
    List_push(&v.rigs, r);
}

// The rotation of Euler angles in degrees, as ViroReact applies them (X, then Y, then Z).
Quat _vrx_euler(float x, float y, float z) {
    float k = 3.14159265358979 / 180.0;
    Quat qx = quat_axis_angle(Vec3{1.0, 0.0, 0.0}, x * k);
    Quat qy = quat_axis_angle(Vec3{0.0, 1.0, 0.0}, y * k);
    Quat qz = quat_axis_angle(Vec3{0.0, 0.0, 1.0}, z * k);
    return qz * qy * qx;
}

// A viro.Node under parent (-1 for a root); returns its node index.
int _vrx_node(*_Vrx v, _Pb b, int parent) {
    GltfNode n;
    n.mesh = -1;
    n.skin = -1;
    n.parent = parent;
    n.translation = Vec3{0.0, 0.0, 0.0};
    n.scale = Vec3{1.0, 1.0, 1.0};
    n.rotation = quat_identity();
    List<float> pos;
    defer List_free(&pos);
    List<float> rot;
    defer List_free(&rot);
    List<float> scale;
    defer List_free(&scale);
    _Pb geo = _Pb{null, null};
    List<_Pb> skel;
    defer List_free(&skel);
    List<_Pb> keys;
    defer List_free(&keys);
    List<_Pb> subs;
    defer List_free(&subs);
    int f = 0;
    int w = 0;
    while (_pb_next(&b, &f, &w)) {
        if (f == 1) _pb_string(&b, w, &n.name);
        else if (f == 2) _pb_floats(&b, w, &pos);
        else if (f == 3) _pb_floats(&b, w, &scale);
        else if (f == 4) _pb_floats(&b, w, &rot);
        else if (f == 7 && w == 2) geo = _pb_bytes(&b);
        else if (f == 9 && w == 2) List_push(&skel, _pb_bytes(&b));
        else if (f == 10 && w == 2) List_push(&keys, _pb_bytes(&b));
        else if (f == 13 && w == 2) List_push(&subs, _pb_bytes(&b));
        else _pb_skip(&b, w);
    }
    if (pos.size >= 3) n.translation = Vec3{pos.data[0], pos.data[1], pos.data[2]};
    if (scale.size >= 3) n.scale = Vec3{scale.data[0], scale.data[1], scale.data[2]};
    if (rot.size >= 3) n.rotation = _vrx_euler(rot.data[0], rot.data[1], rot.data[2]);
    List_push(&v.g.nodes, n);
    int id = v.g.nodes.size - 1;
    if (parent >= 0) List_push(&v.g.nodes.data[parent].children, id);
    else List_push(&v.g.roots, id);
    if (geo.p != null) {
        _Pb skin = _Pb{null, null};
        _Pb g = geo;
        while (_pb_next(&g, &f, &w)) {
            if (f == 6 && w == 2) skin = _pb_bytes(&g);
            else _pb_skip(&g, w);
        }
        bool skinned = skin.p != null && v.bones.size > 0;
        int mesh = _vrx_geometry(v, geo, skinned ? &skin : null);
        v.g.nodes.data[id].mesh = mesh;
        if (mesh >= 0 && skinned) _vrx_skin(v, skin, id, &skel, &keys);
    }
    for (i in 0..keys.size) _vrx_keyframes(v, keys.data[i], id, i);
    for (i in 0..subs.size) _vrx_node(v, subs.data[i], id);
    return id;
}

void _vrx_skeleton(*_Vrx v, _Pb b) {
    int f = 0;
    int w = 0;
    while (_pb_next(&b, &f, &w)) {
        if (f != 1 || w != 2) {
            _pb_skip(&b, w);
            continue;
        }
        _Pb bone = _pb_bytes(&b);
        _VrxBone vb = _VrxBone{parent: -1};
        while (_pb_next(&bone, &f, &w)) {
            if (f == 1) _pb_string(&bone, w, &vb.name);
            else if (f == 2) vb.parent = (int)_pb_int(&bone, w);
            else _pb_skip(&bone, w);
        }
        List_push(&v.bones, vb);
    }
    // a parent out of range, the bone itself or a cycle makes a root (files have bones
    // that name themselves as their parent; Viro's legacy frames never walk up to them)
    int nb = v.bones.size;
    *bool cut = alloc<bool>((int64)nb + 1);
    for (j in 0..nb) {
        int p = v.bones.data[j].parent;
        if (p >= nb) cut[j] = true;
        for (steps in 0..nb) {
            if (p < 0 || p >= nb) break;
            if (p == j) {
                cut[j] = true;
                break;
            }
            p = v.bones.data[p].parent;
        }
    }
    for (j in 0..nb) {
        if (cut[j]) v.bones.data[j].parent = -1;
    }
    free(cut);
}

void _vrx_cleanup(*_Vrx v) {
    String_free(&v.dir);
    for (i in 0..v.rigs.size) {
        free(v.rigs.data[i].bind);
        List_free(&v.rigs.data[i].anims);
        List_free(&v.rigs.data[i].keys);
    }
    List_free(&v.rigs);
    for (i in 0..v.bones.size) String_free(&v.bones.data[i].name);
    List_free(&v.bones);
    for (i in 0..v.image_paths.size) String_free(&v.image_paths.data[i]);
    List_free(&v.image_paths);
    for (i in 0..v.joined.size) {
        String_free(&v.joined.data[i].rough);
        String_free(&v.joined.data[i].metal);
    }
    List_free(&v.joined);
}

// Inflates a zlib stream of unknown size.
Result<*uint8, string> _vrx_inflate(*uint8 data, uint64 len, *uint64 out_len) {
    uint64 cap = len * 8 + 4096;
    while (true) {
        *uint8 out = alloc<uint8>((int64)cap);
        Result<uint64, string> r = inflate_zlib(data, len, out, cap);
        if (r.ok) {
            *out_len = r.value;
            return Ok<*uint8, string>(out);
        }
        free(out);
        if (strcmp(r.error, "inflate: too much data") != 0 || cap > (uint64)1 << 32) {
            return Err<*uint8, string>(_vrx_fail("", r.error));
        }
        cap = cap * 4;
    }
    return Err<*uint8, string>(_vrx_fail("inflate failed", null));
}

// Builds the Gltf from the inflated protobuf.
Result<Gltf, string> _vrx_parse_pb(*uint8 raw, uint64 n, string base_dir) {
    _Vrx v;
    if (base_dir != null) String_append(&v.dir, base_dir);
    _Pb root = _Pb{raw, raw + (int64)n};
    // the skeleton first: the root nodes' skins refer to it
    _Pb b = root;
    int f = 0;
    int w = 0;
    while (_pb_next(&b, &f, &w)) {
        if (f == 8 && w == 2) _vrx_skeleton(&v, _pb_bytes(&b));
        else _pb_skip(&b, w);
    }
    b = root;
    while (_pb_next(&b, &f, &w)) {
        if (f == 13 && w == 2) _vrx_node(&v, _pb_bytes(&b), -1);
        else _pb_skip(&b, w);
    }
    _vrx_cleanup(&v);
    if (v.g.meshes.size == 0) {
        Gltf_free(&v.g);
        return Err<Gltf, string>(_vrx_fail("the file has no geometry", null));
    }
    return Ok<Gltf, string>(v.g);
}

// Parses a .vrx file held in memory. Its textures are read relative to base_dir (null for
// the current directory).
Result<Gltf, string> vrx_parse(*uint8 data, uint64 len, string base_dir) {
    if (len < 2 || (data[0] & 0x0F) != 8) return Err<Gltf, string>(_vrx_fail("not a zlib-compressed .vrx file", null));
    uint64 n = 0;
    *uint8 raw = _vrx_inflate(data, len, &n)?;
    defer free(raw);
    return _vrx_parse_pb(raw, n, base_dir);
}

// Reads a .vrx file and parses it with vrx_parse, reading its textures relative to the
// file's directory. Errors start with "vrx: ". The caller frees the result with free().
Result<Gltf, string> vrx_load(string path) {
    int64 n = 0;
    *uint8 data = fs_read_all(path, &n);
    if (data == null) return Err<Gltf, string>(_vrx_fail("cannot read ", path));
    defer free(data);
    String dir;
    defer String_free(&dir);
    path_dirname(&dir, path);
    return vrx_parse(data, (uint64)n, dir.data);
}
