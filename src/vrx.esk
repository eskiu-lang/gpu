// vrx.esk: ViroReact's .vrx models, the FBX files that Viro's ViroFBX tool converts.
//
// vrx_load returns the same Gltf that gltf_load does, so <gpu/model> and <scene> draw and
// animate a .vrx file as they do a glTF one:
//
//     Gltf data = vrx_load("pug.vrx")?;
//     defer data.free();
//
// A .vrx file is a zlib-compressed protobuf (`viro.Node`): an outer node holding the
// skeleton and the model's root nodes. Each node has a position, a rotation in degrees
// (applied as ViroReact applies Euler angles: X, then Y, then Z) and a scale. Its geometry
// is one interleaved vertex buffer described by sources (position, normal, texture
// coordinate, tangent, color) and one element (index list) per material; each element
// becomes a primitive of the node's mesh, and element i takes material i modulo the number
// of materials, as Viro does.
//
// Materials follow Viro's lighting models: Constant is unlit, Lambert is fully rough,
// Blinn and Phong map the shininess to a roughness, and PhysicallyBased reads its roughness
// and metalness (separate textures in the file, joined into glTF's metallic-roughness
// texture: roughness in green, metalness in blue). The diffuse color and texture are the
// base color, transparency below 1 blends, the normal and ambient occlusion maps carry over,
// and the specular, reflective and emission maps are dropped, as Viro's loader drops them.
// Textures (PNG, JPEG, or KTX as Viro's Android projects ship them) are read relative to
// the file's directory; a missing one leaves the material untextured.
//
// A skinned geometry gets the skeleton as joint nodes under its own node, with the inverse
// bind matrices Viro computes (each bone's bind transform times the geometry's), so the
// joint matrices equal Viro's bone transforms. Skeletal animations become translation,
// rotation and scale channels on the joints, and keyframe animations channels on their
// node; animations of the same name on several nodes are one animation, as ViroReact plays
// a model's animation by name over its whole hierarchy. The rest pose is the first frame of
// the first skeletal animation, as in Viro.

import <io>;
import <mem>;
import <string>;
import <list>;
import <result>;
import <fs>;
import <path>;
import <libc>;
import <math>;
import <gpu/math>;
import <gpu/gltf>;
import <gpu/inflate>;
import <gpu/image>;
import <gpu/ktx2>;

// A protobuf reader over [p, end).
struct _Pb {
    *uint8 p;
    *uint8 end;
}

uint64 _pb_varint(*_Pb b) {
    uint64 r = 0;
    int s = 0;
    while (b.p < b.end) {
        uint8 c = b.p[0];
        b.p = b.p + 1;
        if (s < 64) r = r | ((uint64)(c & 0x7F) << (uint64)s);
        s += 7;
        if (c < 0x80) return r;
    }
    return r;
}

// The next field's number and wire type; false at the end.
bool _pb_next(*_Pb b, *int field, *int wire) {
    if (b.p >= b.end) return false;
    uint64 t = _pb_varint(b);
    *field = (int)(t >> 3);
    *wire = (int)(t & 7);
    return true;
}

// The bytes of a length-delimited field.
_Pb _pb_bytes(*_Pb b) {
    uint64 n = _pb_varint(b);
    uint64 left = (uint64)(b.end - b.p);
    if (n > left) n = left;
    _Pb s = _Pb{b.p, b.p + (int64)n};
    b.p = b.p + (int64)n;
    return s;
}

void _pb_ahead(*_Pb b, int64 n) {
    if (b.end - b.p < n) b.p = b.end;
    else b.p = b.p + n;
}

void _pb_skip(*_Pb b, int wire) {
    if (wire == 0) _pb_varint(b);
    else if (wire == 1) _pb_ahead(b, 8);
    else if (wire == 2) _pb_bytes(b);
    else if (wire == 5) _pb_ahead(b, 4);
    else b.p = b.end;
}

float _pb_f32(*_Pb b) {
    if (b.end - b.p < 4) {
        b.p = b.end;
        return 0.0;
    }
    float f = 0.0;
    memcpy(&f, b.p, 4);
    b.p = b.p + 4;
    return f;
}

// A float field: one value (fixed32) or a packed run of them.
void _pb_floats(*_Pb b, int wire, *List<float> out) {
    if (wire == 5) {
        List_push(out, _pb_f32(b));
    } else if (wire == 2) {
        _Pb s = _pb_bytes(b);
        while (s.end - s.p >= 4) List_push(out, _pb_f32(&s));
    } else {
        _pb_skip(b, wire);
    }
}

float _pb_float(*_Pb b, int wire) {
    if (wire == 5) return _pb_f32(b);
    if (wire == 0) return (float)(int64)_pb_varint(b);
    _pb_skip(b, wire);
    return 0.0;
}

int64 _pb_int(*_Pb b, int wire) {
    if (wire == 0) return (int64)_pb_varint(b);
    _pb_skip(b, wire);
    return 0;
}

// An integer field: one varint or a packed run of them.
void _pb_ints(*_Pb b, int wire, *List<int> out) {
    if (wire == 0) {
        List_push(out, (int)_pb_varint(b));
    } else if (wire == 2) {
        _Pb s = _pb_bytes(b);
        while (s.p < s.end) List_push(out, (int)_pb_varint(&s));
    } else {
        _pb_skip(b, wire);
    }
}

void _pb_string(*_Pb b, int wire, *String out) {
    if (wire != 2) {
        _pb_skip(b, wire);
        return;
    }
    _Pb s = _pb_bytes(b);
    String_clear(out);
    for (*uint8 q = s.p; q < s.end; q = q + 1) String_push(out, (char)q[0]);
}

// A viro.Node.Matrix (16 floats, column-major); false when it does not hold 16.
bool _vrx_matrix(_Pb m, *Mat4 out) {
    List<float> v;
    defer List_free(&v);
    int f = 0;
    int w = 0;
    while (_pb_next(&m, &f, &w)) {
        if (f == 1) _pb_floats(&m, w, &v);
        else _pb_skip(&m, w);
    }
    if (v.size != 16) return false;
    for (i in 0..16) out.m[i] = v.data[i];
    return true;
}

// A bone of the skeleton: its parent's index (-1 for a root) and its name.
struct _VrxBone {
    int parent;
    String name;
}

// A geometry source: what it holds, where in which buffer.
struct _VrxSource {
    int semantic;
    int count;
    bool floats;
    int comps;
    int bpc;
    int offset;
    int stride;
    bool own;
    _Pb data;
}

// A material visual (diffuse, normal, roughness, ...).
struct _VrxVisual {
    bool has;
    List<float> color;
    String texture;
    float intensity;
    int wrap_s;
    int wrap_t;
    int min;
    int mag;
    int mip;
}

// A joined metallic-roughness texture, by the names it was made of.
struct _VrxJoined {
    String rough;
    String metal;
    int texture;
}

// A skeleton made for a skinned node, which a sibling with the same transform, bind
// matrices and skeletal animations reuses.
struct _VrxRig {
    int parent;
    Vec3 t;
    Quat r;
    Vec3 s;
    int joint0;
    *Mat4 bind;
    List<_Pb> anims;
    List<_Pb> keys;
}

struct _Vrx {
    Gltf g;
    List<_VrxRig> rigs;
    String dir;
    List<_VrxBone> bones;
    List<String> image_paths;
    List<_VrxJoined> joined;
}

const int _VRX_VERTEX = 0;
const int _VRX_NORMAL = 1;
const int _VRX_COLOR = 2;
const int _VRX_TEXCOORD = 3;
const int _VRX_TANGENT = 4;

string _vrx_fail(string what, string detail) {
    String s;
    String_append(&s, "vrx: ");
    String_append(&s, what);
    if (detail != null) String_append(&s, detail);
    return s.data;
}

_VrxSource _vrx_source(_Pb b) {
    _VrxSource s = _VrxSource{floats: false, own: false};
    int f = 0;
    int w = 0;
    while (_pb_next(&b, &f, &w)) {
        if (f == 1) s.semantic = (int)_pb_int(&b, w);
        else if (f == 2) s.count = (int)_pb_int(&b, w);
        else if (f == 3) s.floats = _pb_int(&b, w) != 0;
        else if (f == 4) s.comps = (int)_pb_int(&b, w);
        else if (f == 5) s.bpc = (int)_pb_int(&b, w);
        else if (f == 6) s.offset = (int)_pb_int(&b, w);
        else if (f == 7) s.stride = (int)_pb_int(&b, w);
        else if (f == 8 && w == 2) {
            s.data = _pb_bytes(&b);
            s.own = true;
        } else _pb_skip(&b, w);
    }
    if (s.stride == 0) s.stride = s.comps * s.bpc;
    return s;
}

// Component c of vertex i of a source (0 past its data or its components).
float _vrx_comp(*_VrxSource s, _Pb buf, int i, int c) {
    if (c >= s.comps) return 0.0;
    _Pb d = s.own ? s.data : buf;
    int64 at = (int64)i * (int64)s.stride + (int64)s.offset + (int64)c * (int64)s.bpc;
    if (at < 0 || at + (int64)s.bpc > d.end - d.p) return 0.0;
    *uint8 p = d.p + at;
    if (s.floats && s.bpc == 4) {
        float f = 0.0;
        memcpy(&f, p, 4);
        return f;
    }
    if (s.bpc == 1) return (float)p[0];
    if (s.bpc == 2) return (float)((uint32)p[0] | (uint32)p[1] << 8);
    if (s.bpc == 4) return (float)((uint32)p[0] | (uint32)p[1] << 8 | (uint32)p[2] << 16 | (uint32)p[3] << 24);
    return 0.0;
}

_VrxVisual _vrx_visual(_Pb b) {
    _VrxVisual v = _VrxVisual{has: true, intensity: 1.0};
    int f = 0;
    int w = 0;
    while (_pb_next(&b, &f, &w)) {
        if (f == 1) _pb_floats(&b, w, &v.color);
        else if (f == 2) _pb_string(&b, w, &v.texture);
        else if (f == 3) v.intensity = _pb_float(&b, w);
        else if (f == 5) v.wrap_s = (int)_pb_int(&b, w);
        else if (f == 6) v.wrap_t = (int)_pb_int(&b, w);
        else if (f == 7) v.min = (int)_pb_int(&b, w);
        else if (f == 8) v.mag = (int)_pb_int(&b, w);
        else if (f == 9) v.mip = (int)_pb_int(&b, w);
        else _pb_skip(&b, w);
    }
    return v;
}

void _vrx_visual_free(*_VrxVisual v) {
    List_free(&v.color);
    String_free(&v.texture);
}

bool _vrx_textured(*_VrxVisual v) {
    return v.has && v.texture.len > 0;
}

// The image file name (relative to the model's directory) as an image index, -1 when it
// cannot be read.
int _vrx_image(*_Vrx v, string name) {
    String full;
    defer String_free(&full);
    if (v.dir.data != null && v.dir.len > 0 && path_is_absolute(name) == 0) path_join(&full, v.dir.data, name);
    else String_append(&full, name);
    for (i in 0..v.image_paths.size) {
        if (strcmp(v.image_paths.data[i].data, full.data) == 0) return i;
    }
    int64 n = 0;
    *uint8 data = fs_read_all(full.data, &n);
    if (data == null) return -1;
    GltfImage img;
    String_append(&img.name, name);
    String ext;
    defer String_free(&ext);
    path_extension(&ext, name);
    bool jpeg = ext.data != null && (strcasecmp(ext.data, ".jpg") == 0 || strcasecmp(ext.data, ".jpeg") == 0);
    String_append(&img.mime, ktx_is_ktx(data, (uint64)n) ? "image/ktx" : jpeg ? "image/jpeg" : "image/png");
    img.data = data;
    img.len = (uint64)n;
    img.owned = true;
    List_push(&v.g.images, img);
    String copy;
    String_append(&copy, full.data);
    List_push(&v.image_paths, copy);
    return v.g.images.size - 1;
}

int _vrx_wrap(int w) {
    if (w == 1) return 10497;
    if (w == 3) return 33648;
    return 33071;
}

// A sampler of the visual's wrap and filter modes (shared with an equal one).
int _vrx_sampler(*_Vrx v, *_VrxVisual vis) {
    int mag = vis.mag == 1 ? 9728 : 9729;
    int min = vis.min == 1 ? 9728 : 9729;
    if (vis.mip == 1) min = vis.min == 1 ? 9984 : 9985;
    else if (vis.mip == 2) min = vis.min == 1 ? 9986 : 9987;
    GltfSampler s = GltfSampler{mag, min, _vrx_wrap(vis.wrap_s), _vrx_wrap(vis.wrap_t)};
    for (i in 0..v.g.samplers.size) {
        *GltfSampler o = &v.g.samplers.data[i];
        if (o.mag_filter == s.mag_filter && o.min_filter == s.min_filter && o.wrap_s == s.wrap_s && o.wrap_t == s.wrap_t) return i;
    }
    List_push(&v.g.samplers, s);
    return v.g.samplers.size - 1;
}

int _vrx_texture_of(*_Vrx v, int image, *_VrxVisual vis) {
    if (image < 0) return -1;
    List_push(&v.g.textures, GltfTexture{image, _vrx_sampler(v, vis)});
    return v.g.textures.size - 1;
}

// The texture of a visual, -1 when it has none or its file cannot be read.
int _vrx_texture(*_Vrx v, *_VrxVisual vis) {
    if (!_vrx_textured(vis)) return -1;
    return _vrx_texture_of(v, _vrx_image(v, vis.texture.data), vis);
}

uint32[256] _vrx_crc_table;
bool _vrx_crc_ready = false;

uint32 _vrx_crc(*uint8 p, uint64 n, uint32 crc) {
    if (!_vrx_crc_ready) {
        for (i in 0..256) {
            uint32 c = (uint32)i;
            for (k in 0..8) c = (c & 1) != 0 ? (uint32)0xEDB88320 ^ (c >> 1) : c >> 1;
            _vrx_crc_table[i] = c;
        }
        _vrx_crc_ready = true;
    }
    uint32 c = crc ^ (uint32)0xFFFFFFFF;
    for (i in 0..n) c = _vrx_crc_table[(int)((c ^ (uint32)p[i]) & 255)] ^ (c >> 8);
    return c ^ (uint32)0xFFFFFFFF;
}

void _vrx_be32(*uint8 p, uint32 v) {
    p[0] = (uint8)(v >> 24);
    p[1] = (uint8)(v >> 16);
    p[2] = (uint8)(v >> 8);
    p[3] = (uint8)v;
}

// An RGBA image as a PNG with stored (uncompressed) deflate blocks, so a joined texture
// goes through the same decoder as the file's own images.
*uint8 _vrx_png(*uint8 rgba, uint32 width, uint32 height, *uint64 out_len) {
    uint64 row = (uint64)width * 4 + 1;
    uint64 raw_len = row * (uint64)height;
    uint64 blocks = (raw_len + 65534) / 65535;
    if (blocks == 0) blocks = 1;
    uint64 z_len = 2 + raw_len + blocks * 5 + 4;
    uint64 total = 8 + 25 + 12 + z_len + 12;
    *uint8 out = alloc<uint8>((int64)total);
    uint8[8] sig = {0x89, 'P', 'N', 'G', 0x0D, 0x0A, 0x1A, 0x0A};
    memcpy(out, &sig[0], 8);
    *uint8 ihdr = out + 8;
    _vrx_be32(ihdr, 13);
    memcpy(ihdr + 4, (*uint8)"IHDR", 4);
    _vrx_be32(ihdr + 8, width);
    _vrx_be32(ihdr + 12, height);
    ihdr[16] = 8;
    ihdr[17] = 6;
    ihdr[18] = 0;
    ihdr[19] = 0;
    ihdr[20] = 0;
    _vrx_be32(ihdr + 21, _vrx_crc(ihdr + 4, 17, 0));
    *uint8 idat = ihdr + 25;
    _vrx_be32(idat, (uint32)z_len);
    memcpy(idat + 4, (*uint8)"IDAT", 4);
    *uint8 z = idat + 8;
    z[0] = 0x78;
    z[1] = 0x01;
    uint64 at = 2;
    uint32 a = 1;
    uint32 b = 0;
    uint64 done = 0;
    uint64 block_left = 0;
    for (y in 0..height) {
        for (x in 0..row) {
            if (block_left == 0) {
                uint64 n = raw_len - done;
                if (n > 65535) n = 65535;
                z[at] = done + n == raw_len ? 1 : 0;
                z[at + 1] = (uint8)n;
                z[at + 2] = (uint8)(n >> 8);
                z[at + 3] = (uint8)~n;
                z[at + 4] = (uint8)(~n >> 8);
                at += 5;
                block_left = n;
            }
            uint8 byte = x == 0 ? 0 : rgba[(uint64)y * (uint64)width * 4 + x - 1];
            z[at] = byte;
            at++;
            done++;
            block_left--;
            a = (a + (uint32)byte) % 65521;
            b = (b + a) % 65521;
        }
    }
    _vrx_be32(z + at, (b << 16) | a);
    _vrx_be32(idat + 8 + z_len, _vrx_crc(idat + 4, z_len + 4, 0));
    *uint8 iend = idat + 12 + z_len;
    _vrx_be32(iend, 0);
    memcpy(iend + 4, (*uint8)"IEND", 4);
    _vrx_be32(iend + 8, _vrx_crc(iend + 4, 4, 0));
    *out_len = total;
    return out;
}

// The red channel of image (0 when it is null) at (x, y) of a w x h grid.
uint8 _vrx_red(*Bitmap img, uint32 x, uint32 y, uint32 w, uint32 h) {
    if (img == null || img.rgba == null) return 255;
    uint32 sx = (uint32)((uint64)x * (uint64)img.width / (uint64)w);
    uint32 sy = (uint32)((uint64)y * (uint64)img.height / (uint64)h);
    return img.rgba[((uint64)sy * (uint64)img.width + (uint64)sx) * 4];
}

bool _vrx_decode(*_Vrx v, int image, *Bitmap out) {
    if (image < 0) return false;
    *GltfImage gi = &v.g.images.data[image];
    Result<Bitmap, string> r = image_decode(gi.data, gi.len);
    if (!r.ok) return false;
    *out = r.value;
    return true;
}

// The metallic-roughness texture joined from the roughness and metalness visuals (green
// from the roughness map, blue from the metalness map, each 255 without a map), -1 when
// neither has a readable map.
int _vrx_joined(*_Vrx v, *_VrxVisual rough, *_VrxVisual metal) {
    string rn = _vrx_textured(rough) ? rough.texture.data : "";
    string mn = _vrx_textured(metal) ? metal.texture.data : "";
    for (i in 0..v.joined.size) {
        *_VrxJoined j = &v.joined.data[i];
        if (strcmp(j.rough.data != null ? j.rough.data : "", rn) == 0 && strcmp(j.metal.data != null ? j.metal.data : "", mn) == 0) return j.texture;
    }
    Bitmap r;
    Bitmap m;
    bool hr = _vrx_textured(rough) && _vrx_decode(v, _vrx_image(v, rn), &r);
    bool hm = _vrx_textured(metal) && _vrx_decode(v, _vrx_image(v, mn), &m);
    int tex = -1;
    if (hr || hm) {
        uint32 w = hr ? r.width : m.width;
        uint32 h = hr ? r.height : m.height;
        if (hm && m.width > w) w = m.width;
        if (hm && m.height > h) h = m.height;
        *uint8 px = alloc<uint8>((int64)w * (int64)h * 4);
        for (y in 0..h) {
            for (x in 0..w) {
                uint64 at = ((uint64)y * (uint64)w + (uint64)x) * 4;
                px[at] = 255;
                px[at + 1] = _vrx_red(hr ? &r : null, x, y, w, h);
                px[at + 2] = _vrx_red(hm ? &m : null, x, y, w, h);
                px[at + 3] = 255;
            }
        }
        GltfImage img;
        String_append(&img.name, "metallic_roughness");
        String_append(&img.mime, "image/png");
        img.data = _vrx_png(px, w, h, &img.len);
        img.owned = true;
        free(px);
        List_push(&v.g.images, img);
        String key;
        String_append(&key, "\001joined");
        List_push(&v.image_paths, key);
        tex = _vrx_texture_of(v, v.g.images.size - 1, hr ? rough : metal);
    }
    if (hr) Bitmap_free(&r);
    if (hm) Bitmap_free(&m);
    _VrxJoined j;
    String_append(&j.rough, rn);
    String_append(&j.metal, mn);
    j.texture = tex;
    List_push(&v.joined, j);
    return tex;
}

// Whether the texture's image is a PNG with an alpha channel (gray-alpha, RGBA, or a tRNS
// chunk): Viro blends a material whose diffuse texture has alpha.
bool _vrx_has_alpha(*_Vrx v, int texture) {
    if (texture < 0) return false;
    *GltfImage img = &v.g.images.data[v.g.textures.data[texture].image];
    if (img.len < 33 || img.data[0] != 0x89 || img.data[1] != 'P') return false;
    int ct = (int)img.data[25];
    if (ct == 4 || ct == 6) return true;
    uint64 at = 8;
    while (at + 8 <= img.len) {
        uint64 n = (uint64)img.data[at] << 24 | (uint64)img.data[at + 1] << 16 | (uint64)img.data[at + 2] << 8 | (uint64)img.data[at + 3];
        *uint8 t = img.data + at + 4;
        if (t[0] == 't' && t[1] == 'R' && t[2] == 'N' && t[3] == 'S') return true;
        if (t[0] == 'I' && t[1] == 'D' && t[2] == 'A' && t[3] == 'T') return false;
        at = at + 12 + n;
    }
    return false;
}

import "vrx_material.esk";
import "vrx_scene.esk";
