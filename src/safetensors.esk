// safetensors.esk: the safetensors format (Hugging Face): read and write.
//
// A file is an 8-byte little-endian header size, a JSON header mapping each
// tensor name to its dtype, shape and byte range, then the raw data.
//
//     Safetensors st = safetensors_load("model.safetensors")?;
//     defer st.free();
//     SafeTensor* w = st.tensor("model.embed_tokens.weight");
//     *float v = alloc<float>((int64)w.count);
//     w.floats(v);
//
//     SafetensorsWriter out;
//     out.add("w1", w1_data, 784, 128);
//     out.save("mnist.safetensors")?;

import <io>;
import <mem>;
import <string>;
import <list>;
import <result>;
import <json>;
import <fs>;

struct SafeTensor {
    String name;
    String dtype;
    int ndims;
    uint64[8] shape;
    uint64 count;
    *uint8 data;
    uint64 size;
}

struct Safetensors {
    *uint8 file;
    uint64 len;
    List<SafeTensor> tensors;
}

struct _SafeEntry {
    String name;
    *float data;
    uint64 rows;
    uint64 cols;
}

// Tensors to save, kept by reference: the data must live until save().
struct SafetensorsWriter {
    List<_SafeEntry> entries;
}

String _st_err;

string _st_fail(string a, string b) {
    String_clear(&_st_err);
    String_append(&_st_err, "safetensors: ");
    String_append(&_st_err, a);
    if (b != null) String_append(&_st_err, b);
    return _st_err.data;
}

// Bytes per element of a dtype; 0 when unknown.
int safetensors_dtype_size(string d) {
    if (strcmp(d, "F64") == 0 || strcmp(d, "I64") == 0 || strcmp(d, "U64") == 0) return 8;
    if (strcmp(d, "F32") == 0 || strcmp(d, "I32") == 0 || strcmp(d, "U32") == 0) return 4;
    if (strcmp(d, "F16") == 0 || strcmp(d, "BF16") == 0 || strcmp(d, "I16") == 0 || strcmp(d, "U16") == 0) return 2;
    if (strcmp(d, "I8") == 0 || strcmp(d, "U8") == 0 || strcmp(d, "BOOL") == 0) return 1;
    return 0;
}

Result<Safetensors, string> safetensors_load(string path) {
    int64 n = 0;
    *uint8 data = fs_read_all(path, &n);
    if (data == null) return Err<Safetensors, string>(_st_fail("cannot read ", path));
    Result<Safetensors, string> r = safetensors_parse(data, (uint64)n);
    if (!r.ok) free(data);
    return r;
}

// Parses a file held in memory; the Safetensors owns data from then on.
Result<Safetensors, string> safetensors_parse(*uint8 data, uint64 len) {
    Safetensors st;
    st.file = data;
    st.len = len;
    if (len < 8) return Err<Safetensors, string>(_st_fail("the file is too short", null));
    uint64 hsize = 0;
    memcpy(&hsize, data, 8);
    if (hsize > len - 8 || hsize > 100000000) return Err<Safetensors, string>(_st_fail("the header size is out of range", null));
    *char text = alloc<char>((int64)hsize + 1);
    memcpy(text, data + 8, (int64)hsize);
    *JsonValue root = json_parse((string)text);
    free(text);
    if (root == null || root.kind != JObject) {
        if (root != null) JsonValue_free(root);
        return Err<Safetensors, string>(_st_fail("the header is not a JSON object", null));
    }
    defer JsonValue_free(root);
    uint64 base = 8 + hsize;
    uint64 avail = len - base;
    for (*JsonValue e = root.child; e != null; e = e.next) {
        if (e.key.data == null || strcmp(e.key.data, "__metadata__") == 0) continue;
        *JsonValue dt = JsonValue_get(e, "dtype");
        *JsonValue sh = JsonValue_get(e, "shape");
        *JsonValue off = JsonValue_get(e, "data_offsets");
        string err = null;
        if (dt == null || dt.kind != JString || sh == null || sh.kind != JArray || off == null || off.kind != JArray || JsonValue_len(off) != 2) {
            err = "a tensor entry is incomplete: ";
        }
        SafeTensor t;
        String_append(&t.name, e.key.data);
        if (err == null) {
            String_append(&t.dtype, dt.str.data != null ? dt.str.data : "");
            int esize = safetensors_dtype_size(t.dtype.data);
            if (esize == 0) err = "unsupported dtype in ";
            t.count = 1;
            for (*JsonValue d = sh.child; d != null && err == null; d = d.next) {
                if (d.kind != JNumber || d.num < 0.0 || d.num > 1e12 || t.ndims >= 8) err = "a bad shape in ";
                else {
                    t.shape[t.ndims] = (uint64)d.num;
                    t.ndims++;
                    t.count = t.count * (uint64)d.num;
                }
            }
            double b0 = off.child.num;
            double b1 = off.child.next.num;
            if (err == null && (b0 < 0.0 || b1 < b0 || b1 > (double)avail)) err = "data outside the file in ";
            if (err == null && (uint64)(b1 - b0) != t.count * (uint64)esize) err = "the data size does not match the shape in ";
            if (err == null) {
                t.data = data + base + (uint64)b0;
                t.size = (uint64)(b1 - b0);
            }
        }
        if (err != null) {
            string msg = _st_fail(err, t.name.data);
            String_free(&t.name);
            String_free(&t.dtype);
            Safetensors_free_entries(&st);
            return Err<Safetensors, string>(msg);
        }
        List_push(&st.tensors, t);
    }
    return Ok<Safetensors, string>(st);
}

SafeTensor* Safetensors_tensor(*Safetensors self, string name) {
    for (i in 0..self.tensors.size) {
        if (strcmp(self.tensors.data[i].name.data, name) == 0) return &self.tensors.data[i];
    }
    return null;
}

float _st_half(*uint8 p) {
    uint32 h = (uint32)p[0] | (uint32)p[1] << 8;
    uint32 sign = (h & 0x8000) << 16;
    uint32 exp = (h >> 10) & 0x1F;
    uint32 man = h & 0x3FF;
    uint32 bits = 0;
    if (exp == 0) {
        if (man != 0) {
            exp = 113;
            while ((man & 0x400) == 0) {
                man = man << 1;
                exp--;
            }
            bits = sign | (exp << 23) | ((man & 0x3FF) << 13);
        } else bits = sign;
    } else if (exp == 31) bits = sign | 0x7F800000 | (man << 13);
    else bits = sign | ((exp + 112) << 23) | (man << 13);
    float f = 0.0;
    memcpy(&f, &bits, 4);
    return f;
}

// The tensor's values as floats (out holds count values); false when the
// dtype is not a floating point one.
bool SafeTensor_floats(SafeTensor* self, *float out) {
    string d = self.dtype.data;
    if (strcmp(d, "F32") == 0) {
        memcpy(out, self.data, (int64)(self.count * 4));
        return true;
    }
    if (strcmp(d, "F16") == 0) {
        for (i in 0..self.count) out[i] = _st_half(self.data + i * 2);
        return true;
    }
    if (strcmp(d, "BF16") == 0) {
        for (i in 0..self.count) {
            uint32 bits = ((uint32)self.data[i * 2] | (uint32)self.data[i * 2 + 1] << 8) << 16;
            memcpy(&out[i], &bits, 4);
        }
        return true;
    }
    if (strcmp(d, "F64") == 0) {
        for (i in 0..self.count) {
            double x = 0.0;
            memcpy(&x, self.data + i * 8, 8);
            out[i] = (float)x;
        }
        return true;
    }
    return false;
}

void Safetensors_free_entries(*Safetensors self) {
    for (i in 0..self.tensors.size) {
        String_free(&self.tensors.data[i].name);
        String_free(&self.tensors.data[i].dtype);
    }
    List_free(&self.tensors);
}

void Safetensors_free(*Safetensors self) {
    Safetensors_free_entries(self);
    if (self.file != null) free(self.file);
    self.file = null;
}

// Adds an F32 tensor of rows x cols values (cols 0 for a vector of rows).
void SafetensorsWriter_add(SafetensorsWriter* self, string name, *float data, uint64 rows, uint64 cols) {
    _SafeEntry e;
    String_append(&e.name, name);
    e.data = data;
    e.rows = rows;
    e.cols = cols;
    List_push(&self.entries, e);
}

Result<int, string> SafetensorsWriter_save(SafetensorsWriter* self, string path) {
    String header;
    defer String_free(&header);
    String_append(&header, "{");
    uint64 at = 0;
    for (i in 0..self.entries.size) {
        _SafeEntry* e = &self.entries.data[i];
        uint64 count = e.cols == 0 ? e.rows : e.rows * e.cols;
        if (i > 0) String_append(&header, ",");
        String_appendf(&header, "\"%s\":{\"dtype\":\"F32\",\"shape\":[", e.name.data);
        if (e.cols == 0) String_appendf(&header, "%llu", e.rows);
        else String_appendf(&header, "%llu,%llu", e.rows, e.cols);
        String_appendf(&header, "],\"data_offsets\":[%llu,%llu]}", at, at + count * 4);
        at = at + count * 4;
    }
    String_append(&header, "}");
    while (header.len % 8 != 0) String_append(&header, " ");
    *void f = fs_open(path, "wb");
    if (f == null) return Err<int, string>(_st_fail("cannot write ", path));
    uint64 hsize = (uint64)header.len;
    fs_write(f, (*uint8)&hsize, 8);
    fs_write(f, (*uint8)header.data, header.len);
    for (i in 0..self.entries.size) {
        _SafeEntry* e = &self.entries.data[i];
        uint64 count = e.cols == 0 ? e.rows : e.rows * e.cols;
        fs_write(f, (*uint8)e.data, (int64)(count * 4));
    }
    fs_close(f);
    return Ok<int, string>(0);
}

void SafetensorsWriter_free(SafetensorsWriter* self) {
    for (i in 0..self.entries.size) String_free(&self.entries.data[i].name);
    List_free(&self.entries);
}
