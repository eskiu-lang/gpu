// png.esk: PNG decoding to RGBA8 (imported by <gpu/image>).
//
// Supports every color type (gray, gray+alpha, RGB, RGBA, palette), bit
// depths 1, 2, 4, 8 and 16 (16-bit samples keep their high byte), tRNS
// transparency for palette, gray and RGB images, the five row filters and
// Adam7 interlacing. Chunk lengths and CRCs are checked; ancillary chunks
// other than PLTE and tRNS are skipped, an unknown critical chunk is an error.
//
//     Result<Bitmap, string> r = png_decode(bytes, len);

import <mem>;
import <result>;
import <gpu/inflate>;
import <gpu/image>;

uint32[256] _png_crc_tab;
bool _png_crc_ready = false;

uint32 _png_crc(*uint8 p, uint64 n) {
    if (!_png_crc_ready) {
        for (i in 0..256) {
            uint32 c = (uint32)i;
            for (k in 0..8) {
                if ((c & 1) != 0) c = 0xEDB88320 ^ (c >> 1);
                else c = c >> 1;
            }
            _png_crc_tab[i] = c;
        }
        _png_crc_ready = true;
    }
    uint32 c = 0xFFFFFFFF;
    for (i in 0..n) c = _png_crc_tab[(int)((c ^ (uint32)p[i]) & 255)] ^ (c >> 8);
    return c ^ 0xFFFFFFFF;
}

uint32 _png_be32(*uint8 p) {
    return ((uint32)p[0] << 24) | ((uint32)p[1] << 16) | ((uint32)p[2] << 8) | (uint32)p[3];
}

bool _png_tag(*uint8 p, string t) {
    return memcmp((*void)p, (*void)t, 4) == 0;
}

struct _Png {
    int64 w;
    int64 h;
    int depth;
    int ct;
    int nch;
    int interlace;
    uint8[1024] plte;
    int plte_n;
    bool trns;
    int[3] tkey;
}

const int[7] _PNG_X0 = {0, 4, 0, 2, 0, 1, 0};
const int[7] _PNG_Y0 = {0, 0, 4, 0, 2, 0, 1};
const int[7] _PNG_DX = {8, 8, 4, 4, 2, 2, 1};
const int[7] _PNG_DY = {8, 8, 8, 4, 4, 2, 2};

int64 _png_rowbytes(*_Png p, int64 w) {
    return (w * (int64)p.nch * (int64)p.depth + 7) / 8;
}

// Width and height of an interlace pass (the whole image when not interlaced).
int64 _png_pass_w(*_Png p, int pass) {
    if (p.interlace == 0) return p.w;
    int64 x0 = (int64)_PNG_X0[pass];
    int64 dx = (int64)_PNG_DX[pass];
    if (p.w <= x0) return 0;
    return (p.w - x0 + dx - 1) / dx;
}

int64 _png_pass_h(*_Png p, int pass) {
    if (p.interlace == 0) return p.h;
    int64 y0 = (int64)_PNG_Y0[pass];
    int64 dy = (int64)_PNG_DY[pass];
    if (p.h <= y0) return 0;
    return (p.h - y0 + dy - 1) / dy;
}

int _png_paeth(int a, int b, int c) {
    int pp = a + b - c;
    int pa = pp > a ? pp - a : a - pp;
    int pb = pp > b ? pp - b : b - pp;
    int pc = pp > c ? pp - c : c - pp;
    if (pa <= pb && pa <= pc) return a;
    if (pb <= pc) return b;
    return c;
}

// Undoes one row's filter in place; prev is the previous unfiltered row of
// the same pass, or zeros for the first one.
bool _png_unfilter(*uint8 cur, *uint8 prev, int64 n, int64 bpp, int ft) {
    if (ft == 0) return true;
    if (ft == 1) {
        for (i in bpp..n) cur[i] = (uint8)((int)cur[i] + (int)cur[i - bpp]);
    } else if (ft == 2) {
        for (i in 0..n) cur[i] = (uint8)((int)cur[i] + (int)prev[i]);
    } else if (ft == 3) {
        int64 m = bpp < n ? bpp : n;
        for (i in 0..m) cur[i] = (uint8)((int)cur[i] + ((int)prev[i] >> 1));
        for (i in m..n) cur[i] = (uint8)((int)cur[i] + (((int)cur[i - bpp] + (int)prev[i]) >> 1));
    } else if (ft == 4) {
        int64 m = bpp < n ? bpp : n;
        for (i in 0..m) cur[i] = (uint8)((int)cur[i] + (int)prev[i]);
        for (i in m..n) cur[i] = (uint8)((int)cur[i] + _png_paeth((int)cur[i - bpp], (int)prev[i], (int)prev[i - bpp]));
    } else {
        return false;
    }
    return true;
}

// Converts `count` pixels of an unfiltered row to RGBA8, writing each one
// `step` bytes after the previous.
void _png_emit(*_Png p, *uint8 row, int64 count, *uint8 out, int64 step) {
    *uint8 o = out;
    int d = p.depth;
    if (p.ct == 0 || p.ct == 3) {
        int maxv = (1 << d) - 1;
        for (x in 0..count) {
            int v = 0;
            int g = 0;
            if (d == 16) {
                v = ((int)row[x * 2] << 8) | (int)row[x * 2 + 1];
                g = (int)row[x * 2];
            } else if (d == 8) {
                v = (int)row[x];
                g = v;
            } else {
                int64 bit = x * (int64)d;
                int shift = 8 - d - (int)(bit & 7);
                v = ((int)row[bit >> 3] >> shift) & maxv;
                g = v * 255 / maxv;
            }
            if (p.ct == 3) {
                int k = v * 4;
                o[0] = p.plte[k];
                o[1] = p.plte[k + 1];
                o[2] = p.plte[k + 2];
                o[3] = p.plte[k + 3];
            } else {
                o[0] = (uint8)g;
                o[1] = (uint8)g;
                o[2] = (uint8)g;
                o[3] = p.trns && v == p.tkey[0] ? 0 : 255;
            }
            o = o + step;
        }
    } else if (p.ct == 2) {
        for (x in 0..count) {
            if (d == 8) {
                *uint8 s = row + x * 3;
                o[0] = s[0];
                o[1] = s[1];
                o[2] = s[2];
                bool key = p.trns && (int)s[0] == p.tkey[0] && (int)s[1] == p.tkey[1] && (int)s[2] == p.tkey[2];
                o[3] = key ? 0 : 255;
            } else {
                *uint8 s = row + x * 6;
                o[0] = s[0];
                o[1] = s[2];
                o[2] = s[4];
                int r = ((int)s[0] << 8) | (int)s[1];
                int g = ((int)s[2] << 8) | (int)s[3];
                int b = ((int)s[4] << 8) | (int)s[5];
                bool key = p.trns && r == p.tkey[0] && g == p.tkey[1] && b == p.tkey[2];
                o[3] = key ? 0 : 255;
            }
            o = o + step;
        }
    } else if (p.ct == 4) {
        int64 sz = d == 8 ? 2 : 4;
        int64 a = d == 8 ? 1 : 2;
        for (x in 0..count) {
            *uint8 s = row + x * sz;
            o[0] = s[0];
            o[1] = s[0];
            o[2] = s[0];
            o[3] = s[a];
            o = o + step;
        }
    } else {
        int64 sz = d == 8 ? 4 : 8;
        int64 c = d == 8 ? 1 : 2;
        for (x in 0..count) {
            *uint8 s = row + x * sz;
            o[0] = s[0];
            o[1] = s[c];
            o[2] = s[c * 2];
            o[3] = s[c * 3];
            o = o + step;
        }
    }
}

string _png_header(*_Png p, *uint8 d) {
    p.w = (int64)_png_be32(d);
    p.h = (int64)_png_be32(d + 4);
    p.depth = (int)d[8];
    p.ct = (int)d[9];
    p.interlace = (int)d[12];
    if (p.w == 0 || p.h == 0 || p.w > 0x1000000 || p.h > 0x1000000) return "png: bad size";
    if (p.w * p.h > 0x10000000) return "png: image too large";
    if (d[10] != 0 || d[11] != 0 || p.interlace > 1) return "png: bad header";
    int dp = p.depth;
    bool ok = false;
    if (p.ct == 0) {
        p.nch = 1;
        ok = dp == 1 || dp == 2 || dp == 4 || dp == 8 || dp == 16;
    } else if (p.ct == 3) {
        p.nch = 1;
        ok = dp == 1 || dp == 2 || dp == 4 || dp == 8;
    } else if (p.ct == 2 || p.ct == 4 || p.ct == 6) {
        p.nch = p.ct == 2 ? 3 : p.ct == 4 ? 2 : 4;
        ok = dp == 8 || dp == 16;
    }
    if (!ok) return "png: bad color type or depth";
    return null;
}

// Walks the chunks after the signature, filling the header fields and either
// adding up the IDAT lengths (idat == null) or copying the IDAT data.
string _png_chunks(*_Png p, *uint8 data, uint64 len, *uint8 idat, *uint64 idat_len) {
    uint64 pos = 8;
    bool first = true;
    bool seen_idat = false;
    uint64 total = 0;
    while (true) {
        if (len - pos < 12) return "png: truncated";
        uint64 n = (uint64)_png_be32(data + pos);
        if (n > 0x7FFFFFFF) return "png: bad chunk length";
        if (n > len - pos - 12) return "png: truncated";
        *uint8 tag = data + pos + 4;
        *uint8 body = data + pos + 8;
        if (idat == null && _png_crc(tag, n + 4) != _png_be32(body + n)) return "png: bad crc";
        pos += n + 12;
        if (first) {
            if (!_png_tag(tag, "IHDR") || n != 13) return "png: missing IHDR";
            first = false;
            if (idat == null) {
                string e = _png_header(p, body);
                if (e != null) return e;
            }
            continue;
        }
        if (_png_tag(tag, "IDAT")) {
            if (p.ct == 3 && p.plte_n == 0) return "png: missing PLTE";
            if (idat != null) memcpy((*void)(idat + total), (*void)body, (int64)n);
            total += n;
            seen_idat = true;
        } else if (_png_tag(tag, "IEND")) {
            if (!seen_idat) return "png: missing IDAT";
            *idat_len = total;
            return null;
        } else if (idat != null) {
            continue;
        } else if (_png_tag(tag, "IHDR")) {
            return "png: duplicate IHDR";
        } else if (_png_tag(tag, "PLTE")) {
            if (n % 3 != 0 || n == 0 || n > 768 || seen_idat) return "png: bad PLTE";
            int cnt = (int)(n / 3);
            if (p.ct == 3 && cnt > (1 << p.depth)) return "png: bad PLTE";
            for (i in 0..cnt) {
                p.plte[i * 4] = body[i * 3];
                p.plte[i * 4 + 1] = body[i * 3 + 1];
                p.plte[i * 4 + 2] = body[i * 3 + 2];
            }
            p.plte_n = cnt;
        } else if (_png_tag(tag, "tRNS")) {
            if (seen_idat) return "png: bad tRNS";
            if (p.ct == 3) {
                if (p.plte_n == 0 || n > (uint64)p.plte_n) return "png: bad tRNS";
                for (i in 0..(int)n) p.plte[i * 4 + 3] = body[i];
            } else if (p.ct == 0) {
                if (n != 2) return "png: bad tRNS";
                p.tkey[0] = ((int)body[0] << 8) | (int)body[1];
                p.trns = true;
            } else if (p.ct == 2) {
                if (n != 6) return "png: bad tRNS";
                for (i in 0..3) p.tkey[i] = ((int)body[i * 2] << 8) | (int)body[i * 2 + 1];
                p.trns = true;
            }
        } else if ((tag[0] & 32) == 0) {
            return "png: unknown critical chunk";
        }
    }
    return null;
}

// Decodes a PNG held in memory. The pixels are always RGBA8.
Result<Bitmap, string> png_decode(*uint8 data, uint64 len) {
    if (data == null || len < 8) return Err<Bitmap, string>("png: bad signature");
    if (data[0] != 137 || data[1] != 80 || data[2] != 78 || data[3] != 71 || data[4] != 13 || data[5] != 10 || data[6] != 26 || data[7] != 10) {
        return Err<Bitmap, string>("png: bad signature");
    }
    *_Png p = alloc<_Png>(1);
    if (p == null) return Err<Bitmap, string>("png: out of memory");
    defer free((*void)p);
    for (i in 0..256) p.plte[i * 4 + 3] = 255;
    uint64 zlen = 0;
    string e = _png_chunks(p, data, len, null, &zlen);
    if (e != null) return Err<Bitmap, string>(e);
    *uint8 z = alloc<uint8>((int64)zlen + 1);
    if (z == null) return Err<Bitmap, string>("png: out of memory");
    defer free((*void)z);
    _png_chunks(p, data, len, z, &zlen);

    int passes = p.interlace == 0 ? 1 : 7;
    int64 raw_len = 0;
    for (k in 0..passes) {
        int64 pw = _png_pass_w(p, k);
        int64 ph = _png_pass_h(p, k);
        if (pw > 0 && ph > 0) raw_len += ph * (_png_rowbytes(p, pw) + 1);
    }
    // DEFLATE expands at most about 1032 to 1, so a header that promises far
    // more pixels than the data can hold is rejected before allocating.
    if (raw_len / 1032 > (int64)zlen + 64) return Err<Bitmap, string>("png: not enough image data");
    *uint8 raw = alloc<uint8>(raw_len + 1);
    if (raw == null) return Err<Bitmap, string>("png: out of memory");
    defer free((*void)raw);
    uint64 got = inflate_zlib(z, zlen, raw, (uint64)raw_len)?;
    if (got != (uint64)raw_len) return Err<Bitmap, string>("png: not enough image data");

    int64 full_row = _png_rowbytes(p, p.w);
    *uint8 zero = alloc<uint8>(full_row + 1);
    if (zero == null) return Err<Bitmap, string>("png: out of memory");
    defer free((*void)zero);
    *uint8 rgba = alloc<uint8>(p.w * p.h * 4);
    if (rgba == null) return Err<Bitmap, string>("png: out of memory");
    int64 bpp = ((int64)p.nch * (int64)p.depth + 7) / 8;
    int64 off = 0;
    for (k in 0..passes) {
        int64 pw = _png_pass_w(p, k);
        int64 ph = _png_pass_h(p, k);
        if (pw == 0 || ph == 0) continue;
        int64 rb = _png_rowbytes(p, pw);
        int64 x0 = p.interlace == 0 ? 0 : (int64)_PNG_X0[k];
        int64 y0 = p.interlace == 0 ? 0 : (int64)_PNG_Y0[k];
        int64 dx = p.interlace == 0 ? 1 : (int64)_PNG_DX[k];
        int64 dy = p.interlace == 0 ? 1 : (int64)_PNG_DY[k];
        *uint8 prev = zero;
        for (y in 0..ph) {
            *uint8 cur = raw + off + 1;
            if (!_png_unfilter(cur, prev, rb, bpp, (int)raw[off])) {
                free((*void)rgba);
                return Err<Bitmap, string>("png: bad filter");
            }
            _png_emit(p, cur, pw, rgba + ((y0 + y * dy) * p.w + x0) * 4, dx * 4);
            prev = cur;
            off += rb + 1;
        }
    }
    return Ok<Bitmap, string>(Bitmap{(uint32)p.w, (uint32)p.h, rgba});
}
