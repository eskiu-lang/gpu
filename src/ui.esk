// ui.esk: GpuView for eskiu-lang/ui apps on iOS (CAMetalLayer) and Android
// (SurfaceView / ANativeWindow). Import <gpu/ui> alongside <ui> and <gpu>:
//
//     use_gpu_surface(void(uint32 w, uint32 h) {
//         ...
//     });
//     GpuView(Style{flex_grow: 1});
//
// Once GpuView has laid out (use_gpu_surface fires with its pixel size), call
// gpu_ui_surface(&gpu) to create and configure a GpuSurface for it. When the surface goes
// away (Android sends the app to the background), use_gpu_surface fires with (0, 0): release
// what was made for it, and make it again at the next size.
//
// On the web and the desktop hosts GpuView is an empty box and use_gpu_surface never fires;
// gpu_ui_surface and the WebGPU modules exist on iOS and Android only, so code that renders
// sits under `#if defined(__ANDROID__) || defined(TARGET_OS_IPHONE)`.
//
// Touches on GpuView come through use_gpu_touch (each GpuTouch) or use_gpu_touches (the
// fingers that are down, for a use_frame handler to read): see <gpu/touch>.

import <mem>;
import <result>;
import <string>;
import <ui>;
import <gpu/touch>;

#if defined(__ANDROID__) || defined(TARGET_OS_IPHONE)
import <gpu/raw>;
import <gpu/core>;
import <gpu/render>;

extern *void gpu_ui_native_handle(*int width, *int height);
#endif

// Parses "resize WIDTH HEIGHT" from the "gpu" native channel.
bool _gpu_ui_parse_resize(string payload, *uint32 width, *uint32 height) {
    if (payload == null || strncmp(payload, "resize ", 7) != 0) return false;
    int at = 7;
    uint32 w = 0;
    while (payload[at] >= '0' && payload[at] <= '9') {
        w = w * 10 + (uint32)(payload[at] - '0');
        at++;
    }
    if (at == 7 || payload[at] != ' ') return false;
    at++;
    uint32 h = 0;
    int hstart = at;
    while (payload[at] >= '0' && payload[at] <= '9') {
        h = h * 10 + (uint32)(payload[at] - '0');
        at++;
    }
    if (at == hstart || w == 0 || h == 0) return false;
    *width = w;
    *height = h;
    return true;
}

struct _GpuSurfaceHandler {
    fn(uint32, uint32)->void handler;
}

void _gpu_ui_release_handler(escaping fn(uint32, uint32)->void handler) {
    free_closure(handler);
}

// Calls on_resize(width, height) in physical pixels whenever the mounted
// GpuView's native surface becomes ready or changes size.
void use_gpu_surface(escaping fn(uint32, uint32)->void on_resize) {
    static int tag;
    *Slot slot = ui_slot(10, &tag);
    *_GpuSurfaceHandler held = (*_GpuSurfaceHandler)slot.data;
    if (held == null) {
        held = alloc<_GpuSurfaceHandler>(1);
        slot.data = held;
        slot.dispose = void() {
            _gpu_ui_release_handler(held.handler);
            free(held);
        };
    } else {
        _gpu_ui_release_handler(held.handler);
    }
    held.handler = on_resize;
    use_native_event("gpu", void(string payload) {
        uint32 w = 0;
        uint32 h = 0;
        if (_gpu_ui_parse_resize(payload, &w, &h)) {
            held.handler(w, h);
        } else if (payload != null && strcmp(payload, "destroy") == 0) {
            held.handler(0, 0);
        }
    });
}

struct _GpuTouchHandler {
    fn(GpuTouch)->void handler;
}

void _gpu_ui_release_touch(escaping fn(GpuTouch)->void handler) {
    free_closure(handler);
}

// Calls on_touch with each touch on the mounted GpuView, in the order the platform gave
// them: every finger has its own id, so several move at once (see GpuTouch).
void use_gpu_touch(escaping fn(GpuTouch)->void on_touch) {
    static int tag;
    *Slot slot = ui_slot(10, &tag);
    *_GpuTouchHandler held = (*_GpuTouchHandler)slot.data;
    if (held == null) {
        held = alloc<_GpuTouchHandler>(1);
        slot.data = held;
        slot.dispose = void() {
            _gpu_ui_release_touch(held.handler);
            free(held);
        };
    } else {
        _gpu_ui_release_touch(held.handler);
    }
    held.handler = on_touch;
    use_native_event("gpu", void(string payload) {
        GpuTouch[32] touches;
        int n = gpu_touch_parse(payload, &touches[0], 32);
        for (i in 0..n) held.handler(touches[i]);
    });
}

// The fingers on the mounted GpuView, kept while the scope is mounted: read it each frame
// (use_frame) and call end_frame when done. When the surface goes away every finger is
// released as cancelled.
*GpuTouches use_gpu_touches() {
    static int tag;
    *Slot slot = ui_slot(10, &tag);
    *GpuTouches touches = (*GpuTouches)slot.data;
    if (touches == null) {
        touches = alloc<GpuTouches>(1);
        slot.data = touches;
        slot.dispose = void() {
            touches.free();
            free(touches);
        };
    }
    use_native_event("gpu", void(string payload) {
        GpuTouch[32] buf;
        int n = gpu_touch_parse(payload, &buf[0], 32);
        for (i in 0..n) touches.apply(buf[i]);
        if (n < 0 && payload != null && strcmp(payload, "destroy") == 0 && touches.down.size > 0) {
            touches.cancel_all(touches.down.data[touches.down.size - 1].time);
        }
    });
    return touches;
}

// Mounts a native GPU surface view (CAMetalLayer on iOS, SurfaceView on
// Android) filling the box layout gives it.
void GpuView(Style style) {
#if defined(__ANDROID__) || defined(TARGET_OS_IPHONE)
    NativeView(style, "gpu", void(string name, string payload) {});
#else
    Column(style) {}
#endif
}

#if defined(__ANDROID__) || defined(TARGET_OS_IPHONE)
// Creates and configures a GpuSurface for the currently mounted GpuView.
Result<GpuSurface, string> gpu_ui_surface(*Gpu gpu) {
    int w = 0;
    int h = 0;
    *void handle = gpu_ui_native_handle(&w, &h);
    if (handle == null || w <= 0 || h <= 0) {
        return Err<GpuSurface, string>("gpu/ui: GpuView surface is not ready");
    }
#ifdef TARGET_OS_IPHONE
    GpuSurface s = gpu.surface_metal(handle)?;
    s.configure((uint32)w, (uint32)h);
    return Ok<GpuSurface, string>(s);
#elif defined(__ANDROID__)
    GpuSurface s = gpu.surface_android(handle)?;
    s.configure((uint32)w, (uint32)h);
    return Ok<GpuSurface, string>(s);
#endif
}
#endif
