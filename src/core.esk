// core.esk: devices, buffers and compute kernels (imported by <gpu>).
//
// gpu_open() picks an adapter and a device. Every fallible call returns a
// Result whose error is a message from the WebGPU validation layer; the message
// lives in a buffer that the next error reuses, so copy it to keep it.
// Each object has a release method, meant to be paired with defer:
//
//     Gpu gpu = gpu_open()?;
//     defer gpu.release();
//     GpuBuffer v = gpu.storage(data, bytes)?;
//     defer v.release();
//
// The raw WebGPU API is in <gpu/raw> for anything this layer does not cover.
//
// In a browser (wasm32-unknown-emscripten) the API is the same: each wait for the
// GPU suspends the program until the browser's promise settles, which needs a build
// with --link-arg=-sJSPI or --link-arg=-sASYNCIFY (docs/web.md).

import <io>;
import <mem>;
import <string>;
import <list>;
import <result>;
import <gpu/raw>;

String _gpu_err;

struct _GpuWait {
    int done;
    uint32 status;
    *void handle;
    String msg;
    uint64 future;
}

#ifdef __EMSCRIPTEN__
extern void emscripten_sleep(uint32 ms);
extern int emscripten_run_script_int(string script);
#endif

struct _GpuState {
    String uncaptured;
}

// f16 and subgroups say whether shaders may use f16 values and subgroup
// operations; subgroup_min and subgroup_max bound the subgroup size (they
// vary by GPU: 32 on Apple and NVIDIA, 64 on some AMD, 4 to 64 elsewhere;
// Metal does not report them and Apple GPUs use 32);
// max_buffer is the largest buffer the device allows; depth32_stencil8 says
// whether textures may be Depth32FloatStencil8 (Depth24PlusStencil8 always can).
// float32_filterable says whether R32Float, RG32Float and RGBA32Float textures
// may be sampled with linear filtering; bc, etc2 and astc whether textures may
// be in those block-compressed formats (BC on desktop GPUs, ETC2 and ASTC on
// phones and Apple Silicon). gpu_open turns on each one the adapter has.
struct Gpu {
    WGPUInstance instance;
    WGPUAdapter adapter;
    WGPUDevice device;
    WGPUQueue queue;
    *_GpuState state;
    bool f16;
    bool subgroups;
    uint64 max_buffer;
    uint32 subgroup_min;
    uint32 subgroup_max;
    bool depth32_stencil8;
    bool float32_filterable;
    bool bc;
    bool etc2;
    bool astc;
}

// A buffer in GPU memory: handle is the WebGPU buffer and size its length in bytes. It
// keeps a copy of the Gpu that made it, so it must be released before that Gpu is.
struct GpuBuffer {
    Gpu gpu;
    WGPUBuffer handle;
    uint64 size;
}

// A compute pipeline made by Gpu_kernel: the shader module, the pipeline, the layout of
// its bind group 0 and the buffers bound so far with bind(). It keeps a copy of the Gpu
// that made it.
struct GpuKernel {
    Gpu gpu;
    WGPUShaderModule module;
    WGPUComputePipeline pipeline;
    WGPUBindGroupLayout layout;
    List<WGPUBindGroupEntry> entries;
}

// A WebGPU string view over s, without copying it; null gives an empty view. For calls
// into <gpu/raw>.
WGPUStringView gpu_str(string s) {
    if (s == null) return WGPUStringView{null, 0};
    return WGPUStringView{s, (uint64)strlen(s)};
}

string _gpu_fail(string what, String* detail) {
    String_clear(&_gpu_err);
    String_append(&_gpu_err, what);
    if (detail != null && detail.len > 0) {
        String_append(&_gpu_err, ": ");
        String_append(&_gpu_err, detail.data);
    }
    return _gpu_err.data;
}

void _gpu_set_msg(String* s, WGPUStringView m) {
    String_clear(s);
    if (m.data != null && m.length > 0) String_appendf(s, "%.*s", (int)m.length, m.data);
}

void _gpu_on_adapter(WGPURequestAdapterStatus status, WGPUAdapter adapter, WGPUStringView message, *void u1, *void u2) {
    *_GpuWait w = (*_GpuWait)u1;
    w.status = status;
    w.handle = adapter;
    _gpu_set_msg(&w.msg, message);
    w.done = 1;
}

void _gpu_on_device(WGPURequestDeviceStatus status, WGPUDevice device, WGPUStringView message, *void u1, *void u2) {
    *_GpuWait w = (*_GpuWait)u1;
    w.status = status;
    w.handle = device;
    _gpu_set_msg(&w.msg, message);
    w.done = 1;
}

void _gpu_on_scope(WGPUPopErrorScopeStatus status, WGPUErrorType kind, WGPUStringView message, *void u1, *void u2) {
    *_GpuWait w = (*_GpuWait)u1;
    w.status = status == WGPUPopErrorScopeStatus_Success ? kind : WGPUErrorType_Unknown;
    _gpu_set_msg(&w.msg, message);
    w.done = 1;
}

void _gpu_on_map(WGPUMapAsyncStatus status, WGPUStringView message, *void u1, *void u2) {
    *_GpuWait w = (*_GpuWait)u1;
    w.status = status;
    _gpu_set_msg(&w.msg, message);
    w.done = 1;
}

void _gpu_on_uncaptured(*WGPUDevice device, WGPUErrorType kind, WGPUStringView message, *void u1, *void u2) {
    *_GpuState st = (*_GpuState)u1;
    _gpu_set_msg(&st.uncaptured, message);
}

void _gpu_on_done(WGPUQueueWorkDoneStatus status, WGPUStringView message, *void u1, *void u2) {
    *_GpuWait w = (*_GpuWait)u1;
    w.status = status;
    w.done = 1;
}

// Waits for w's callback. In a browser the program is suspended (JSPI or Asyncify)
// on w's future, for a minute at most; the callbacks run from the browser's event loop.
void _gpu_wait(*Gpu g, *_GpuWait w) {
#ifdef __EMSCRIPTEN__
    if (w.done == 0 && w.future != 0) {
        WGPUFutureWaitInfo info = WGPUFutureWaitInfo{future: WGPUFuture{w.future}};
        wgpuInstanceWaitAny(g.instance, 1, &info, (uint64)60000000000);
    }
    for (i in 0..100) {
        if (w.done) return;
        emscripten_sleep(0);
    }
#else
    for (i in 0..100000) {
        if (w.done) return;
        if (g.device != null) wgpuDevicePoll(g.device, 1, null);
        else wgpuInstanceProcessEvents(g.instance);
    }
#endif
}

// Adds feature to the list when the adapter has it.
bool _gpu_want(*Gpu g, WGPUFeatureName feature, *WGPUFeatureName list, *uint64 n) {
    if (wgpuAdapterHasFeature(g.adapter, feature) == 0) return false;
    list[*n] = feature;
    *n = *n + 1;
    return true;
}

// Opens the high-performance adapter and a device with the adapter's full limits and every
// optional feature listed on Gpu that it has. Fails with "no WebGPU instance", "no GPU
// adapter" or "no GPU device" and the driver's message; in a browser also with "no
// WebGPU in this browser".
Result<Gpu, string> gpu_open() {
    Gpu g;
#ifdef __EMSCRIPTEN__
    if (emscripten_run_script_int("typeof navigator !== 'undefined' && !!navigator.gpu ? 1 : 0") == 0) {
        return Err<Gpu, string>(_gpu_fail("no WebGPU in this browser", null));
    }
    // Timed waits let _gpu_wait suspend on a future; they need JSPI or Asyncify.
    WGPUInstanceFeatureName timed = WGPUInstanceFeatureName_TimedWaitAny;
    WGPUInstanceDescriptor idesc = WGPUInstanceDescriptor{requiredFeatureCount: 1, requiredFeatures: &timed};
    g.instance = wgpuCreateInstance(&idesc);
    if (g.instance == null) return Err<Gpu, string>(_gpu_fail("no WebGPU instance (build with --link-arg=-sJSPI or --link-arg=-sASYNCIFY)", null));
#else
    g.instance = wgpuCreateInstance(null);
    if (g.instance == null) return Err<Gpu, string>(_gpu_fail("no WebGPU instance", null));
#endif
    _GpuWait w;
    defer String_free(&w.msg);
    WGPURequestAdapterOptions opts = WGPURequestAdapterOptions{powerPreference: WGPUPowerPreference_HighPerformance};
    WGPURequestAdapterCallbackInfo ai = WGPURequestAdapterCallbackInfo{mode: WGPUCallbackMode_AllowSpontaneous, callback: (*void)_gpu_on_adapter, userdata1: &w};
    w.future = wgpuInstanceRequestAdapter(g.instance, &opts, ai).id;
    _gpu_wait(&g, &w);
    if (w.status != WGPURequestAdapterStatus_Success || w.handle == null) {
        wgpuInstanceRelease(g.instance);
        return Err<Gpu, string>(_gpu_fail("no GPU adapter", &w.msg));
    }
    g.adapter = (WGPUAdapter)w.handle;
    g.state = alloc<_GpuState>(1);
    w.done = 0;
    // Ask for everything the adapter offers: the WebGPU defaults cap a
    // storage buffer at 128 MB, too little for model weights.
    WGPULimits limits;
    wgpuAdapterGetLimits(g.adapter, &limits);
    WGPUFeatureName[8] features;
    uint64 nfeatures = 0;
    if (wgpuAdapterHasFeature(g.adapter, WGPUFeatureName_ShaderF16) != 0) {
        features[nfeatures] = WGPUFeatureName_ShaderF16;
        nfeatures++;
        g.f16 = true;
    }
    if (wgpuAdapterHasFeature(g.adapter, WGPUFeatureName_Subgroups) != 0) {
        features[nfeatures] = WGPUFeatureName_Subgroups;
        nfeatures++;
        g.subgroups = true;
    }
#ifndef __EMSCRIPTEN__
    if (!g.subgroups && wgpuAdapterHasFeature(g.adapter, (WGPUFeatureName)WGPUNativeFeature_Subgroup) != 0) {
        features[nfeatures] = (WGPUFeatureName)WGPUNativeFeature_Subgroup;
        nfeatures++;
        g.subgroups = true;
    }
#endif
    if (wgpuAdapterHasFeature(g.adapter, WGPUFeatureName_Depth32FloatStencil8) != 0) {
        features[nfeatures] = WGPUFeatureName_Depth32FloatStencil8;
        nfeatures++;
        g.depth32_stencil8 = true;
    }
    g.float32_filterable = _gpu_want(&g, WGPUFeatureName_Float32Filterable, &features[0], &nfeatures);
    g.bc = _gpu_want(&g, WGPUFeatureName_TextureCompressionBC, &features[0], &nfeatures);
    g.etc2 = _gpu_want(&g, WGPUFeatureName_TextureCompressionETC2, &features[0], &nfeatures);
    g.astc = _gpu_want(&g, WGPUFeatureName_TextureCompressionASTC, &features[0], &nfeatures);
    g.max_buffer = limits.maxBufferSize;
    WGPUAdapterInfo info;
    wgpuAdapterGetInfo(g.adapter, &info);
    g.subgroup_min = info.subgroupMinSize;
    g.subgroup_max = info.subgroupMaxSize;
    if (info.backendType == WGPUBackendType_Metal && g.subgroup_max == 0) {
        g.subgroup_min = 32;
        g.subgroup_max = 32;
    }
    wgpuAdapterInfoFreeMembers(info);
    WGPUDeviceDescriptor dd = WGPUDeviceDescriptor{label: gpu_str("eskiu"), requiredFeatureCount: nfeatures,
        requiredFeatures: &features[0], requiredLimits: &limits,
        uncapturedErrorCallbackInfo: WGPUUncapturedErrorCallbackInfo{callback: (*void)_gpu_on_uncaptured, userdata1: g.state}};
    WGPURequestDeviceCallbackInfo di = WGPURequestDeviceCallbackInfo{mode: WGPUCallbackMode_AllowSpontaneous, callback: (*void)_gpu_on_device, userdata1: &w};
    w.future = wgpuAdapterRequestDevice(g.adapter, &dd, di).id;
    _gpu_wait(&g, &w);
    if (w.status != WGPURequestDeviceStatus_Success || w.handle == null) {
        wgpuAdapterRelease(g.adapter);
        wgpuInstanceRelease(g.instance);
        free(g.state);
        return Err<Gpu, string>(_gpu_fail("no GPU device", &w.msg));
    }
    g.device = (WGPUDevice)w.handle;
    g.queue = wgpuDeviceGetQueue(g.device);
    return Ok<Gpu, string>(g);
}

// Releases the queue, device, adapter and instance and zeroes the Gpu. Release every
// object made from it first.
void Gpu_release(*Gpu self) {
    if (self.queue != null) wgpuQueueRelease(self.queue);
    if (self.device != null) wgpuDeviceRelease(self.device);
    if (self.adapter != null) wgpuAdapterRelease(self.adapter);
    if (self.instance != null) wgpuInstanceRelease(self.instance);
    if (self.state != null) {
        String_free(&self.state.uncaptured);
        free(self.state);
    }
    *self = Gpu{};
}

// The adapter's name, as the driver reports it, appended to out.
void Gpu_name(*Gpu self, String* out) {
    WGPUAdapterInfo info;
    wgpuAdapterGetInfo(self.adapter, &info);
    String_appendf(out, "%.*s", (int)info.device.length, info.device.data);
    wgpuAdapterInfoFreeMembers(info);
}

// Blocks until the work submitted so far has finished.
void Gpu_wait(*Gpu self) {
#ifdef __EMSCRIPTEN__
    _GpuWait w;
    WGPUQueueWorkDoneCallbackInfo ci = WGPUQueueWorkDoneCallbackInfo{mode: WGPUCallbackMode_AllowSpontaneous, callback: (*void)_gpu_on_done, userdata1: &w};
    w.future = wgpuQueueOnSubmittedWorkDone(self.queue, ci).id;
    _gpu_wait(self, &w);
    String_free(&w.msg);
#else
    wgpuDevicePoll(self.device, 1, null);
#endif
}

void _gpu_push(*Gpu g) {
    wgpuDevicePushErrorScope(g.device, WGPUErrorFilter_Validation);
}

// Pops the validation scope pushed by _gpu_push: null when nothing failed,
// else the message prefixed by what.
string _gpu_pop(*Gpu g, string what) {
    _GpuWait w;
    defer String_free(&w.msg);
    WGPUPopErrorScopeCallbackInfo pi = WGPUPopErrorScopeCallbackInfo{mode: WGPUCallbackMode_AllowSpontaneous, callback: (*void)_gpu_on_scope, userdata1: &w};
    w.future = wgpuDevicePopErrorScope(g.device, pi).id;
    _gpu_wait(g, &w);
    if (w.status == WGPUErrorType_NoError) return null;
    return _gpu_fail(what, &w.msg);
}

// A buffer of size bytes with the given WGPUBufferUsage flags, its contents zero. Fails
// with the validation message, for example when size is above max_buffer.
Result<GpuBuffer, string> Gpu_buffer(*Gpu self, uint64 size, WGPUBufferUsage usage) {
    _gpu_push(self);
    WGPUBufferDescriptor d = WGPUBufferDescriptor{usage: usage, size: size};
    WGPUBuffer b = wgpuDeviceCreateBuffer(self.device, &d);
    string err = _gpu_pop(self, "buffer");
    if (err != null || b == null) {
        if (b != null) wgpuBufferRelease(b);
        return Err<GpuBuffer, string>(err != null ? err : _gpu_fail("buffer", null));
    }
    return Ok<GpuBuffer, string>(GpuBuffer{*self, b, size});
}

// A storage buffer holding a copy of bytes bytes at data (data may be null for
// a zeroed buffer), readable back with read().
Result<GpuBuffer, string> Gpu_storage(*Gpu self, *void data, uint64 bytes) {
    GpuBuffer b = Gpu_buffer(self, bytes, WGPUBufferUsage_Storage | WGPUBufferUsage_CopySrc | WGPUBufferUsage_CopyDst)?;
    if (data != null) GpuBuffer_write(&b, 0, data, bytes);
    return Ok<GpuBuffer, string>(b);
}

// Copies bytes bytes from data into the buffer at byte offset offset. The copy is queued:
// data can be reused as soon as the call returns, and the write lands before the next
// submitted work. offset and bytes must be multiples of 4.
void GpuBuffer_write(*GpuBuffer self, uint64 offset, *void data, uint64 bytes) {
    wgpuQueueWriteBuffer(self.gpu.queue, self.handle, offset, data, bytes);
}

// Copies the first bytes bytes of the buffer to out, after the work submitted
// so far has finished.
Result<int, string> GpuBuffer_read(*GpuBuffer self, *void out, uint64 bytes) {
    GpuBuffer staging = _gpu_stage(self, bytes)?;
    defer GpuBuffer_release(&staging);
    return GpuBuffer_read_mapped(&staging, out, bytes);
}

// A MapRead buffer holding a copy of the first bytes bytes of b, once the
// submitted work has finished.
Result<GpuBuffer, string> _gpu_stage(*GpuBuffer b, uint64 bytes) {
    *Gpu g = &b.gpu;
    GpuBuffer staging = Gpu_buffer(g, bytes, WGPUBufferUsage_MapRead | WGPUBufferUsage_CopyDst)?;
    _gpu_push(g);
    WGPUCommandEncoder enc = wgpuDeviceCreateCommandEncoder(g.device, null);
    wgpuCommandEncoderCopyBufferToBuffer(enc, b.handle, 0, staging.handle, 0, bytes);
    WGPUCommandBuffer cmd = wgpuCommandEncoderFinish(enc, null);
    wgpuQueueSubmit(g.queue, 1, &cmd);
    wgpuCommandBufferRelease(cmd);
    wgpuCommandEncoderRelease(enc);
    string err = _gpu_pop(g, "read");
    if (err != null) {
        GpuBuffer_release(&staging);
        return Err<GpuBuffer, string>(err);
    }
    return Ok<GpuBuffer, string>(staging);
}

// Maps a MapRead buffer and copies its first bytes bytes to out.
Result<int, string> GpuBuffer_read_mapped(*GpuBuffer self, *void out, uint64 bytes) {
    *Gpu g = &self.gpu;
    GpuBuffer staging = *self;
    _GpuWait w;
    defer String_free(&w.msg);
    WGPUBufferMapCallbackInfo mi = WGPUBufferMapCallbackInfo{mode: WGPUCallbackMode_AllowSpontaneous, callback: (*void)_gpu_on_map, userdata1: &w};
    w.future = wgpuBufferMapAsync(staging.handle, WGPUMapMode_Read, 0, bytes, mi).id;
    _gpu_wait(g, &w);
    if (w.status != WGPUMapAsyncStatus_Success) return Err<int, string>(_gpu_fail("read", &w.msg));
    memcpy(out, wgpuBufferGetConstMappedRange(staging.handle, 0, bytes), (int64)bytes);
    wgpuBufferUnmap(staging.handle);
    return Ok<int, string>(0);
}

// Releases the buffer; a second call does nothing.
void GpuBuffer_release(*GpuBuffer self) {
    if (self.handle != null) wgpuBufferRelease(self.handle);
    self.handle = null;
}

WGPUShaderModule _gpu_module(*Gpu g, string wgsl) {
    WGPUShaderSourceWGSL src = WGPUShaderSourceWGSL{chain: WGPUChainedStruct{null, WGPUSType_ShaderSourceWGSL}, code: gpu_str(wgsl)};
    WGPUShaderModuleDescriptor md = WGPUShaderModuleDescriptor{nextInChain: (*WGPUChainedStruct)&src};
    return wgpuDeviceCreateShaderModule(g.device, &md);
}

// A compute kernel: the function entry of the WGSL source, with the layout
// of its bind group 0 taken from the shader.
Result<GpuKernel, string> Gpu_kernel(*Gpu self, string wgsl, string entry) {
    GpuKernel k;
    k.gpu = *self;
    _gpu_push(self);
    k.module = _gpu_module(self, wgsl);
    string err = _gpu_pop(self, "shader");
    if (err != null) {
        GpuKernel_release(&k);
        return Err<GpuKernel, string>(err);
    }
    _gpu_push(self);
    WGPUComputePipelineDescriptor pd = WGPUComputePipelineDescriptor{compute: WGPUComputeState{module: k.module, entryPoint: gpu_str(entry)}};
    k.pipeline = wgpuDeviceCreateComputePipeline(self.device, &pd);
    if (k.pipeline != null) k.layout = wgpuComputePipelineGetBindGroupLayout(k.pipeline, 0);
    err = _gpu_pop(self, "pipeline");
    if (err != null) {
        GpuKernel_release(&k);
        return Err<GpuKernel, string>(err);
    }
    return Ok<GpuKernel, string>(k);
}

// Binds the whole of b to @binding(binding) of group 0, for the next dispatches.
void GpuKernel_bind(*GpuKernel self, uint32 binding, *GpuBuffer b) {
    WGPUBindGroupEntry e = WGPUBindGroupEntry{binding: binding, buffer: b.handle, size: b.size};
    for (i in 0..self.entries.size) {
        if (self.entries.data[i].binding == binding) {
            self.entries.data[i] = e;
            return;
        }
    }
    List_push(&self.entries, e);
}

// Runs x * y * z workgroups. The work runs on the GPU after the call returns;
// read() and wait() wait for it.
Result<int, string> GpuKernel_dispatch(*GpuKernel self, uint32 x, uint32 y, uint32 z) {
    *Gpu g = &self.gpu;
    _gpu_push(g);
    WGPUBindGroupDescriptor bd = WGPUBindGroupDescriptor{layout: self.layout, entryCount: (uint64)self.entries.size, entries: self.entries.data};
    WGPUBindGroup group = wgpuDeviceCreateBindGroup(g.device, &bd);
    WGPUCommandEncoder enc = wgpuDeviceCreateCommandEncoder(g.device, null);
    WGPUComputePassEncoder pass = wgpuCommandEncoderBeginComputePass(enc, null);
    wgpuComputePassEncoderSetPipeline(pass, self.pipeline);
    wgpuComputePassEncoderSetBindGroup(pass, 0, group, 0, null);
    wgpuComputePassEncoderDispatchWorkgroups(pass, x, y, z);
    wgpuComputePassEncoderEnd(pass);
    WGPUCommandBuffer cmd = wgpuCommandEncoderFinish(enc, null);
    wgpuQueueSubmit(g.queue, 1, &cmd);
    wgpuCommandBufferRelease(cmd);
    wgpuComputePassEncoderRelease(pass);
    wgpuCommandEncoderRelease(enc);
    if (group != null) wgpuBindGroupRelease(group);
    string err = _gpu_pop(g, "dispatch");
    if (err != null) return Err<int, string>(err);
    return Ok<int, string>(0);
}

// Releases the pipeline, its layout and shader module, and the list of bindings (not the
// bound buffers).
void GpuKernel_release(*GpuKernel self) {
    if (self.layout != null) wgpuBindGroupLayoutRelease(self.layout);
    if (self.pipeline != null) wgpuComputePipelineRelease(self.pipeline);
    if (self.module != null) wgpuShaderModuleRelease(self.module);
    List_free(&self.entries);
    self.layout = null;
    self.pipeline = null;
    self.module = null;
}
