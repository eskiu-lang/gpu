// math.esk: 4x4 matrices for shaders (column-major, as WGSL's mat4x4<f32>),
// with WebGPU's clip space (depth from 0 to 1).

import <libc>;

struct Mat4 {
    float[16] m;
}

struct Vec3 {
    float x;
    float y;
    float z;
}

Mat4 mat4_identity() {
    Mat4 r;
    r.m[0] = 1.0;
    r.m[5] = 1.0;
    r.m[10] = 1.0;
    r.m[15] = 1.0;
    return r;
}

// self * b: b is applied first.
Mat4 Mat4_mul(*Mat4 self, *Mat4 b) {
    Mat4 r;
    for (c in 0..4) {
        for (row in 0..4) {
            float s = 0.0;
            for (k in 0..4) s += self.m[k * 4 + row] * b.m[c * 4 + k];
            r.m[c * 4 + row] = s;
        }
    }
    return r;
}

// A right-handed perspective projection; fovy in radians.
Mat4 mat4_perspective(float fovy, float aspect, float near, float far) {
    float f = (float)(1.0 / tan((double)fovy / 2.0));
    Mat4 r;
    r.m[0] = f / aspect;
    r.m[5] = f;
    r.m[10] = far / (near - far);
    r.m[11] = -1.0;
    r.m[14] = near * far / (near - far);
    return r;
}

Vec3 _v3_sub(Vec3 a, Vec3 b) {
    return Vec3{a.x - b.x, a.y - b.y, a.z - b.z};
}

Vec3 _v3_cross(Vec3 a, Vec3 b) {
    return Vec3{a.y * b.z - a.z * b.y, a.z * b.x - a.x * b.z, a.x * b.y - a.y * b.x};
}

float _v3_dot(Vec3 a, Vec3 b) {
    return a.x * b.x + a.y * b.y + a.z * b.z;
}

Vec3 _v3_norm(Vec3 a) {
    float l = (float)sqrt((double)_v3_dot(a, a));
    return Vec3{a.x / l, a.y / l, a.z / l};
}

// A view matrix for a camera at eye looking at target.
Mat4 mat4_look_at(Vec3 eye, Vec3 target, Vec3 up) {
    Vec3 f = _v3_norm(_v3_sub(target, eye));
    Vec3 s = _v3_norm(_v3_cross(f, up));
    Vec3 u = _v3_cross(s, f);
    Mat4 r = mat4_identity();
    r.m[0] = s.x;
    r.m[4] = s.y;
    r.m[8] = s.z;
    r.m[1] = u.x;
    r.m[5] = u.y;
    r.m[9] = u.z;
    r.m[2] = -f.x;
    r.m[6] = -f.y;
    r.m[10] = -f.z;
    r.m[12] = -_v3_dot(s, eye);
    r.m[13] = -_v3_dot(u, eye);
    r.m[14] = _v3_dot(f, eye);
    return r;
}

// A rotation of angle radians around a unit axis.
Mat4 mat4_rotate(float angle, Vec3 axis) {
    float c = (float)cos((double)angle);
    float s = (float)sin((double)angle);
    float t = 1.0 - c;
    Vec3 a = _v3_norm(axis);
    Mat4 r = mat4_identity();
    r.m[0] = t * a.x * a.x + c;
    r.m[1] = t * a.x * a.y + s * a.z;
    r.m[2] = t * a.x * a.z - s * a.y;
    r.m[4] = t * a.x * a.y - s * a.z;
    r.m[5] = t * a.y * a.y + c;
    r.m[6] = t * a.y * a.z + s * a.x;
    r.m[8] = t * a.x * a.z + s * a.y;
    r.m[9] = t * a.y * a.z - s * a.x;
    r.m[10] = t * a.z * a.z + c;
    return r;
}

Mat4 mat4_translate(float x, float y, float z) {
    Mat4 r = mat4_identity();
    r.m[12] = x;
    r.m[13] = y;
    r.m[14] = z;
    return r;
}
