// render.esk: textures, render pipelines, passes and window surfaces
// (imported by <gpu>).
//
// A frame is a pass over a target view: a texture's (GpuTexture.view) or a
// window surface's (GpuFrame.view, from GpuSurface_frame):
//
//     GpuPass pass = gpu.pass(frame.view, GpuColor{0.1, 0.1, 0.1, 1.0}, &depth);
//     pass.draw(&pipeline, &vertices, 3, 1);
//     pass.end()?;
//     surface.present(&frame);
//
// Bindings set on a pipeline with bind(), bind_texture() and bind_sampler()
// apply to group 0 of its shaders; the bind group they make is kept by the
// pipeline and reused until a binding changes. For several groups, or groups
// shared by pipelines, describe each with a GpuBindLayout, list them in
// GpuPipelineDesc.groups, and set GpuBindGroups on the pass:
//
//     GpuBindLayout scene = gpu.bind_layout();
//     scene.uniform(0, WGPUShaderStage_Vertex);
//     GpuBindGroup sg = scene.group()?;
//     sg.buffer(0, &camera);
//     pass.set_group(0, &sg);
//
// Several passes go into one submission through a GpuEncoder:
//
//     GpuEncoder enc = gpu.encoder();
//     GpuPass scene = enc.pass(frame.view, clear, &depth);
//     ...
//     scene.end()?;
//     GpuPassOptions keep = GpuPassOptions{load: true};
//     GpuPass ui = enc.pass_with(frame.view, &keep);
//     ...
//     ui.end()?;
//     enc.submit()?;

import <io>;
import <mem>;
import <string>;
import <list>;
import <result>;
import <gpu/raw>;
import <gpu/core>;
import <libc>;

type GpuColor = WGPUColor;

struct GpuTexture {
    Gpu gpu;
    WGPUTexture handle;
    WGPUTextureView view;
    WGPUTextureFormat format;
    uint32 width;
    uint32 height;
    uint32 mips;
}

// How Gpu_image_with stores the pixels: srgb for color data (photos, base
// color and emissive maps; the GPU converts to linear when sampling), mipmaps
// to add the smaller levels that keep a texture smooth at a distance.
struct GpuImageOptions {
    bool srgb;
    bool mipmaps;
}

// A sampler's settings. The zero value is linear filtering that repeats the
// texture. wrap_u and wrap_v take WGPUAddressMode values (Repeat,
// MirrorRepeat, ClampToEdge); anisotropy above 1 needs linear filtering.
struct GpuSamplerOptions {
    bool nearest;
    bool mipmaps;
    WGPUAddressMode wrap_u;
    WGPUAddressMode wrap_v;
    uint16 anisotropy;
}

struct GpuSampler {
    WGPUSampler handle;
}

// The layout of one vertex buffer of a pipeline: one attribute per shader
// @location, numbered in the order they are added from location (0 by
// default). step is WGPUVertexStepMode_Instance for a buffer read once per
// instance; the zero value reads it once per vertex.
struct GpuVertexLayout {
    uint64 stride;
    List<WGPUVertexAttribute> attrs;
    WGPUVertexStepMode step;
    uint32 location;
}

// How a pipeline blends its output with the target. NONE replaces the
// target; ALPHA is source over (straight alpha), PREMULTIPLIED the same for
// premultiplied colors, ADDITIVE adds the color scaled by its alpha, MULTIPLY
// multiplies the target by the color, and CONSTANT mixes the source and the
// target by the pass's blend constant (GpuPass_set_blend_constant): 1.0 is
// all source, 0.0 keeps the target.
enum GpuBlend {
    GPU_BLEND_NONE,
    GPU_BLEND_ALPHA,
    GPU_BLEND_PREMULTIPLIED,
    GPU_BLEND_ADDITIVE,
    GPU_BLEND_MULTIPLY,
    GPU_BLEND_CONSTANT
}

// A render pipeline's description. The zero value of each field is the
// common case:
// - layout is the one vertex buffer; layouts and layout_count list several
//   (up to 8, bound with GpuPass_set_vertices; layouts wins when both are set).
// - groups and group_count list the bind group layouts, one per @group index;
//   without them the pipeline takes its layout from the shader and binds group
//   0 with bind(), bind_texture() and bind_sampler().
// - blend: true is GPU_BLEND_ALPHA; blend_mode picks a preset and blend_state,
//   when not null, is any WGPUBlendState. no_color_write leaves the color
//   target untouched (a depth-only draw).
// - depth turns on the depth test against a depth_format texture (default
//   Depth24Plus, also Depth32Float) with depth_compare (default Less);
//   depth_read_only turns depth writes off. depth_bias and depth_bias_slope
//   offset the depth written.
struct GpuPipelineDesc {
    string wgsl;
    string vertex;
    string fragment;
    WGPUTextureFormat format;
    *GpuVertexLayout layout;
    bool depth;
    bool depth_read_only;
    bool blend;
    WGPUPrimitiveTopology topology;
    WGPUCullMode cull;
    *GpuVertexLayout layouts;
    uint32 layout_count;
    **GpuBindLayout groups;
    uint32 group_count;
    GpuBlend blend_mode;
    *WGPUBlendState blend_state;
    bool no_color_write;
    WGPUTextureFormat depth_format;
    WGPUCompareFunction depth_compare;
    int32 depth_bias;
    float depth_bias_slope;
}

struct GpuPipeline {
    Gpu gpu;
    WGPUShaderModule module;
    WGPURenderPipeline handle;
    WGPUBindGroupLayout layout;
    List<WGPUBindGroupEntry> entries;
    WGPUPipelineLayout pipeline_layout;
    WGPUBindGroup group;
    bool group_stale;
}

// The bindings of one @group, shared by the pipelines and bind groups made
// from it. Add every entry before the first pipeline or group uses it.
// visibility is a set of WGPUShaderStage bits (0 is vertex and fragment).
struct GpuBindLayout {
    Gpu gpu;
    WGPUBindGroupLayout handle;
    List<WGPUBindGroupLayoutEntry> entries;
}

// Resources for the bindings of a GpuBindLayout, set on a pass with
// GpuPass_set_group. The WebGPU bind group is made on first use and kept until
// a binding changes, so a group set every frame costs nothing to rebuild.
struct GpuBindGroup {
    Gpu gpu;
    WGPUBindGroupLayout layout;
    List<WGPUBindGroupEntry> entries;
    WGPUBindGroup handle;
    bool stale;
}

// A command encoder that passes are opened from (GpuEncoder_pass), sent to
// the GPU in one submission by GpuEncoder_submit.
struct GpuEncoder {
    Gpu gpu;
    WGPUCommandEncoder enc;
    List<WGPUBindGroup> groups;
}

// A pass's attachments: the color target is cleared to clear, or keeps its
// pixels with load; the depth texture, when given, is cleared to 1.0, or keeps
// its values with depth_load.
struct GpuPassOptions {
    GpuColor clear;
    bool load;
    *GpuTexture depth;
    bool depth_load;
}

struct GpuPass {
    Gpu gpu;
    WGPUCommandEncoder enc;
    WGPURenderPassEncoder pass;
    List<WGPUBindGroup> groups;
    *GpuEncoder encoder;
}

// A texture copy on its way back from the GPU (GpuTexture_read_async).
struct GpuReadback {
    Gpu gpu;
    WGPUBuffer staging;
    *_GpuWait wait;
    uint32 width;
    uint32 height;
    uint32 row;
    uint32 padded;
}

struct GpuSurface {
    Gpu gpu;
    WGPUSurface handle;
    WGPUTextureFormat format;
    uint32 width;
    uint32 height;
}

struct GpuFrame {
    WGPUTexture texture;
    WGPUTextureView view;
}

Result<GpuBuffer, string> Gpu_vertices(*Gpu self, *void data, uint64 bytes) {
    GpuBuffer b = Gpu_buffer(self, bytes, WGPUBufferUsage_Vertex | WGPUBufferUsage_CopyDst)?;
    GpuBuffer_write(&b, 0, data, bytes);
    return Ok<GpuBuffer, string>(b);
}

// An index buffer of uint32 indices.
Result<GpuBuffer, string> Gpu_indices(*Gpu self, *uint32 data, uint64 count) {
    GpuBuffer b = Gpu_buffer(self, count * 4, WGPUBufferUsage_Index | WGPUBufferUsage_CopyDst)?;
    GpuBuffer_write(&b, 0, data, count * 4);
    return Ok<GpuBuffer, string>(b);
}

// A uniform buffer of bytes bytes, updated with write().
Result<GpuBuffer, string> Gpu_uniform(*Gpu self, *void data, uint64 bytes) {
    GpuBuffer b = Gpu_buffer(self, bytes, WGPUBufferUsage_Uniform | WGPUBufferUsage_CopyDst)?;
    if (data != null) GpuBuffer_write(&b, 0, data, bytes);
    return Ok<GpuBuffer, string>(b);
}

Result<GpuTexture, string> Gpu_texture(*Gpu self, uint32 width, uint32 height, WGPUTextureFormat format, WGPUTextureUsage usage) {
    return _gpu_texture(self, width, height, format, usage, 1);
}

Result<GpuTexture, string> _gpu_texture(*Gpu self, uint32 width, uint32 height, WGPUTextureFormat format, WGPUTextureUsage usage, uint32 mips) {
    _gpu_push(self);
    WGPUTextureDescriptor d = WGPUTextureDescriptor{usage: usage, dimension: WGPUTextureDimension_2D,
        size: WGPUExtent3D{width, height, 1}, format: format, mipLevelCount: mips, sampleCount: 1};
    WGPUTexture t = wgpuDeviceCreateTexture(self.device, &d);
    WGPUTextureView v = null;
    if (t != null) v = wgpuTextureCreateView(t, null);
    string err = _gpu_pop(self, "texture");
    GpuTexture tex = GpuTexture{*self, t, v, format, width, height, mips};
    if (err != null || t == null) {
        GpuTexture_release(&tex);
        return Err<GpuTexture, string>(err != null ? err : _gpu_fail("texture", null));
    }
    return Ok<GpuTexture, string>(tex);
}

// An RGBA8 texture to render into, sample in a later pass and read back.
Result<GpuTexture, string> Gpu_target(*Gpu self, uint32 width, uint32 height) {
    return Gpu_target_with(self, width, height, WGPUTextureFormat_RGBA8Unorm);
}

// Gpu_target in another format (RGBA8UnormSrgb, BGRA8Unorm, RGBA16Float...).
Result<GpuTexture, string> Gpu_target_with(*Gpu self, uint32 width, uint32 height, WGPUTextureFormat format) {
    return Gpu_texture(self, width, height, format,
        WGPUTextureUsage_RenderAttachment | WGPUTextureUsage_CopySrc | WGPUTextureUsage_TextureBinding);
}

// Bytes per texel of the color formats the texture calls copy (4 for the
// formats not listed).
uint32 _gpu_texel_bytes(WGPUTextureFormat f) {
    if (f == WGPUTextureFormat_R8Unorm) return 1;
    if (f == WGPUTextureFormat_RG8Unorm || f == WGPUTextureFormat_R16Float) return 2;
    if (f == WGPUTextureFormat_RGBA16Float || f == WGPUTextureFormat_RG32Float) return 8;
    if (f == WGPUTextureFormat_RGBA32Float) return 16;
    return 4;
}

// An RGBA8 texture for shaders to sample, filled from width * height pixels
// of 4 bytes each.
Result<GpuTexture, string> Gpu_image(*Gpu self, uint32 width, uint32 height, *void rgba) {
    return Gpu_image_with(self, width, height, rgba, null);
}

// Gpu_image with options (null for the defaults: linear, no mipmaps).
Result<GpuTexture, string> Gpu_image_with(*Gpu self, uint32 width, uint32 height, *void rgba, *GpuImageOptions opts) {
    bool srgb = opts != null && opts.srgb;
    bool mipmaps = opts != null && opts.mipmaps;
    uint32 mips = 1;
    if (mipmaps) {
        uint32 m = width > height ? width : height;
        while (m > 1) {
            m = m / 2;
            mips++;
        }
    }
    WGPUTextureFormat format = srgb ? WGPUTextureFormat_RGBA8UnormSrgb : WGPUTextureFormat_RGBA8Unorm;
    GpuTexture t = _gpu_texture(self, width, height, format, WGPUTextureUsage_TextureBinding | WGPUTextureUsage_CopyDst, mips)?;
    GpuTexture_write(&t, rgba);
    if (mips > 1) _gpu_write_mips(&t, (*uint8)rgba, srgb);
    return Ok<GpuTexture, string>(t);
}

float[256] _gpu_srgb_lin;
uint8[4096] _gpu_lin_srgb;
bool _gpu_srgb_ready = false;

void _gpu_srgb_tables() {
    if (_gpu_srgb_ready) return;
    for (i in 0..256) {
        double c = (double)i / 255.0;
        _gpu_srgb_lin[i] = (float)(c <= 0.04045 ? c / 12.92 : pow((c + 0.055) / 1.055, 2.4));
    }
    for (i in 0..4096) {
        double l = (double)i / 4095.0;
        double c = l <= 0.0031308 ? l * 12.92 : 1.055 * pow(l, 1.0 / 2.4) - 0.055;
        _gpu_lin_srgb[i] = (uint8)(c * 255.0 + 0.5);
    }
    _gpu_srgb_ready = true;
}

// Halves an RGBA8 image with a 2x2 box filter; with srgb, the color channels
// are averaged in linear light.
void _gpu_halve(*uint8 src, uint32 w, uint32 h, *uint8 dst, uint32 dw, uint32 dh, bool srgb) {
    for (y in 0..dh) {
        uint32 y0 = y * 2 < h ? y * 2 : h - 1;
        uint32 y1 = y * 2 + 1 < h ? y * 2 + 1 : h - 1;
        for (x in 0..dw) {
            uint32 x0 = x * 2 < w ? x * 2 : w - 1;
            uint32 x1 = x * 2 + 1 < w ? x * 2 + 1 : w - 1;
            *uint8 a = src + ((uint64)y0 * w + x0) * 4;
            *uint8 b = src + ((uint64)y0 * w + x1) * 4;
            *uint8 c = src + ((uint64)y1 * w + x0) * 4;
            *uint8 d = src + ((uint64)y1 * w + x1) * 4;
            *uint8 o = dst + ((uint64)y * dw + x) * 4;
            for (k in 0..4) {
                if (srgb && k < 3) {
                    float l = (_gpu_srgb_lin[(int)a[k]] + _gpu_srgb_lin[(int)b[k]] + _gpu_srgb_lin[(int)c[k]] + _gpu_srgb_lin[(int)d[k]]) * 0.25;
                    o[k] = _gpu_lin_srgb[(int)(l * 4095.0 + 0.5)];
                } else {
                    o[k] = (uint8)(((uint32)a[k] + b[k] + c[k] + d[k] + 2) / 4);
                }
            }
        }
    }
}

void _gpu_write_mips(*GpuTexture t, *uint8 rgba, bool srgb) {
    if (srgb) _gpu_srgb_tables();
    uint32 w = t.width;
    uint32 h = t.height;
    *uint8 prev = rgba;
    *uint8 owned = null;
    for (level in 1..t.mips) {
        uint32 dw = w > 1 ? w / 2 : 1;
        uint32 dh = h > 1 ? h / 2 : 1;
        *uint8 next = alloc<uint8>((int)(dw * dh * 4));
        _gpu_halve(prev, w, h, next, dw, dh, srgb);
        WGPUTexelCopyTextureInfo dst = WGPUTexelCopyTextureInfo{texture: t.handle, mipLevel: level, aspect: WGPUTextureAspect_All};
        WGPUTexelCopyBufferLayout layout = WGPUTexelCopyBufferLayout{0, dw * 4, dh};
        WGPUExtent3D size = WGPUExtent3D{dw, dh, 1};
        wgpuQueueWriteTexture(t.gpu.queue, &dst, next, (uint64)dw * dh * 4, &layout, &size);
        if (owned != null) free(owned);
        owned = next;
        prev = next;
        w = dw;
        h = dh;
    }
    if (owned != null) free(owned);
}

Result<GpuTexture, string> Gpu_depth(*Gpu self, uint32 width, uint32 height) {
    return Gpu_texture(self, width, height, WGPUTextureFormat_Depth24Plus, WGPUTextureUsage_RenderAttachment);
}

// Replaces the texture's pixels (4 bytes each, rows packed).
void GpuTexture_write(*GpuTexture self, *void rgba) {
    WGPUTexelCopyTextureInfo dst = WGPUTexelCopyTextureInfo{texture: self.handle, aspect: WGPUTextureAspect_All};
    WGPUTexelCopyBufferLayout layout = WGPUTexelCopyBufferLayout{0, self.width * 4, self.height};
    WGPUExtent3D size = WGPUExtent3D{self.width, self.height, 1};
    wgpuQueueWriteTexture(self.gpu.queue, &dst, rgba, (uint64)self.width * self.height * 4, &layout, &size);
}

// Replaces a width x height rectangle of the texture's pixels at (x, y),
// from rows packed at the texture format's texel size (4 bytes for RGBA8):
// an atlas update or a scrolling tile layer.
void GpuTexture_write_region(*GpuTexture self, uint32 x, uint32 y, uint32 width, uint32 height, *void pixels) {
    uint32 texel = _gpu_texel_bytes(self.format);
    WGPUTexelCopyTextureInfo dst = WGPUTexelCopyTextureInfo{texture: self.handle, origin: WGPUOrigin3D{x, y, 0}, aspect: WGPUTextureAspect_All};
    WGPUTexelCopyBufferLayout layout = WGPUTexelCopyBufferLayout{0, width * texel, height};
    WGPUExtent3D size = WGPUExtent3D{width, height, 1};
    wgpuQueueWriteTexture(self.gpu.queue, &dst, pixels, (uint64)width * height * texel, &layout, &size);
}

// Records a copy of the texture into a new MapRead buffer with rows padded
// to 256 bytes, and submits it.
Result<GpuReadback, string> _gpu_read_start(*GpuTexture self) {
    *Gpu g = &self.gpu;
    GpuReadback rb;
    rb.gpu = *g;
    rb.width = self.width;
    rb.height = self.height;
    rb.row = self.width * _gpu_texel_bytes(self.format);
    rb.padded = (rb.row + 255) / 256 * 256;
    GpuBuffer staging = Gpu_buffer(g, (uint64)rb.padded * self.height, WGPUBufferUsage_MapRead | WGPUBufferUsage_CopyDst)?;
    rb.staging = staging.handle;
    _gpu_push(g);
    WGPUCommandEncoder enc = wgpuDeviceCreateCommandEncoder(g.device, null);
    WGPUTexelCopyTextureInfo src = WGPUTexelCopyTextureInfo{texture: self.handle, aspect: WGPUTextureAspect_All};
    WGPUTexelCopyBufferInfo dst = WGPUTexelCopyBufferInfo{WGPUTexelCopyBufferLayout{0, rb.padded, self.height}, rb.staging};
    WGPUExtent3D size = WGPUExtent3D{self.width, self.height, 1};
    wgpuCommandEncoderCopyTextureToBuffer(enc, &src, &dst, &size);
    WGPUCommandBuffer cmd = wgpuCommandEncoderFinish(enc, null);
    wgpuQueueSubmit(g.queue, 1, &cmd);
    wgpuCommandBufferRelease(cmd);
    wgpuCommandEncoderRelease(enc);
    string err = _gpu_pop(g, "read");
    if (err != null) {
        wgpuBufferRelease(rb.staging);
        return Err<GpuReadback, string>(err);
    }
    rb.wait = alloc<_GpuWait>(1);
    WGPUBufferMapCallbackInfo mi = WGPUBufferMapCallbackInfo{mode: WGPUCallbackMode_AllowSpontaneous, callback: (*void)_gpu_on_map, userdata1: rb.wait};
    wgpuBufferMapAsync(rb.staging, WGPUMapMode_Read, 0, (uint64)rb.padded * rb.height, mi);
    return Ok<GpuReadback, string>(rb);
}

// Copies the texture's pixels (rows packed) to out, after the work submitted
// so far has finished.
Result<int, string> GpuTexture_read(*GpuTexture self, *void out) {
    GpuReadback rb = _gpu_read_start(self)?;
    defer GpuReadback_release(&rb);
    return GpuReadback_take(&rb, out);
}

// Starts copying the texture's pixels back without waiting for the GPU: after
// the frame's submission, take the pixels once ready() says so (or call take(),
// which waits), then release the readback.
//
//     GpuReadback rb = target.read_async()?;
//     ...later frames:
//     if (rb.ready()) { rb.take(pixels)?; rb.release(); }
Result<GpuReadback, string> GpuTexture_read_async(*GpuTexture self) {
    return _gpu_read_start(self);
}

// Whether the pixels have arrived; it checks without blocking.
bool GpuReadback_ready(*GpuReadback self) {
    if (self.wait == null) return false;
    if (self.wait.done == 0) wgpuDevicePoll(self.gpu.device, 0, null);
    return self.wait.done != 0;
}

// Copies the pixels (rows packed) to out, waiting for them if needed; once.
Result<int, string> GpuReadback_take(*GpuReadback self, *void out) {
    if (self.wait == null || self.staging == null) return Err<int, string>(_gpu_fail("read: no readback, or already taken", null));
    _gpu_wait(&self.gpu, self.wait);
    if (self.wait.done == 0 || self.wait.status != WGPUMapAsyncStatus_Success) return Err<int, string>(_gpu_fail("read", &self.wait.msg));
    uint64 bytes = (uint64)self.padded * self.height;
    *uint8 rows = (*uint8)wgpuBufferGetConstMappedRange(self.staging, 0, bytes);
    for (y in 0..self.height) {
        memcpy((*uint8)out + (uint64)y * self.row, rows + (uint64)y * self.padded, (int64)self.row);
    }
    wgpuBufferUnmap(self.staging);
    wgpuBufferRelease(self.staging);
    self.staging = null;
    return Ok<int, string>(0);
}

void GpuReadback_release(*GpuReadback self) {
    if (self.wait != null) {
        _gpu_wait(&self.gpu, self.wait);
        String_free(&self.wait.msg);
        free(self.wait);
    }
    if (self.staging != null) wgpuBufferRelease(self.staging);
    self.wait = null;
    self.staging = null;
}

void GpuTexture_release(*GpuTexture self) {
    if (self.view != null) wgpuTextureViewRelease(self.view);
    if (self.handle != null) wgpuTextureRelease(self.handle);
    self.view = null;
    self.handle = null;
}

// A sampler that repeats the texture; linear filtering when linear is true,
// nearest otherwise. Gpu_sampler_with takes the other settings.
Result<GpuSampler, string> Gpu_sampler(*Gpu self, bool linear) {
    GpuSamplerOptions o = GpuSamplerOptions{nearest: !linear};
    return Gpu_sampler_with(self, &o);
}

Result<GpuSampler, string> Gpu_sampler_with(*Gpu self, *GpuSamplerOptions o) {
    WGPUFilterMode f = o.nearest ? WGPUFilterMode_Nearest : WGPUFilterMode_Linear;
    WGPUAddressMode u = o.wrap_u != 0 ? o.wrap_u : WGPUAddressMode_Repeat;
    WGPUAddressMode v = o.wrap_v != 0 ? o.wrap_v : WGPUAddressMode_Repeat;
    uint16 aniso = o.anisotropy > 1 && !o.nearest && o.mipmaps ? o.anisotropy : (uint16)1;
    _gpu_push(self);
    WGPUSamplerDescriptor d = WGPUSamplerDescriptor{addressModeU: u, addressModeV: v,
        addressModeW: WGPUAddressMode_Repeat, magFilter: f, minFilter: f,
        mipmapFilter: o.mipmaps && !o.nearest ? WGPUMipmapFilterMode_Linear : WGPUMipmapFilterMode_Nearest,
        lodMinClamp: 0.0, lodMaxClamp: 32.0, maxAnisotropy: aniso};
    WGPUSampler s = wgpuDeviceCreateSampler(self.device, &d);
    string err = _gpu_pop(self, "sampler");
    if (err != null) return Err<GpuSampler, string>(err);
    return Ok<GpuSampler, string>(GpuSampler{s});
}

void GpuSampler_release(*GpuSampler self) {
    if (self.handle != null) wgpuSamplerRelease(self.handle);
    self.handle = null;
}

void GpuVertexLayout_add(*GpuVertexLayout self, WGPUVertexFormat format, uint64 offset) {
    List_push(&self.attrs, WGPUVertexAttribute{format: format, offset: offset, shaderLocation: self.location + (uint32)self.attrs.size});
}

void GpuVertexLayout_release(*GpuVertexLayout self) {
    List_free(&self.attrs);
}

WGPUBlendState _gpu_blend_state(GpuBlend mode) {
    WGPUBlendComponent over = WGPUBlendComponent{WGPUBlendOperation_Add, WGPUBlendFactor_One, WGPUBlendFactor_OneMinusSrcAlpha};
    if (mode == GPU_BLEND_PREMULTIPLIED) return WGPUBlendState{over, over};
    if (mode == GPU_BLEND_ADDITIVE) {
        return WGPUBlendState{WGPUBlendComponent{WGPUBlendOperation_Add, WGPUBlendFactor_SrcAlpha, WGPUBlendFactor_One},
            WGPUBlendComponent{WGPUBlendOperation_Add, WGPUBlendFactor_Zero, WGPUBlendFactor_One}};
    }
    if (mode == GPU_BLEND_MULTIPLY) {
        return WGPUBlendState{WGPUBlendComponent{WGPUBlendOperation_Add, WGPUBlendFactor_Dst, WGPUBlendFactor_Zero},
            WGPUBlendComponent{WGPUBlendOperation_Add, WGPUBlendFactor_Zero, WGPUBlendFactor_One}};
    }
    if (mode == GPU_BLEND_CONSTANT) {
        WGPUBlendComponent mix = WGPUBlendComponent{WGPUBlendOperation_Add, WGPUBlendFactor_Constant, WGPUBlendFactor_OneMinusConstant};
        return WGPUBlendState{mix, mix};
    }
    return WGPUBlendState{WGPUBlendComponent{WGPUBlendOperation_Add, WGPUBlendFactor_SrcAlpha, WGPUBlendFactor_OneMinusSrcAlpha}, over};
}

Result<GpuPipeline, string> Gpu_pipeline(*Gpu self, *GpuPipelineDesc d) {
    GpuPipeline p;
    p.gpu = *self;
    _gpu_push(self);
    p.module = _gpu_module(self, d.wgsl);
    string err = _gpu_pop(self, "shader");
    if (err != null) {
        GpuPipeline_release(&p);
        return Err<GpuPipeline, string>(err);
    }
    *GpuVertexLayout vls = d.layout_count > 0 ? d.layouts : d.layout;
    uint32 nbuf = d.layout_count > 0 ? d.layout_count : (d.layout != null ? (uint32)1 : (uint32)0);
    if (nbuf > 8) {
        GpuPipeline_release(&p);
        return Err<GpuPipeline, string>(_gpu_fail("pipeline: more than 8 vertex buffers", null));
    }
    WGPUVertexBufferLayout[8] vb;
    for (i in 0..nbuf) {
        vb[i] = WGPUVertexBufferLayout{stepMode: vls[i].step != 0 ? vls[i].step : WGPUVertexStepMode_Vertex, arrayStride: vls[i].stride,
            attributeCount: (uint64)vls[i].attrs.size, attributes: vls[i].attrs.data};
    }
    if (d.group_count > 0) {
        WGPUBindGroupLayout[8] bgl;
        if (d.group_count > 8) {
            GpuPipeline_release(&p);
            return Err<GpuPipeline, string>(_gpu_fail("pipeline: more than 8 bind groups", null));
        }
        for (i in 0..d.group_count) {
            Result<int, string> made = _gpu_bind_layout_make(d.groups[i]);
            if (!made.ok) {
                GpuPipeline_release(&p);
                return Err<GpuPipeline, string>(made.error);
            }
            bgl[i] = d.groups[i].handle;
        }
        _gpu_push(self);
        WGPUPipelineLayoutDescriptor pld = WGPUPipelineLayoutDescriptor{bindGroupLayoutCount: (uint64)d.group_count, bindGroupLayouts: &bgl[0]};
        p.pipeline_layout = wgpuDeviceCreatePipelineLayout(self.device, &pld);
        err = _gpu_pop(self, "pipeline layout");
        if (err != null) {
            GpuPipeline_release(&p);
            return Err<GpuPipeline, string>(err);
        }
    }
    GpuBlend mode = d.blend_mode;
    if (mode == GPU_BLEND_NONE && d.blend) mode = GPU_BLEND_ALPHA;
    WGPUBlendState blend = _gpu_blend_state(mode);
    WGPUColorTargetState target = WGPUColorTargetState{format: d.format, writeMask: d.no_color_write ? WGPUColorWriteMask_None : WGPUColorWriteMask_All};
    if (d.blend_state != null) target.blend = d.blend_state;
    else if (mode != GPU_BLEND_NONE) target.blend = &blend;
    WGPUFragmentState frag = WGPUFragmentState{module: p.module, entryPoint: gpu_str(d.fragment), targetCount: 1, targets: &target};
    WGPUDepthStencilState ds = WGPUDepthStencilState{format: d.depth_format != 0 ? d.depth_format : WGPUTextureFormat_Depth24Plus,
        depthWriteEnabled: d.depth_read_only ? WGPUOptionalBool_False : WGPUOptionalBool_True,
        depthCompare: d.depth_compare != 0 ? d.depth_compare : WGPUCompareFunction_Less,
        stencilFront: WGPUStencilFaceState{WGPUCompareFunction_Always, WGPUStencilOperation_Keep, WGPUStencilOperation_Keep, WGPUStencilOperation_Keep},
        stencilBack: WGPUStencilFaceState{WGPUCompareFunction_Always, WGPUStencilOperation_Keep, WGPUStencilOperation_Keep, WGPUStencilOperation_Keep},
        stencilReadMask: 0xFFFFFFFF, stencilWriteMask: 0xFFFFFFFF, depthBias: d.depth_bias, depthBiasSlopeScale: d.depth_bias_slope};
    WGPURenderPipelineDescriptor rd = WGPURenderPipelineDescriptor{layout: p.pipeline_layout,
        vertex: WGPUVertexState{module: p.module, entryPoint: gpu_str(d.vertex), bufferCount: (uint64)nbuf, buffers: &vb[0]},
        primitive: WGPUPrimitiveState{topology: d.topology != 0 ? d.topology : WGPUPrimitiveTopology_TriangleList,
            frontFace: WGPUFrontFace_CCW, cullMode: d.cull != 0 ? d.cull : WGPUCullMode_None},
        multisample: WGPUMultisampleState{count: 1, mask: 0xFFFFFFFF},
        fragment: &frag};
    if (d.depth) rd.depthStencil = &ds;
    _gpu_push(self);
    p.handle = wgpuDeviceCreateRenderPipeline(self.device, &rd);
    err = _gpu_pop(self, "pipeline");
    if (err != null) {
        GpuPipeline_release(&p);
        return Err<GpuPipeline, string>(err);
    }
    return Ok<GpuPipeline, string>(p);
}

// Sets entry e.binding in entries, replacing an entry of the same binding.
void _gpu_set_entry(List<WGPUBindGroupEntry>* entries, WGPUBindGroupEntry e) {
    for (i in 0..entries.size) {
        if (entries.data[i].binding == e.binding) {
            entries.data[i] = e;
            return;
        }
    }
    List_push(entries, e);
}

void _gpu_pipeline_entry(*GpuPipeline self, WGPUBindGroupEntry e) {
    if (self.layout == null) self.layout = wgpuRenderPipelineGetBindGroupLayout(self.handle, 0);
    _gpu_set_entry(&self.entries, e);
    self.group_stale = true;
}

void GpuPipeline_bind(*GpuPipeline self, uint32 binding, *GpuBuffer b) {
    _gpu_pipeline_entry(self, WGPUBindGroupEntry{binding: binding, buffer: b.handle, size: b.size});
}

void GpuPipeline_bind_texture(*GpuPipeline self, uint32 binding, *GpuTexture t) {
    _gpu_pipeline_entry(self, WGPUBindGroupEntry{binding: binding, textureView: t.view});
}

void GpuPipeline_bind_sampler(*GpuPipeline self, uint32 binding, *GpuSampler s) {
    _gpu_pipeline_entry(self, WGPUBindGroupEntry{binding: binding, sampler: s.handle});
}

void GpuPipeline_release(*GpuPipeline self) {
    if (self.group != null) wgpuBindGroupRelease(self.group);
    if (self.layout != null) wgpuBindGroupLayoutRelease(self.layout);
    if (self.handle != null) wgpuRenderPipelineRelease(self.handle);
    if (self.pipeline_layout != null) wgpuPipelineLayoutRelease(self.pipeline_layout);
    if (self.module != null) wgpuShaderModuleRelease(self.module);
    List_free(&self.entries);
    self.group = null;
    self.layout = null;
    self.handle = null;
    self.pipeline_layout = null;
    self.module = null;
}

// An empty bind group layout; add its entries, then name it in
// GpuPipelineDesc.groups and make groups from it with group().
GpuBindLayout Gpu_bind_layout(*Gpu self) {
    GpuBindLayout l;
    l.gpu = *self;
    return l;
}

WGPUShaderStage _gpu_visibility(WGPUShaderStage v) {
    return v != 0 ? v : WGPUShaderStage_Vertex | WGPUShaderStage_Fragment;
}

// A uniform buffer (var<uniform>) at binding.
void GpuBindLayout_uniform(*GpuBindLayout self, uint32 binding, WGPUShaderStage visibility) {
    List_push(&self.entries, WGPUBindGroupLayoutEntry{binding: binding, visibility: _gpu_visibility(visibility),
        buffer: WGPUBufferBindingLayout{type_: WGPUBufferBindingType_Uniform}});
}

// A storage buffer (var<storage, read> when read_only, else read_write; the
// vertex stage may only read).
void GpuBindLayout_storage(*GpuBindLayout self, uint32 binding, WGPUShaderStage visibility, bool read_only) {
    WGPUBufferBindingType t = read_only ? WGPUBufferBindingType_ReadOnlyStorage : WGPUBufferBindingType_Storage;
    List_push(&self.entries, WGPUBindGroupLayoutEntry{binding: binding, visibility: _gpu_visibility(visibility),
        buffer: WGPUBufferBindingLayout{type_: t}});
}

// A 2D texture; sample_type is a WGPUTextureSampleType (0 is Float, the
// filterable kind; UnfilterableFloat goes with a NonFiltering sampler).
void GpuBindLayout_texture(*GpuBindLayout self, uint32 binding, WGPUShaderStage visibility, WGPUTextureSampleType sample_type) {
    List_push(&self.entries, WGPUBindGroupLayoutEntry{binding: binding, visibility: _gpu_visibility(visibility),
        texture: WGPUTextureBindingLayout{sampleType: sample_type != 0 ? sample_type : WGPUTextureSampleType_Float,
            viewDimension: WGPUTextureViewDimension_2D}});
}

// A sampler; kind is a WGPUSamplerBindingType (0 is Filtering; NonFiltering
// for nearest-only samplers over unfilterable textures; Comparison).
void GpuBindLayout_sampler(*GpuBindLayout self, uint32 binding, WGPUShaderStage visibility, WGPUSamplerBindingType kind) {
    List_push(&self.entries, WGPUBindGroupLayoutEntry{binding: binding, visibility: _gpu_visibility(visibility),
        sampler: WGPUSamplerBindingLayout{type_: kind != 0 ? kind : WGPUSamplerBindingType_Filtering}});
}

// Makes the WebGPU layout the first time it is needed.
Result<int, string> _gpu_bind_layout_make(*GpuBindLayout self) {
    if (self.handle != null) return Ok<int, string>(0);
    _gpu_push(&self.gpu);
    WGPUBindGroupLayoutDescriptor d = WGPUBindGroupLayoutDescriptor{entryCount: (uint64)self.entries.size, entries: self.entries.data};
    self.handle = wgpuDeviceCreateBindGroupLayout(self.gpu.device, &d);
    string err = _gpu_pop(&self.gpu, "bind layout");
    if (err != null) {
        if (self.handle != null) wgpuBindGroupLayoutRelease(self.handle);
        self.handle = null;
        return Err<int, string>(err);
    }
    return Ok<int, string>(0);
}

// A bind group for this layout, to fill with buffer(), texture() and
// sampler(). It keeps the layout alive.
Result<GpuBindGroup, string> GpuBindLayout_group(*GpuBindLayout self) {
    _gpu_bind_layout_make(self)?;
    wgpuBindGroupLayoutAddRef(self.handle);
    GpuBindGroup g;
    g.gpu = self.gpu;
    g.layout = self.handle;
    return Ok<GpuBindGroup, string>(g);
}

void GpuBindLayout_release(*GpuBindLayout self) {
    if (self.handle != null) wgpuBindGroupLayoutRelease(self.handle);
    List_free(&self.entries);
    self.handle = null;
}

void GpuBindGroup_buffer(*GpuBindGroup self, uint32 binding, *GpuBuffer b) {
    _gpu_set_entry(&self.entries, WGPUBindGroupEntry{binding: binding, buffer: b.handle, size: b.size});
    self.stale = true;
}

void GpuBindGroup_texture(*GpuBindGroup self, uint32 binding, *GpuTexture t) {
    _gpu_set_entry(&self.entries, WGPUBindGroupEntry{binding: binding, textureView: t.view});
    self.stale = true;
}

void GpuBindGroup_sampler(*GpuBindGroup self, uint32 binding, *GpuSampler s) {
    _gpu_set_entry(&self.entries, WGPUBindGroupEntry{binding: binding, sampler: s.handle});
    self.stale = true;
}

void GpuBindGroup_release(*GpuBindGroup self) {
    if (self.handle != null) wgpuBindGroupRelease(self.handle);
    if (self.layout != null) wgpuBindGroupLayoutRelease(self.layout);
    List_free(&self.entries);
    self.handle = null;
    self.layout = null;
}

// The bind group for layout and entries: cached in *group, rebuilt when stale.
// A replaced group is kept by the pass until it ends, since the commands
// recorded so far may use it.
void _gpu_group_for(*GpuPass self, WGPUBindGroupLayout layout, List<WGPUBindGroupEntry>* entries, *WGPUBindGroup group, *bool stale) {
    if (*group != null && !*stale) return;
    if (*group != null) List_push(&self.groups, *group);
    WGPUBindGroupDescriptor bd = WGPUBindGroupDescriptor{layout: layout, entryCount: (uint64)entries.size, entries: entries.data};
    *group = wgpuDeviceCreateBindGroup(self.gpu.device, &bd);
    *stale = false;
}

// A command encoder for several passes and one submission.
GpuEncoder Gpu_encoder(*Gpu self) {
    GpuEncoder e;
    e.gpu = *self;
    _gpu_push(self);
    e.enc = wgpuDeviceCreateCommandEncoder(self.device, null);
    return e;
}

void _gpu_begin(*GpuPass p, WGPUTextureView target, *GpuPassOptions o) {
    WGPURenderPassColorAttachment color = WGPURenderPassColorAttachment{view: target, depthSlice: WGPU_DEPTH_SLICE_UNDEFINED,
        loadOp: o.load ? WGPULoadOp_Load : WGPULoadOp_Clear, storeOp: WGPUStoreOp_Store, clearValue: o.clear};
    WGPURenderPassDepthStencilAttachment da;
    WGPURenderPassDescriptor rd = WGPURenderPassDescriptor{colorAttachmentCount: 1, colorAttachments: &color};
    if (o.depth != null) {
        da = WGPURenderPassDepthStencilAttachment{view: o.depth.view, depthLoadOp: o.depth_load ? WGPULoadOp_Load : WGPULoadOp_Clear,
            depthStoreOp: WGPUStoreOp_Store, depthClearValue: 1.0};
        rd.depthStencilAttachment = &da;
    }
    p.pass = wgpuCommandEncoderBeginRenderPass(p.enc, &rd);
}

// A pass recorded into the encoder: end() closes it, and the encoder's
// submit() sends it with the others and reports its errors.
GpuPass GpuEncoder_pass(*GpuEncoder self, WGPUTextureView target, GpuColor clear, *GpuTexture depth) {
    GpuPassOptions o = GpuPassOptions{clear: clear, depth: depth};
    return GpuEncoder_pass_with(self, target, &o);
}

GpuPass GpuEncoder_pass_with(*GpuEncoder self, WGPUTextureView target, *GpuPassOptions o) {
    GpuPass p;
    p.gpu = self.gpu;
    p.enc = self.enc;
    p.encoder = self;
    _gpu_begin(&p, target, o);
    return p;
}

// Sends the passes to the GPU and reports the errors of the whole frame.
Result<int, string> GpuEncoder_submit(*GpuEncoder self) {
    string err = _gpu_finish(&self.gpu, self.enc, "frame");
    self.enc = null;
    for (i in 0..self.groups.size) wgpuBindGroupRelease(self.groups.data[i]);
    List_free(&self.groups);
    if (err != null) return Err<int, string>(err);
    return Ok<int, string>(0);
}

// Finishes enc and pops the error scope pushed when it was made; the commands
// are submitted only when they are valid (wgpu-native aborts on submitting
// invalid ones). Releases enc.
string _gpu_finish(*Gpu g, WGPUCommandEncoder enc, string what) {
    WGPUCommandBuffer cmd = wgpuCommandEncoderFinish(enc, null);
    wgpuCommandEncoderRelease(enc);
    string err = _gpu_pop(g, what);
    if (err == null && cmd != null) wgpuQueueSubmit(g.queue, 1, &cmd);
    if (cmd != null) wgpuCommandBufferRelease(cmd);
    return err;
}

// Starts a render pass that clears target to clear (and depth, when given, to
// 1.0). Errors in the pass are reported by end().
GpuPass Gpu_pass(*Gpu self, WGPUTextureView target, GpuColor clear, *GpuTexture depth) {
    GpuPassOptions o = GpuPassOptions{clear: clear, depth: depth};
    return Gpu_pass_with(self, target, &o);
}

// Gpu_pass with load ops per attachment: a pass that draws over what an
// earlier pass left (a UI over the scene).
GpuPass Gpu_pass_with(*Gpu self, WGPUTextureView target, *GpuPassOptions o) {
    GpuPass p;
    p.gpu = *self;
    _gpu_push(self);
    p.enc = wgpuDeviceCreateCommandEncoder(self.device, null);
    _gpu_begin(&p, target, o);
    return p;
}

void _gpu_pass_setup(*GpuPass self, *GpuPipeline pipe, *GpuBuffer vertices) {
    wgpuRenderPassEncoderSetPipeline(self.pass, pipe.handle);
    if (pipe.entries.size > 0) {
        _gpu_group_for(self, pipe.layout, &pipe.entries, &pipe.group, &pipe.group_stale);
        wgpuRenderPassEncoderSetBindGroup(self.pass, 0, pipe.group, 0, null);
    }
    if (vertices != null) wgpuRenderPassEncoderSetVertexBuffer(self.pass, 0, vertices.handle, 0, vertices.size);
}

// Sets bind group index for the draws that follow (it stays set across
// pipelines whose layouts agree on it).
void GpuPass_set_group(*GpuPass self, uint32 index, *GpuBindGroup g) {
    _gpu_group_for(self, g.layout, &g.entries, &g.handle, &g.stale);
    wgpuRenderPassEncoderSetBindGroup(self.pass, index, g.handle, 0, null);
}

// Sets vertex buffer slot for the draws that follow; slot 0 is also set by
// the vertices argument of draw() when it is not null.
void GpuPass_set_vertices(*GpuPass self, uint32 slot, *GpuBuffer b) {
    wgpuRenderPassEncoderSetVertexBuffer(self.pass, slot, b.handle, 0, b.size);
}

// Clips the draws that follow to a rectangle of the target, in pixels from
// the top left.
void GpuPass_set_scissor(*GpuPass self, uint32 x, uint32 y, uint32 width, uint32 height) {
    wgpuRenderPassEncoderSetScissorRect(self.pass, x, y, width, height);
}

// Maps clip space to a rectangle of the target, in pixels from the top left,
// and depth to min_depth..max_depth.
void GpuPass_set_viewport(*GpuPass self, float x, float y, float width, float height, float min_depth = 0.0, float max_depth = 1.0) {
    wgpuRenderPassEncoderSetViewport(self.pass, x, y, width, height, min_depth, max_depth);
}

// The constant of the GPU_BLEND_CONSTANT preset and of WGPUBlendFactor_Constant.
void GpuPass_set_blend_constant(*GpuPass self, GpuColor c) {
    wgpuRenderPassEncoderSetBlendConstant(self.pass, &c);
}

// Draws count vertices instances times; vertices may be null for a shader
// that makes its own (from @builtin(vertex_index)) or for buffers set with
// set_vertices().
void GpuPass_draw(*GpuPass self, *GpuPipeline pipe, *GpuBuffer vertices, uint32 count, uint32 instances) {
    _gpu_pass_setup(self, pipe, vertices);
    wgpuRenderPassEncoderDraw(self.pass, count, instances, 0, 0);
}

// GpuPass_draw from vertex first and instance first_instance.
void GpuPass_draw_range(*GpuPass self, *GpuPipeline pipe, *GpuBuffer vertices, uint32 first, uint32 count, uint32 first_instance, uint32 instances) {
    _gpu_pass_setup(self, pipe, vertices);
    wgpuRenderPassEncoderDraw(self.pass, count, instances, first, first_instance);
}

void GpuPass_draw_indexed(*GpuPass self, *GpuPipeline pipe, *GpuBuffer vertices, *GpuBuffer indices, uint32 count, uint32 instances) {
    _gpu_pass_setup(self, pipe, vertices);
    wgpuRenderPassEncoderSetIndexBuffer(self.pass, indices.handle, WGPUIndexFormat_Uint32, 0, indices.size);
    wgpuRenderPassEncoderDrawIndexed(self.pass, count, instances, 0, 0, 0);
}

// Ends the pass and submits it; a pass from a GpuEncoder is submitted (and
// its errors reported) by the encoder's submit().
Result<int, string> GpuPass_end(*GpuPass self) {
    *Gpu g = &self.gpu;
    wgpuRenderPassEncoderEnd(self.pass);
    wgpuRenderPassEncoderRelease(self.pass);
    self.pass = null;
    if (self.encoder != null) {
        for (i in 0..self.groups.size) List_push(&self.encoder.groups, self.groups.data[i]);
        List_free(&self.groups);
        return Ok<int, string>(0);
    }
    string err = _gpu_finish(g, self.enc, "render pass");
    self.enc = null;
    for (i in 0..self.groups.size) wgpuBindGroupRelease(self.groups.data[i]);
    List_free(&self.groups);
    if (err != null) return Err<int, string>(err);
    return Ok<int, string>(0);
}

Result<GpuSurface, string> _gpu_surface(*Gpu self, *WGPUChainedStruct source) {
    WGPUSurfaceDescriptor d = WGPUSurfaceDescriptor{nextInChain: source};
    WGPUSurface s = wgpuInstanceCreateSurface(self.instance, &d);
    if (s == null) return Err<GpuSurface, string>(_gpu_fail("surface", null));
    WGPUSurfaceCapabilities caps;
    wgpuSurfaceGetCapabilities(s, self.adapter, &caps);
    WGPUTextureFormat format = WGPUTextureFormat_BGRA8Unorm;
    for (i in 0..caps.formatCount) {
        if (caps.formats[i] == WGPUTextureFormat_BGRA8Unorm || caps.formats[i] == WGPUTextureFormat_RGBA8Unorm) {
            format = caps.formats[i];
            break;
        }
    }
    wgpuSurfaceCapabilitiesFreeMembers(caps);
    return Ok<GpuSurface, string>(GpuSurface{*self, s, format, 0, 0});
}

// A surface over a CAMetalLayer (macOS, iOS).
Result<GpuSurface, string> Gpu_surface_metal(*Gpu self, *void layer) {
    WGPUSurfaceSourceMetalLayer src = WGPUSurfaceSourceMetalLayer{chain: WGPUChainedStruct{null, WGPUSType_SurfaceSourceMetalLayer}, layer: layer};
    return _gpu_surface(self, (*WGPUChainedStruct)&src);
}

// A surface over an X11 window (display is the Display*).
Result<GpuSurface, string> Gpu_surface_x11(*Gpu self, *void display, uint64 window) {
    WGPUSurfaceSourceXlibWindow src = WGPUSurfaceSourceXlibWindow{chain: WGPUChainedStruct{null, WGPUSType_SurfaceSourceXlibWindow}, display: display, window: window};
    return _gpu_surface(self, (*WGPUChainedStruct)&src);
}

// A surface over a Wayland wl_surface (display is the wl_display*).
Result<GpuSurface, string> Gpu_surface_wayland(*Gpu self, *void display, *void surface) {
    WGPUSurfaceSourceWaylandSurface src = WGPUSurfaceSourceWaylandSurface{chain: WGPUChainedStruct{null, WGPUSType_SurfaceSourceWaylandSurface}, display: display, surface: surface};
    return _gpu_surface(self, (*WGPUChainedStruct)&src);
}

// A surface over a Win32 window.
Result<GpuSurface, string> Gpu_surface_win32(*Gpu self, *void hinstance, *void hwnd) {
    WGPUSurfaceSourceWindowsHWND src = WGPUSurfaceSourceWindowsHWND{chain: WGPUChainedStruct{null, WGPUSType_SurfaceSourceWindowsHWND}, hinstance: hinstance, hwnd: hwnd};
    return _gpu_surface(self, (*WGPUChainedStruct)&src);
}

// A surface over an Android ANativeWindow*.
Result<GpuSurface, string> Gpu_surface_android(*Gpu self, *void window) {
    WGPUSurfaceSourceAndroidNativeWindow src = WGPUSurfaceSourceAndroidNativeWindow{chain: WGPUChainedStruct{null, WGPUSType_SurfaceSourceAndroidNativeWindow}, window: window};
    return _gpu_surface(self, (*WGPUChainedStruct)&src);
}

// Sets the size of the surface's frames, in pixels; call it again when the
// window is resized.
void GpuSurface_configure(*GpuSurface self, uint32 width, uint32 height) {
    self.width = width;
    self.height = height;
    WGPUSurfaceConfiguration c = WGPUSurfaceConfiguration{device: self.gpu.device, format: self.format,
        usage: WGPUTextureUsage_RenderAttachment, width: width, height: height,
        alphaMode: WGPUCompositeAlphaMode_Auto, presentMode: WGPUPresentMode_Fifo};
    wgpuSurfaceConfigure(self.handle, &c);
}

// The next frame to draw into. An error means the surface needs configure()
// again (after a resize) or the frame was skipped.
Result<GpuFrame, string> GpuSurface_frame(*GpuSurface self) {
    WGPUSurfaceTexture st;
    wgpuSurfaceGetCurrentTexture(self.handle, &st);
    if (st.status != WGPUSurfaceGetCurrentTextureStatus_SuccessOptimal && st.status != WGPUSurfaceGetCurrentTextureStatus_SuccessSuboptimal) {
        if (st.texture != null) wgpuTextureRelease(st.texture);
        String_clear(&_gpu_err);
        String_appendf(&_gpu_err, "surface frame unavailable (status %d)", (int)st.status);
        return Err<GpuFrame, string>(_gpu_err.data);
    }
    return Ok<GpuFrame, string>(GpuFrame{st.texture, wgpuTextureCreateView(st.texture, null)});
}

// Shows the frame and releases it.
void GpuSurface_present(*GpuSurface self, *GpuFrame frame) {
    wgpuSurfacePresent(self.handle);
    wgpuTextureViewRelease(frame.view);
    wgpuTextureRelease(frame.texture);
}

void GpuSurface_release(*GpuSurface self) {
    if (self.handle != null) {
        wgpuSurfaceUnconfigure(self.handle);
        wgpuSurfaceRelease(self.handle);
    }
    self.handle = null;
}
