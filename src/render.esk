// render.esk: textures, render pipelines, passes and window surfaces
// (imported by <gpu>).
//
// A frame is a pass over a target view: a texture's (GpuTexture.view) or a
// window surface's (GpuFrame.view, from GpuSurface_frame):
//
//     GpuPass pass = gpu.pass(frame.view, GpuColor{0.1, 0.1, 0.1, 1.0}, &depth);
//     pass.draw(&pipeline, &vertices, 3, 1);
//     pass.end()?;
//     surface.present(&frame);
//
// Bindings set on a pipeline with bind(), bind_texture() and bind_sampler()
// apply to group 0 of its shaders; the bind group they make is kept by the
// pipeline and reused until a binding changes. For several groups, or groups
// shared by pipelines, describe each with a GpuBindLayout, list them in
// GpuPipelineDesc.groups, and set GpuBindGroups on the pass:
//
//     GpuBindLayout scene = gpu.bind_layout();
//     scene.uniform(0, WGPUShaderStage_Vertex);
//     GpuBindGroup sg = scene.group()?;
//     sg.buffer(0, &camera);
//     pass.set_group(0, &sg);
//
// Several passes go into one submission through a GpuEncoder:
//
//     GpuEncoder enc = gpu.encoder();
//     GpuPass scene = enc.pass(frame.view, clear, &depth);
//     ...
//     scene.end()?;
//     GpuPassOptions keep = GpuPassOptions{load: true};
//     GpuPass ui = enc.pass_with(frame.view, &keep);
//     ...
//     ui.end()?;
//     enc.submit()?;
//
// Gpu_texture_with makes 2D-array and cube textures (with mip levels and extra
// view formats); a GpuTextureView of one layer (face) and mip level is a
// render target, and the texture's own view samples the whole texture.
// GpuPipelineDesc.targets and GpuPassOptions.colors draw into up to 8 color
// targets at once.

import <io>;
import <mem>;
import <string>;
import <list>;
import <result>;
import <gpu/raw>;
import <gpu/core>;
import <gpu/ktx2>;
import <libc>;

// A color as four doubles r, g, b, a (a pass's clear color, the blend constant). A clear
// color for an sRGB target is in linear light and the GPU encodes it; for other formats
// it is stored as given.
type GpuColor = WGPUColor;

// A texture and its view of the whole of it: a 2D view, a 2D-array view
// (layers > 1), or a cube view (dimension Cube, layers 6). layers 0 is 1.
struct GpuTexture {
    Gpu gpu;
    WGPUTexture handle;
    WGPUTextureView view;
    WGPUTextureFormat format;
    uint32 width;
    uint32 height;
    uint32 mips;
    uint32 samples;
    uint32 layers;
    WGPUTextureViewDimension dimension;
    WGPUTextureUsage usage;
}

// A texture's description for Gpu_texture_with. The zero value of each field:
// - format: RGBA8Unorm.
// - layers: 1 (6 with cube); more than 1 makes a 2D array, and array makes
//   one with a single layer (a shadow map array of one).
// - cube: square faces in 6 layers (+X, -X, +Y, -Y, +Z, -Z), sampled as a
//   texture_cube; a multiple of 6 layers is a cube array.
// - mips: 1 level; mipmaps: the full chain down to 1x1 (mips is then ignored),
//   filled with write_level or generate_mips.
// - usage: TextureBinding, CopySrc and CopyDst, plus RenderAttachment for the
//   formats that can be render targets (depth formats: RenderAttachment and
//   TextureBinding; block-compressed: TextureBinding and CopyDst).
// - samples: 1.
// - view_formats lists the other formats views may have (view_as): the sRGB
//   or linear twin of format.
struct GpuTextureDesc {
    uint32 width;
    uint32 height;
    WGPUTextureFormat format;
    uint32 layers;
    bool cube;
    bool array;
    uint32 mips;
    bool mipmaps;
    WGPUTextureUsage usage;
    uint32 samples;
    *WGPUTextureFormat view_formats;
    uint32 view_format_count;
}

// A view of part of a texture, or of all of it in another format or
// dimension: a render target for one face, layer or mip level, or a texture
// to sample (GpuBindGroup_view). width and height are its mip level's size.
struct GpuTextureView {
    WGPUTextureView view;
    WGPUTextureFormat format;
    uint32 width;
    uint32 height;
}

// What GpuTexture_view_with shows. Zero values: the texture's format, its
// dimension (2D when layers is 1), every mip level from base_mip, every layer
// from base_layer, both aspects (DepthOnly samples the depth of a depth and
// stencil texture).
struct GpuViewDesc {
    WGPUTextureFormat format;
    WGPUTextureViewDimension dimension;
    uint32 base_mip;
    uint32 mips;
    uint32 base_layer;
    uint32 layers;
    WGPUTextureAspect aspect;
}

// How Gpu_image_with stores the pixels: srgb for color data (photos, base
// color and emissive maps; the GPU converts to linear when sampling), mipmaps
// to add the smaller levels that keep a texture smooth at a distance.
struct GpuImageOptions {
    bool srgb;
    bool mipmaps;
}

// A sampler's settings. The zero value is linear filtering that repeats the
// texture. wrap_u and wrap_v take WGPUAddressMode values (Repeat,
// MirrorRepeat, ClampToEdge); anisotropy above 1 needs linear filtering.
// compare makes a comparison sampler (WGPUCompareFunction, such as LessEqual)
// for depth textures, bound as WGPUSamplerBindingType_Comparison and used with
// textureSampleCompare; with linear filtering it returns the fraction of the
// 2x2 texels that pass (percentage-closer filtering).
struct GpuSamplerOptions {
    bool nearest;
    bool mipmaps;
    WGPUAddressMode wrap_u;
    WGPUAddressMode wrap_v;
    uint16 anisotropy;
    WGPUCompareFunction compare;
}

// A sampler made by Gpu_sampler or Gpu_sampler_with; release it with release().
struct GpuSampler {
    WGPUSampler handle;
}

// The layout of one vertex buffer of a pipeline: one attribute per shader
// @location, numbered in the order they are added from location (0 by
// default). step is WGPUVertexStepMode_Instance for a buffer read once per
// instance; the zero value reads it once per vertex.
struct GpuVertexLayout {
    uint64 stride;
    List<WGPUVertexAttribute> attrs;
    WGPUVertexStepMode step;
    uint32 location;
}

// How a pipeline blends its output with the target. NONE replaces the
// target; ALPHA is source over (straight alpha), PREMULTIPLIED the same for
// premultiplied colors, ADDITIVE adds the color scaled by its alpha, MULTIPLY
// multiplies the target by the color, and CONSTANT mixes the source and the
// target by the pass's blend constant (GpuPass_set_blend_constant): 1.0 is
// all source, 0.0 keeps the target.
enum GpuBlend {
    GPU_BLEND_NONE,
    GPU_BLEND_ALPHA,
    GPU_BLEND_PREMULTIPLIED,
    GPU_BLEND_ADDITIVE,
    GPU_BLEND_MULTIPLY,
    GPU_BLEND_CONSTANT
}

// One color target of a pipeline (GpuPipelineDesc.targets): its format and
// blending, as GpuPipelineDesc's format, blend_mode, blend_state and
// no_color_write are for a single target.
struct GpuColorTarget {
    WGPUTextureFormat format;
    GpuBlend blend_mode;
    *WGPUBlendState blend_state;
    bool no_color_write;
}

// One face's stencil test (GpuPipelineDesc.stencil_front and stencil_back):
// the fragment passes when (reference & read mask) compare (stencil & read
// mask) holds, and the stencil value then takes fail when the test fails,
// depth_fail when the stencil test passes and the depth test fails, pass when
// both pass (WGPUStencilOperation: Keep, Zero, Replace with the reference,
// Invert, IncrementClamp...). The zero value is Always with Keep for each op.
struct GpuStencilFace {
    WGPUCompareFunction compare;
    WGPUStencilOperation fail;
    WGPUStencilOperation depth_fail;
    WGPUStencilOperation pass;
}

// A render pipeline's description. The zero value of each field is the
// common case:
// - layout is the one vertex buffer; layouts and layout_count list several
//   (up to 8, bound with GpuPass_set_vertices; layouts wins when both are set).
// - groups and group_count list the bind group layouts, one per @group index;
//   without them the pipeline takes its layout from the shader and binds group
//   0 with bind(), bind_texture() and bind_sampler().
// - blend: true is GPU_BLEND_ALPHA; blend_mode picks a preset and blend_state,
//   when not null, is any WGPUBlendState. no_color_write leaves the color
//   target untouched (a depth-only draw).
// - depth turns on the depth test against a depth_format texture (default
//   Depth24Plus, also Depth32Float) with depth_compare (default Less);
//   depth_read_only turns depth writes off. depth_bias and depth_bias_slope
//   offset the depth written.
// - stencil_front and stencil_back test and update the stencil of a
//   depth_format with one (Depth24PlusStencil8, Depth32FloatStencil8 when
//   Gpu.depth32_stencil8, Stencil8) against the pass's reference
//   (GpuPass_set_stencil_reference); stencil_back left zero is stencil_front.
//   stencil_read_mask and stencil_write_mask are 0xFF when 0 (a mask of 0 is
//   the same as an Always or Never compare, or Keep ops). The stencil, like
//   the depth, needs depth: a stencil-only draw sets depth_compare Always and
//   depth_read_only.
// - samples is the multisample count, 1 or 4 (0 is 1); the pass's attachments
//   must have the same count (Gpu_target_msaa).
// - targets and target_count list several color targets, written by the
//   fragment shader's @location(0) to @location(7) (up to 8, at most 32 bytes
//   per pixel in all); format and the blend fields then do nothing. The pass
//   needs the same formats in the same order (GpuPassOptions.colors).
// - fragment null makes a pipeline with no fragment stage and no color target,
//   which only writes depth (a shadow map), drawn in a pass without colors.
struct GpuPipelineDesc {
    string wgsl;
    string vertex;
    string fragment;
    WGPUTextureFormat format;
    *GpuVertexLayout layout;
    bool depth;
    bool depth_read_only;
    bool blend;
    WGPUPrimitiveTopology topology;
    WGPUCullMode cull;
    *GpuVertexLayout layouts;
    uint32 layout_count;
    **GpuBindLayout groups;
    uint32 group_count;
    GpuBlend blend_mode;
    *WGPUBlendState blend_state;
    bool no_color_write;
    WGPUTextureFormat depth_format;
    WGPUCompareFunction depth_compare;
    int32 depth_bias;
    float depth_bias_slope;
    GpuStencilFace stencil_front;
    GpuStencilFace stencil_back;
    uint32 stencil_read_mask;
    uint32 stencil_write_mask;
    uint32 samples;
    *GpuColorTarget targets;
    uint32 target_count;
}

// A render pipeline made by Gpu_pipeline: the shader module, the pipeline, and the group 0
// bindings set with bind(), bind_texture(), bind_view() and bind_sampler() with the bind
// group made from them (group, rebuilt when group_stale). It keeps a copy of the Gpu that
// made it.
struct GpuPipeline {
    Gpu gpu;
    WGPUShaderModule module;
    WGPURenderPipeline handle;
    WGPUBindGroupLayout layout;
    List<WGPUBindGroupEntry> entries;
    WGPUPipelineLayout pipeline_layout;
    WGPUBindGroup group;
    bool group_stale;
}

// The bindings of one @group, shared by the pipelines and bind groups made
// from it. Add every entry before the first pipeline or group uses it.
// visibility is a set of WGPUShaderStage bits (0 is vertex and fragment).
struct GpuBindLayout {
    Gpu gpu;
    WGPUBindGroupLayout handle;
    List<WGPUBindGroupLayoutEntry> entries;
}

// Resources for the bindings of a GpuBindLayout, set on a pass with
// GpuPass_set_group. The WebGPU bind group is made on first use and kept until
// a binding changes, so a group set every frame costs nothing to rebuild.
struct GpuBindGroup {
    Gpu gpu;
    WGPUBindGroupLayout layout;
    List<WGPUBindGroupEntry> entries;
    WGPUBindGroup handle;
    bool stale;
}

// A command encoder that passes are opened from (GpuEncoder_pass), sent to
// the GPU in one submission by GpuEncoder_submit.
struct GpuEncoder {
    Gpu gpu;
    WGPUCommandEncoder enc;
    List<WGPUBindGroup> groups;
}

// A pass's attachments: the color target is cleared to clear, or keeps its
// pixels with load; the depth texture, when given, is cleared to 1.0, or keeps
// its values with depth_load. When the depth texture's format has a stencil,
// the stencil is cleared to stencil_clear, or kept with stencil_load.
// A multisampled target (Gpu_target_msaa) is resolved at the end of the pass
// into resolve, a single-sample view of the same format and size (a surface
// frame's view or a target's); discard then drops the multisampled pixels
// instead of storing them, which saves memory traffic on tile GPUs (phones)
// when no later pass loads them.
// colors and color_count list several color attachments (up to 8), each
// with its own clear, load, resolve and discard; the pass's target argument is
// then null and clear, load, resolve and discard here do nothing. A null
// target with no colors is a pass with only the depth attachment.
// depth_view, when set, is the depth attachment instead of depth: one layer of
// a depth texture array (GpuTexture_view_level), such as one shadow map.
struct GpuPassOptions {
    GpuColor clear;
    bool load;
    *GpuTexture depth;
    bool depth_load;
    uint32 stencil_clear;
    bool stencil_load;
    WGPUTextureView resolve;
    bool discard;
    *GpuColorAttachment colors;
    uint32 color_count;
    *GpuTextureView depth_view;
}

// One color attachment of a pass (GpuPassOptions.colors), at the location of
// its index.
struct GpuColorAttachment {
    WGPUTextureView view;
    GpuColor clear;
    bool load;
    WGPUTextureView resolve;
    bool discard;
}

// A render pass being recorded, from Gpu_pass, Gpu_pass_with or a GpuEncoder. Draw into
// it, then end() it once. err holds a problem found when the pass began (too many color
// attachments), reported by end() or by the encoder's submit().
struct GpuPass {
    Gpu gpu;
    WGPUCommandEncoder enc;
    WGPURenderPassEncoder pass;
    List<WGPUBindGroup> groups;
    *GpuEncoder encoder;
    string err;
    // The depth attachment's format, 0 when the pass has none: a pipeline
    // drawn in the pass needs the same.
    WGPUTextureFormat depth_format;
}

// A texture copy on its way back from the GPU (GpuTexture_read_async).
struct GpuReadback {
    Gpu gpu;
    WGPUBuffer staging;
    *_GpuWait wait;
    uint32 width;
    uint32 height;
    uint32 row;
    uint32 padded;
}

// view_format, when set (GpuSurface_configure_with), is a second format the
// frames are also seen through: the sRGB or linear twin of format.
struct GpuSurface {
    Gpu gpu;
    WGPUSurface handle;
    WGPUTextureFormat format;
    uint32 width;
    uint32 height;
    WGPUTextureFormat view_format;
}

// A frame to draw into: view in the surface's format and, when the surface
// has a view_format, alt_view in that one (null otherwise).
struct GpuFrame {
    WGPUTexture texture;
    WGPUTextureView view;
    WGPUTextureView alt_view;
}

// A vertex buffer holding a copy of bytes bytes at data, laid out as the pipeline's
// GpuVertexLayout says.
Result<GpuBuffer, string> Gpu_vertices(*Gpu self, *void data, uint64 bytes) {
    GpuBuffer b = Gpu_buffer(self, bytes, WGPUBufferUsage_Vertex | WGPUBufferUsage_CopyDst)?;
    GpuBuffer_write(&b, 0, data, bytes);
    return Ok<GpuBuffer, string>(b);
}

// An index buffer of uint32 indices.
Result<GpuBuffer, string> Gpu_indices(*Gpu self, *uint32 data, uint64 count) {
    GpuBuffer b = Gpu_buffer(self, count * 4, WGPUBufferUsage_Index | WGPUBufferUsage_CopyDst)?;
    GpuBuffer_write(&b, 0, data, count * 4);
    return Ok<GpuBuffer, string>(b);
}

// A uniform buffer of bytes bytes, updated with write().
Result<GpuBuffer, string> Gpu_uniform(*Gpu self, *void data, uint64 bytes) {
    GpuBuffer b = Gpu_buffer(self, bytes, WGPUBufferUsage_Uniform | WGPUBufferUsage_CopyDst)?;
    if (data != null) GpuBuffer_write(&b, 0, data, bytes);
    return Ok<GpuBuffer, string>(b);
}

// A single-level 2D texture of width x height texels in format, with the given
// WGPUTextureUsage flags (0 for the defaults GpuTextureDesc lists). Gpu_texture_with takes
// the other settings.
Result<GpuTexture, string> Gpu_texture(*Gpu self, uint32 width, uint32 height, WGPUTextureFormat format, WGPUTextureUsage usage) {
    return _gpu_texture(self, width, height, format, usage, 1, 1);
}

Result<GpuTexture, string> _gpu_texture(*Gpu self, uint32 width, uint32 height, WGPUTextureFormat format, WGPUTextureUsage usage, uint32 mips, uint32 samples) {
    GpuTextureDesc d = GpuTextureDesc{width: width, height: height, format: format, mips: mips, usage: usage, samples: samples};
    return Gpu_texture_with(self, &d);
}

// The number of mip levels from width x height down to 1x1.
uint32 gpu_mip_count(uint32 width, uint32 height) {
    uint32 n = 1;
    uint32 m = width > height ? width : height;
    while (m > 1) {
        m = m / 2;
        n++;
    }
    return n;
}

// A texture with layers, a cube, mip levels or extra view formats (see
// GpuTextureDesc). Its view covers all of it: 2D, 2D array or cube.
Result<GpuTexture, string> Gpu_texture_with(*Gpu self, *GpuTextureDesc d) {
    WGPUTextureFormat format = d.format != 0 ? d.format : WGPUTextureFormat_RGBA8Unorm;
    uint32 layers = d.layers != 0 ? d.layers : (d.cube ? (uint32)6 : (uint32)1);
    if (d.cube && (layers % 6 != 0 || d.width != d.height)) {
        return Err<GpuTexture, string>(_gpu_fail("texture: a cube needs square faces and 6 layers (or a multiple of 6)", null));
    }
    string missing = _gpu_format_missing(self, format);
    if (missing != null) return Err<GpuTexture, string>(_gpu_fail(missing, null));
    uint32 mips = d.mipmaps ? gpu_mip_count(d.width, d.height) : (d.mips != 0 ? d.mips : (uint32)1);
    uint32 samples = d.samples != 0 ? d.samples : (uint32)1;
    WGPUTextureUsage usage = d.usage != 0 ? d.usage : _gpu_default_usage(format);
    WGPUTextureViewDimension dim = WGPUTextureViewDimension_2D;
    if (d.cube) dim = layers > 6 ? WGPUTextureViewDimension_CubeArray : WGPUTextureViewDimension_Cube;
    else if (layers > 1 || d.array) dim = WGPUTextureViewDimension_2DArray;
    _gpu_push(self);
    WGPUTextureDescriptor td = WGPUTextureDescriptor{usage: usage, dimension: WGPUTextureDimension_2D,
        size: WGPUExtent3D{d.width, d.height, layers}, format: format, mipLevelCount: mips, sampleCount: samples,
        viewFormatCount: (uint64)d.view_format_count, viewFormats: d.view_formats};
    WGPUTexture t = wgpuDeviceCreateTexture(self.device, &td);
    WGPUTextureView v = null;
    if (t != null) {
        WGPUTextureViewDescriptor vd = WGPUTextureViewDescriptor{format: format, dimension: dim, mipLevelCount: mips,
            arrayLayerCount: layers, aspect: WGPUTextureAspect_All};
        v = wgpuTextureCreateView(t, &vd);
    }
    string err = _gpu_pop(self, "texture");
    GpuTexture tex = GpuTexture{*self, t, v, format, d.width, d.height, mips, samples, layers, dim, usage};
    if (err != null || t == null) {
        GpuTexture_release(&tex);
        return Err<GpuTexture, string>(err != null ? err : _gpu_fail("texture", null));
    }
    return Ok<GpuTexture, string>(tex);
}

// A depth texture that shaders can sample (texture_depth_2d, or
// texture_depth_2d_array when layers > 1) and compare against
// (GpuSamplerOptions.compare): a shadow map. format is Depth32Float when 0.
Result<GpuTexture, string> Gpu_depth_texture(*Gpu self, uint32 width, uint32 height, WGPUTextureFormat format, uint32 layers) {
    GpuTextureDesc d = GpuTextureDesc{width: width, height: height, format: format != 0 ? format : WGPUTextureFormat_Depth32Float,
        layers: layers, usage: WGPUTextureUsage_RenderAttachment | WGPUTextureUsage_TextureBinding};
    return Gpu_texture_with(self, &d);
}

bool _gpu_is_depth(WGPUTextureFormat f) {
    return f >= WGPUTextureFormat_Stencil8 && f <= WGPUTextureFormat_Depth32FloatStencil8;
}

bool _gpu_is_integer(WGPUTextureFormat f) {
    return f == WGPUTextureFormat_R8Uint || f == WGPUTextureFormat_R8Sint || f == WGPUTextureFormat_R16Uint || f == WGPUTextureFormat_R16Sint
        || f == WGPUTextureFormat_RG8Uint || f == WGPUTextureFormat_RG8Sint || f == WGPUTextureFormat_R32Uint || f == WGPUTextureFormat_R32Sint
        || f == WGPUTextureFormat_RG16Uint || f == WGPUTextureFormat_RG16Sint || f == WGPUTextureFormat_RGBA8Uint || f == WGPUTextureFormat_RGBA8Sint
        || f == WGPUTextureFormat_RGB10A2Uint || f == WGPUTextureFormat_RG32Uint || f == WGPUTextureFormat_RG32Sint
        || f == WGPUTextureFormat_RGBA16Uint || f == WGPUTextureFormat_RGBA16Sint || f == WGPUTextureFormat_RGBA32Uint || f == WGPUTextureFormat_RGBA32Sint;
}

// Whether every device can render into a color texture of format f.
bool _gpu_renderable(WGPUTextureFormat f) {
    if (f == WGPUTextureFormat_Undefined || f >= WGPUTextureFormat_Stencil8) return false;
    if (f == WGPUTextureFormat_R8Snorm || f == WGPUTextureFormat_RG8Snorm || f == WGPUTextureFormat_RGBA8Snorm) return false;
    if (f == WGPUTextureFormat_R16Unorm || f == WGPUTextureFormat_R16Snorm || f == WGPUTextureFormat_RG16Unorm || f == WGPUTextureFormat_RG16Snorm) return false;
    if (f == WGPUTextureFormat_RGBA16Unorm || f == WGPUTextureFormat_RGBA16Snorm) return false;
    return f != WGPUTextureFormat_RG11B10Ufloat && f != WGPUTextureFormat_RGB9E5Ufloat;
}

WGPUTextureUsage _gpu_default_usage(WGPUTextureFormat f) {
    if (_gpu_is_depth(f)) return WGPUTextureUsage_RenderAttachment | WGPUTextureUsage_TextureBinding;
    if (f >= WGPUTextureFormat_BC1RGBAUnorm) return WGPUTextureUsage_TextureBinding | WGPUTextureUsage_CopyDst;
    WGPUTextureUsage u = WGPUTextureUsage_TextureBinding | WGPUTextureUsage_CopySrc | WGPUTextureUsage_CopyDst;
    if (_gpu_renderable(f)) u = u | WGPUTextureUsage_RenderAttachment;
    return u;
}

// An RGBA8 texture to render into, sample in a later pass and read back.
Result<GpuTexture, string> Gpu_target(*Gpu self, uint32 width, uint32 height) {
    return Gpu_target_with(self, width, height, WGPUTextureFormat_RGBA8Unorm);
}

// Gpu_target in another format (RGBA8UnormSrgb, BGRA8Unorm, RGBA16Float...).
Result<GpuTexture, string> Gpu_target_with(*Gpu self, uint32 width, uint32 height, WGPUTextureFormat format) {
    return Gpu_texture(self, width, height, format,
        WGPUTextureUsage_RenderAttachment | WGPUTextureUsage_CopySrc | WGPUTextureUsage_TextureBinding);
}

// A multisampled render attachment of samples samples per pixel (4, the
// count every WebGPU device supports for the common formats): a color target
// resolved into a single-sample view at the end of a pass
// (GpuPassOptions.resolve), or a depth (and stencil) texture for the same
// pass. It is only drawn into: it cannot be read back or sampled.
Result<GpuTexture, string> Gpu_target_msaa(*Gpu self, uint32 width, uint32 height, WGPUTextureFormat format, uint32 samples) {
    return _gpu_texture(self, width, height, format, WGPUTextureUsage_RenderAttachment, 1, samples);
}

// A format's texel block: 1x1 and the texel size for uncompressed formats,
// the block size and its bytes for BC, ETC2/EAC and ASTC.
void _gpu_format_block(WGPUTextureFormat f, *uint32 bw, *uint32 bh, *uint32 bytes) {
    *bw = 1;
    *bh = 1;
    uint32 v = (uint32)f;
    if (v >= 0x4A && v <= 0x65) {
        uint32[28] dims = {4, 4, 5, 4, 5, 5, 6, 5, 6, 6, 8, 5, 8, 6, 8, 8, 10, 5, 10, 6, 10, 8, 10, 10, 12, 10, 12, 12};
        int k = (int)((v - 0x4A) / 2);
        *bw = dims[k * 2];
        *bh = dims[k * 2 + 1];
        *bytes = 16;
        return;
    }
    if (v >= 0x32) {
        *bw = 4;
        *bh = 4;
        bool half = v == 0x32 || v == 0x33 || v == 0x38 || v == 0x39 || (v >= 0x40 && v <= 0x43) || v == 0x46 || v == 0x47;
        *bytes = half ? (uint32)8 : (uint32)16;
        return;
    }
    if (v <= 0x04 || v == 0x2C) *bytes = 1;
    else if (v <= 0x0D || v == 0x2D) *bytes = 2;
    else if (v <= 0x20 || v == 0x2E || v == 0x2F || v == 0x30) *bytes = 4;
    else if (v <= 0x28 || v == 0x31) *bytes = 8;
    else *bytes = 16;
}

// Bytes per texel of an uncompressed format (bytes per block for the others).
uint32 _gpu_texel_bytes(WGPUTextureFormat f) {
    uint32 bw = 1;
    uint32 bh = 1;
    uint32 b = 4;
    _gpu_format_block(f, &bw, &bh, &b);
    return b;
}

// The sRGB twin of a format (RGBA8Unorm gives RGBA8UnormSrgb; also BGRA8 and
// the BC1-3, BC7, ETC2 and ASTC formats), f itself when it is sRGB already, or
// Undefined when it has none.
WGPUTextureFormat gpu_srgb_format(WGPUTextureFormat f) {
    uint32 v = (uint32)f;
    if (v == 0x16 || v == 0x1B) return (WGPUTextureFormat)(v + 1);
    if (v == 0x17 || v == 0x1C) return f;
    bool pair = (v >= 0x32 && v <= 0x37) || v == 0x3E || v == 0x3F || (v >= 0x40 && v <= 0x45) || (v >= 0x4A && v <= 0x65);
    if (!pair) return WGPUTextureFormat_Undefined;
    return (WGPUTextureFormat)(v | 1);
}

// The linear twin of a format (RGBA8UnormSrgb gives RGBA8Unorm), f itself when
// it has an sRGB twin, or Undefined when it has none.
WGPUTextureFormat gpu_linear_format(WGPUTextureFormat f) {
    WGPUTextureFormat s = gpu_srgb_format(f);
    if (s == WGPUTextureFormat_Undefined) return s;
    uint32 v = (uint32)s;
    if (v == 0x17 || v == 0x1C) return (WGPUTextureFormat)(v - 1);
    return (WGPUTextureFormat)(v & 0xFFFFFFFE);
}

// An RGBA8 texture for shaders to sample, filled from width * height pixels
// of 4 bytes each.
Result<GpuTexture, string> Gpu_image(*Gpu self, uint32 width, uint32 height, *void rgba) {
    return Gpu_image_with(self, width, height, rgba, null);
}

// Gpu_image with options (null for the defaults: linear, no mipmaps).
Result<GpuTexture, string> Gpu_image_with(*Gpu self, uint32 width, uint32 height, *void rgba, *GpuImageOptions opts) {
    bool srgb = opts != null && opts.srgb;
    bool mipmaps = opts != null && opts.mipmaps;
    uint32 mips = mipmaps ? gpu_mip_count(width, height) : (uint32)1;
    WGPUTextureFormat format = srgb ? WGPUTextureFormat_RGBA8UnormSrgb : WGPUTextureFormat_RGBA8Unorm;
    GpuTexture t = _gpu_texture(self, width, height, format, WGPUTextureUsage_TextureBinding | WGPUTextureUsage_CopyDst, mips, 1)?;
    GpuTexture_write(&t, rgba);
    if (mips > 1) _gpu_write_mips(&t, (*uint8)rgba, srgb);
    return Ok<GpuTexture, string>(t);
}

float[256] _gpu_srgb_lin;
uint8[4096] _gpu_lin_srgb;
bool _gpu_srgb_ready = false;

void _gpu_srgb_tables() {
    if (_gpu_srgb_ready) return;
    for (i in 0..256) {
        double c = (double)i / 255.0;
        _gpu_srgb_lin[i] = (float)(c <= 0.04045 ? c / 12.92 : pow((c + 0.055) / 1.055, 2.4));
    }
    for (i in 0..4096) {
        double l = (double)i / 4095.0;
        double c = l <= 0.0031308 ? l * 12.92 : 1.055 * pow(l, 1.0 / 2.4) - 0.055;
        _gpu_lin_srgb[i] = (uint8)(c * 255.0 + 0.5);
    }
    _gpu_srgb_ready = true;
}

// Halves an RGBA8 image with a 2x2 box filter; with srgb, the color channels
// are averaged in linear light.
void _gpu_halve(*uint8 src, uint32 w, uint32 h, *uint8 dst, uint32 dw, uint32 dh, bool srgb) {
    for (y in 0..dh) {
        uint32 y0 = y * 2 < h ? y * 2 : h - 1;
        uint32 y1 = y * 2 + 1 < h ? y * 2 + 1 : h - 1;
        for (x in 0..dw) {
            uint32 x0 = x * 2 < w ? x * 2 : w - 1;
            uint32 x1 = x * 2 + 1 < w ? x * 2 + 1 : w - 1;
            *uint8 a = src + ((uint64)y0 * w + x0) * 4;
            *uint8 b = src + ((uint64)y0 * w + x1) * 4;
            *uint8 c = src + ((uint64)y1 * w + x0) * 4;
            *uint8 d = src + ((uint64)y1 * w + x1) * 4;
            *uint8 o = dst + ((uint64)y * dw + x) * 4;
            for (k in 0..4) {
                if (srgb && k < 3) {
                    float l = (_gpu_srgb_lin[(int)a[k]] + _gpu_srgb_lin[(int)b[k]] + _gpu_srgb_lin[(int)c[k]] + _gpu_srgb_lin[(int)d[k]]) * 0.25;
                    o[k] = _gpu_lin_srgb[(int)(l * 4095.0 + 0.5)];
                } else {
                    o[k] = (uint8)(((uint32)a[k] + b[k] + c[k] + d[k] + 2) / 4);
                }
            }
        }
    }
}

void _gpu_write_mips(*GpuTexture t, *uint8 rgba, bool srgb) {
    if (srgb) _gpu_srgb_tables();
    uint32 w = t.width;
    uint32 h = t.height;
    *uint8 prev = rgba;
    *uint8 owned = null;
    for (level in 1..t.mips) {
        uint32 dw = w > 1 ? w / 2 : 1;
        uint32 dh = h > 1 ? h / 2 : 1;
        *uint8 next = alloc<uint8>((int)(dw * dh * 4));
        _gpu_halve(prev, w, h, next, dw, dh, srgb);
        WGPUTexelCopyTextureInfo dst = WGPUTexelCopyTextureInfo{texture: t.handle, mipLevel: level, aspect: WGPUTextureAspect_All};
        WGPUTexelCopyBufferLayout layout = WGPUTexelCopyBufferLayout{0, dw * 4, dh};
        WGPUExtent3D size = WGPUExtent3D{dw, dh, 1};
        wgpuQueueWriteTexture(t.gpu.queue, &dst, next, (uint64)dw * dh * 4, &layout, &size);
        if (owned != null) free(owned);
        owned = next;
        prev = next;
        w = dw;
        h = dh;
    }
    if (owned != null) free(owned);
}

// A Depth24Plus depth texture of width x height for a pass's depth attachment, matching a
// pipeline whose depth_format is left at its default. Make a new one when the target is
// resized.
Result<GpuTexture, string> Gpu_depth(*Gpu self, uint32 width, uint32 height) {
    return Gpu_texture(self, width, height, WGPUTextureFormat_Depth24Plus, WGPUTextureUsage_RenderAttachment);
}

// A depth texture with an 8-bit stencil (Depth24PlusStencil8, available on
// every device), for pipelines with that depth_format.
Result<GpuTexture, string> Gpu_depth_stencil(*Gpu self, uint32 width, uint32 height) {
    return Gpu_texture(self, width, height, WGPUTextureFormat_Depth24PlusStencil8, WGPUTextureUsage_RenderAttachment);
}

bool _gpu_has_stencil(WGPUTextureFormat f) {
    return f == WGPUTextureFormat_Depth24PlusStencil8 || f == WGPUTextureFormat_Depth32FloatStencil8 || f == WGPUTextureFormat_Stencil8;
}

// Replaces the texture's pixels (4 bytes each, rows packed).
void GpuTexture_write(*GpuTexture self, *void rgba) {
    WGPUTexelCopyTextureInfo dst = WGPUTexelCopyTextureInfo{texture: self.handle, aspect: WGPUTextureAspect_All};
    WGPUTexelCopyBufferLayout layout = WGPUTexelCopyBufferLayout{0, self.width * 4, self.height};
    WGPUExtent3D size = WGPUExtent3D{self.width, self.height, 1};
    wgpuQueueWriteTexture(self.gpu.queue, &dst, rgba, (uint64)self.width * self.height * 4, &layout, &size);
}

// Replaces a width x height rectangle of the texture's pixels at (x, y),
// from rows packed at the texture format's texel size (4 bytes for RGBA8):
// an atlas update or a scrolling tile layer.
void GpuTexture_write_region(*GpuTexture self, uint32 x, uint32 y, uint32 width, uint32 height, *void pixels) {
    uint32 texel = _gpu_texel_bytes(self.format);
    WGPUTexelCopyTextureInfo dst = WGPUTexelCopyTextureInfo{texture: self.handle, origin: WGPUOrigin3D{x, y, 0}, aspect: WGPUTextureAspect_All};
    WGPUTexelCopyBufferLayout layout = WGPUTexelCopyBufferLayout{0, width * texel, height};
    WGPUExtent3D size = WGPUExtent3D{width, height, 1};
    wgpuQueueWriteTexture(self.gpu.queue, &dst, pixels, (uint64)width * height * texel, &layout, &size);
}

// The size of a mip level in texel blocks (texels for uncompressed formats)
// and its bytes per row of blocks.
void _gpu_level_blocks(*GpuTexture t, uint32 mip, *uint32 bx, *uint32 by, *uint32 row) {
    uint32 bw = 1;
    uint32 bh = 1;
    uint32 bytes = 4;
    _gpu_format_block(t.format, &bw, &bh, &bytes);
    uint32 w = t.width >> mip;
    uint32 h = t.height >> mip;
    if (w == 0) w = 1;
    if (h == 0) h = 1;
    *bx = (w + bw - 1) / bw;
    *by = (h + bh - 1) / bh;
    *row = *bx * bytes;
}

// Replaces one mip level of one layer (a cube face: +X, -X, +Y, -Y, +Z, -Z)
// with data: rows packed at the format's texel size or, for a block-compressed
// format, rows of 4x4 (or ASTC-sized) blocks packed, a level smaller than a
// block still taking one whole block per row and column.
Result<int, string> GpuTexture_write_level(*GpuTexture self, uint32 layer, uint32 mip, *void data) {
    uint32 bx = 0;
    uint32 by = 0;
    uint32 row = 0;
    _gpu_level_blocks(self, mip, &bx, &by, &row);
    uint32 bw = 1;
    uint32 bh = 1;
    uint32 bytes = 4;
    _gpu_format_block(self.format, &bw, &bh, &bytes);
    _gpu_push(&self.gpu);
    WGPUTexelCopyTextureInfo dst = WGPUTexelCopyTextureInfo{texture: self.handle, mipLevel: mip, origin: WGPUOrigin3D{0, 0, layer}, aspect: WGPUTextureAspect_All};
    WGPUTexelCopyBufferLayout layout = WGPUTexelCopyBufferLayout{0, row, by};
    WGPUExtent3D size = WGPUExtent3D{bx * bw, by * bh, 1};
    wgpuQueueWriteTexture(self.gpu.queue, &dst, data, (uint64)row * by, &layout, &size);
    string err = _gpu_pop(&self.gpu, "write_level");
    if (err != null) return Err<int, string>(err);
    return Ok<int, string>(0);
}

// A view of part of the texture (see GpuViewDesc).
Result<GpuTextureView, string> GpuTexture_view_with(*GpuTexture self, *GpuViewDesc d) {
    uint32 layers = self.layers != 0 ? self.layers : (uint32)1;
    uint32 nl = d.layers != 0 ? d.layers : layers - d.base_layer;
    WGPUTextureViewDimension dim = d.dimension;
    if (dim == 0) dim = nl == 1 && self.dimension != WGPUTextureViewDimension_2DArray ? WGPUTextureViewDimension_2D : (self.dimension != 0 ? self.dimension : WGPUTextureViewDimension_2D);
    WGPUTextureFormat format = d.format != 0 ? d.format : self.format;
    uint32 nm = d.mips != 0 ? d.mips : self.mips - d.base_mip;
    _gpu_push(&self.gpu);
    WGPUTextureViewDescriptor vd = WGPUTextureViewDescriptor{format: format, dimension: dim, baseMipLevel: d.base_mip,
        mipLevelCount: nm, baseArrayLayer: d.base_layer, arrayLayerCount: nl,
        aspect: d.aspect != 0 ? d.aspect : WGPUTextureAspect_All};
    WGPUTextureView v = wgpuTextureCreateView(self.handle, &vd);
    string err = _gpu_pop(&self.gpu, "view");
    uint32 w = self.width >> d.base_mip;
    uint32 h = self.height >> d.base_mip;
    GpuTextureView out = GpuTextureView{v, format, w > 0 ? w : (uint32)1, h > 0 ? h : (uint32)1};
    if (err != null || v == null) {
        GpuTextureView_release(&out);
        return Err<GpuTextureView, string>(err != null ? err : _gpu_fail("view", null));
    }
    return Ok<GpuTextureView, string>(out);
}

// A 2D view of one layer (or cube face) and one mip level: a render target
// for that part of the texture.
Result<GpuTextureView, string> GpuTexture_view_level(*GpuTexture self, uint32 layer, uint32 mip) {
    GpuViewDesc d = GpuViewDesc{dimension: WGPUTextureViewDimension_2D, base_mip: mip, mips: 1, base_layer: layer, layers: 1};
    return GpuTexture_view_with(self, &d);
}

// The whole texture seen in another format, one of the view_formats it was
// made with (or the sRGB/linear twin of a surface's): sampled or rendered
// through an sRGB view, values are converted to and from linear light; through
// a linear view they are taken as they are.
Result<GpuTextureView, string> GpuTexture_view_as(*GpuTexture self, WGPUTextureFormat format) {
    GpuViewDesc d = GpuViewDesc{format: format, dimension: self.dimension};
    return GpuTexture_view_with(self, &d);
}

// Releases the view (not its texture); a second call does nothing.
void GpuTextureView_release(*GpuTextureView self) {
    if (self.view != null) wgpuTextureViewRelease(self.view);
    self.view = null;
}

// Records a copy of the texture into a new MapRead buffer with rows padded
// to 256 bytes, and submits it.
Result<GpuReadback, string> _gpu_read_start(*GpuTexture self, uint32 layer, uint32 mip) {
    *Gpu g = &self.gpu;
    if (self.samples > 1) return Err<GpuReadback, string>(_gpu_fail("read: a multisampled texture cannot be read back (read the target it resolves into)", null));
    uint32 bx = 0;
    uint32 by = 0;
    uint32 row = 0;
    _gpu_level_blocks(self, mip, &bx, &by, &row);
    uint32 bw = 1;
    uint32 bh = 1;
    uint32 bytes = 4;
    _gpu_format_block(self.format, &bw, &bh, &bytes);
    GpuReadback rb;
    rb.gpu = *g;
    rb.width = bx;
    rb.height = by;
    rb.row = row;
    rb.padded = (rb.row + 255) / 256 * 256;
    GpuBuffer staging = Gpu_buffer(g, (uint64)rb.padded * by, WGPUBufferUsage_MapRead | WGPUBufferUsage_CopyDst)?;
    rb.staging = staging.handle;
    _gpu_push(g);
    WGPUCommandEncoder enc = wgpuDeviceCreateCommandEncoder(g.device, null);
    WGPUTexelCopyTextureInfo src = WGPUTexelCopyTextureInfo{texture: self.handle, mipLevel: mip, origin: WGPUOrigin3D{0, 0, layer}, aspect: WGPUTextureAspect_All};
    WGPUTexelCopyBufferInfo dst = WGPUTexelCopyBufferInfo{WGPUTexelCopyBufferLayout{0, rb.padded, by}, rb.staging};
    WGPUExtent3D size = WGPUExtent3D{bx * bw, by * bh, 1};
    wgpuCommandEncoderCopyTextureToBuffer(enc, &src, &dst, &size);
    string err = _gpu_finish(g, enc, "read");
    if (err != null) {
        wgpuBufferRelease(rb.staging);
        return Err<GpuReadback, string>(err);
    }
    rb.wait = alloc<_GpuWait>(1);
    WGPUBufferMapCallbackInfo mi = WGPUBufferMapCallbackInfo{mode: WGPUCallbackMode_AllowSpontaneous, callback: (*void)_gpu_on_map, userdata1: rb.wait};
    rb.wait.future = wgpuBufferMapAsync(rb.staging, WGPUMapMode_Read, 0, (uint64)rb.padded * rb.height, mi).id;
    return Ok<GpuReadback, string>(rb);
}

// Copies the texture's pixels (rows packed) to out, after the work submitted
// so far has finished.
Result<int, string> GpuTexture_read(*GpuTexture self, *void out) {
    return GpuTexture_read_level(self, 0, 0, out);
}

// GpuTexture_read for one layer (or cube face) and mip level.
Result<int, string> GpuTexture_read_level(*GpuTexture self, uint32 layer, uint32 mip, *void out) {
    GpuReadback rb = _gpu_read_start(self, layer, mip)?;
    defer GpuReadback_release(&rb);
    return GpuReadback_take(&rb, out);
}

// Starts copying the texture's pixels back without waiting for the GPU: after
// the frame's submission, take the pixels once ready() says so (or call take(),
// which waits), then release the readback.
//
//     GpuReadback rb = target.read_async()?;
//     ...later frames:
//     if (rb.ready()) { rb.take(pixels)?; rb.release(); }
Result<GpuReadback, string> GpuTexture_read_async(*GpuTexture self) {
    return _gpu_read_start(self, 0, 0);
}

// Whether the pixels have arrived; it checks without blocking. In a browser, when they
// have not, it lets the browser run for a moment (its callbacks bring them).
bool GpuReadback_ready(*GpuReadback self) {
    if (self.wait == null) return false;
#ifdef __EMSCRIPTEN__
    if (self.wait.done == 0) emscripten_sleep(0);
#else
    if (self.wait.done == 0) wgpuDevicePoll(self.gpu.device, 0, null);
#endif
    return self.wait.done != 0;
}

// Copies the pixels (rows packed) to out, waiting for them if needed; once.
Result<int, string> GpuReadback_take(*GpuReadback self, *void out) {
    if (self.wait == null || self.staging == null) return Err<int, string>(_gpu_fail("read: no readback, or already taken", null));
    _gpu_wait(&self.gpu, self.wait);
    if (self.wait.done == 0 || self.wait.status != WGPUMapAsyncStatus_Success) return Err<int, string>(_gpu_fail("read", &self.wait.msg));
    uint64 bytes = (uint64)self.padded * self.height;
    *uint8 rows = (*uint8)wgpuBufferGetConstMappedRange(self.staging, 0, bytes);
    for (y in 0..self.height) {
        memcpy((*uint8)out + (uint64)y * self.row, rows + (uint64)y * self.padded, (int64)self.row);
    }
    wgpuBufferUnmap(self.staging);
    wgpuBufferRelease(self.staging);
    self.staging = null;
    return Ok<int, string>(0);
}

// Waits for the copy if it is still on its way, then frees the staging buffer, whether or
// not the pixels were taken.
void GpuReadback_release(*GpuReadback self) {
    if (self.wait != null) {
        _gpu_wait(&self.gpu, self.wait);
        String_free(&self.wait.msg);
        free(self.wait);
    }
    if (self.staging != null) wgpuBufferRelease(self.staging);
    self.wait = null;
    self.staging = null;
}

// Releases the texture and its view; a second call does nothing. Views made from it with
// view_with or view_as are released separately.
void GpuTexture_release(*GpuTexture self) {
    if (self.view != null) wgpuTextureViewRelease(self.view);
    if (self.handle != null) wgpuTextureRelease(self.handle);
    self.view = null;
    self.handle = null;
}

// A sampler that repeats the texture; linear filtering when linear is true,
// nearest otherwise. Gpu_sampler_with takes the other settings.
Result<GpuSampler, string> Gpu_sampler(*Gpu self, bool linear) {
    GpuSamplerOptions o = GpuSamplerOptions{nearest: !linear};
    return Gpu_sampler_with(self, &o);
}

// A sampler with the settings in o (see GpuSamplerOptions). Anisotropy is used only with
// linear filtering and mipmaps; the third wrap axis (W) always repeats.
Result<GpuSampler, string> Gpu_sampler_with(*Gpu self, *GpuSamplerOptions o) {
    WGPUFilterMode f = o.nearest ? WGPUFilterMode_Nearest : WGPUFilterMode_Linear;
    WGPUAddressMode u = o.wrap_u != 0 ? o.wrap_u : WGPUAddressMode_Repeat;
    WGPUAddressMode v = o.wrap_v != 0 ? o.wrap_v : WGPUAddressMode_Repeat;
    uint16 aniso = o.anisotropy > 1 && !o.nearest && o.mipmaps ? o.anisotropy : (uint16)1;
    _gpu_push(self);
    WGPUSamplerDescriptor d = WGPUSamplerDescriptor{addressModeU: u, addressModeV: v,
        addressModeW: WGPUAddressMode_Repeat, magFilter: f, minFilter: f,
        mipmapFilter: o.mipmaps && !o.nearest ? WGPUMipmapFilterMode_Linear : WGPUMipmapFilterMode_Nearest,
        lodMinClamp: 0.0, lodMaxClamp: 32.0, compare: o.compare, maxAnisotropy: aniso};
    WGPUSampler s = wgpuDeviceCreateSampler(self.device, &d);
    string err = _gpu_pop(self, "sampler");
    if (err != null) return Err<GpuSampler, string>(err);
    return Ok<GpuSampler, string>(GpuSampler{s});
}

// Releases the sampler; a second call does nothing.
void GpuSampler_release(*GpuSampler self) {
    if (self.handle != null) wgpuSamplerRelease(self.handle);
    self.handle = null;
}

// Adds an attribute of format at byte offset offset in each vertex, at the next @location
// (location plus the number of attributes added before).
void GpuVertexLayout_add(*GpuVertexLayout self, WGPUVertexFormat format, uint64 offset) {
    List_push(&self.attrs, WGPUVertexAttribute{format: format, offset: offset, shaderLocation: self.location + (uint32)self.attrs.size});
}

// Frees the attribute list. A pipeline keeps no reference to its layouts, so they can be
// released once Gpu_pipeline returns.
void GpuVertexLayout_release(*GpuVertexLayout self) {
    List_free(&self.attrs);
}

WGPUBlendState _gpu_blend_state(GpuBlend mode) {
    WGPUBlendComponent over = WGPUBlendComponent{WGPUBlendOperation_Add, WGPUBlendFactor_One, WGPUBlendFactor_OneMinusSrcAlpha};
    if (mode == GPU_BLEND_PREMULTIPLIED) return WGPUBlendState{over, over};
    if (mode == GPU_BLEND_ADDITIVE) {
        return WGPUBlendState{WGPUBlendComponent{WGPUBlendOperation_Add, WGPUBlendFactor_SrcAlpha, WGPUBlendFactor_One},
            WGPUBlendComponent{WGPUBlendOperation_Add, WGPUBlendFactor_Zero, WGPUBlendFactor_One}};
    }
    if (mode == GPU_BLEND_MULTIPLY) {
        return WGPUBlendState{WGPUBlendComponent{WGPUBlendOperation_Add, WGPUBlendFactor_Dst, WGPUBlendFactor_Zero},
            WGPUBlendComponent{WGPUBlendOperation_Add, WGPUBlendFactor_Zero, WGPUBlendFactor_One}};
    }
    if (mode == GPU_BLEND_CONSTANT) {
        WGPUBlendComponent mix = WGPUBlendComponent{WGPUBlendOperation_Add, WGPUBlendFactor_Constant, WGPUBlendFactor_OneMinusConstant};
        return WGPUBlendState{mix, mix};
    }
    return WGPUBlendState{WGPUBlendComponent{WGPUBlendOperation_Add, WGPUBlendFactor_SrcAlpha, WGPUBlendFactor_OneMinusSrcAlpha}, over};
}

WGPUStencilFaceState _gpu_stencil_face(GpuStencilFace f) {
    return WGPUStencilFaceState{f.compare != 0 ? f.compare : WGPUCompareFunction_Always,
        f.fail != 0 ? f.fail : WGPUStencilOperation_Keep,
        f.depth_fail != 0 ? f.depth_fail : WGPUStencilOperation_Keep,
        f.pass != 0 ? f.pass : WGPUStencilOperation_Keep};
}

// A render pipeline from d (see GpuPipelineDesc). Fails with the WGSL compiler's or the
// validation layer's message, or when d lists more than 8 vertex buffers, bind groups or
// color targets.
Result<GpuPipeline, string> Gpu_pipeline(*Gpu self, *GpuPipelineDesc d) {
    GpuPipeline p;
    p.gpu = *self;
    _gpu_push(self);
    p.module = _gpu_module(self, d.wgsl);
    string err = _gpu_pop(self, "shader");
    if (err != null) {
        GpuPipeline_release(&p);
        return Err<GpuPipeline, string>(err);
    }
    *GpuVertexLayout vls = d.layout_count > 0 ? d.layouts : d.layout;
    uint32 nbuf = d.layout_count > 0 ? d.layout_count : (d.layout != null ? (uint32)1 : (uint32)0);
    if (nbuf > 8) {
        GpuPipeline_release(&p);
        return Err<GpuPipeline, string>(_gpu_fail("pipeline: more than 8 vertex buffers", null));
    }
    WGPUVertexBufferLayout[8] vb;
    for (i in 0..nbuf) {
        vb[i] = WGPUVertexBufferLayout{stepMode: vls[i].step != 0 ? vls[i].step : WGPUVertexStepMode_Vertex, arrayStride: vls[i].stride,
            attributeCount: (uint64)vls[i].attrs.size, attributes: vls[i].attrs.data};
    }
    if (d.group_count > 0) {
        WGPUBindGroupLayout[8] bgl;
        if (d.group_count > 8) {
            GpuPipeline_release(&p);
            return Err<GpuPipeline, string>(_gpu_fail("pipeline: more than 8 bind groups", null));
        }
        for (i in 0..d.group_count) {
            Result<int, string> made = _gpu_bind_layout_make(d.groups[i]);
            if (!made.ok) {
                GpuPipeline_release(&p);
                return Err<GpuPipeline, string>(made.error);
            }
            bgl[i] = d.groups[i].handle;
        }
        _gpu_push(self);
        WGPUPipelineLayoutDescriptor pld = WGPUPipelineLayoutDescriptor{bindGroupLayoutCount: (uint64)d.group_count, bindGroupLayouts: &bgl[0]};
        p.pipeline_layout = wgpuDeviceCreatePipelineLayout(self.device, &pld);
        err = _gpu_pop(self, "pipeline layout");
        if (err != null) {
            GpuPipeline_release(&p);
            return Err<GpuPipeline, string>(err);
        }
    }
    if (d.target_count > 8) {
        GpuPipeline_release(&p);
        return Err<GpuPipeline, string>(_gpu_fail("pipeline: more than 8 color targets", null));
    }
    WGPUColorTargetState[8] targets;
    WGPUBlendState[8] blends;
    uint32 ntargets = d.target_count > 0 ? d.target_count : (uint32)1;
    for (i in 0..ntargets) {
        GpuColorTarget ct = GpuColorTarget{d.format, d.blend_mode, d.blend_state, d.no_color_write};
        if (d.target_count > 0) ct = d.targets[i];
        else if (ct.blend_mode == GPU_BLEND_NONE && d.blend) ct.blend_mode = GPU_BLEND_ALPHA;
        blends[i] = _gpu_blend_state(ct.blend_mode);
        targets[i] = WGPUColorTargetState{format: ct.format, writeMask: ct.no_color_write ? WGPUColorWriteMask_None : WGPUColorWriteMask_All};
        if (ct.blend_state != null) targets[i].blend = ct.blend_state;
        else if (ct.blend_mode != GPU_BLEND_NONE) targets[i].blend = &blends[i];
    }
    WGPUFragmentState frag = WGPUFragmentState{module: p.module, entryPoint: gpu_str(d.fragment), targetCount: (uint64)ntargets, targets: &targets[0]};
    WGPUTextureFormat dfmt = d.depth_format != 0 ? d.depth_format : WGPUTextureFormat_Depth24Plus;
    GpuStencilFace back = d.stencil_back;
    if (back.compare == 0 && back.fail == 0 && back.depth_fail == 0 && back.pass == 0) back = d.stencil_front;
    WGPUDepthStencilState ds = WGPUDepthStencilState{format: dfmt,
        depthWriteEnabled: d.depth_read_only ? WGPUOptionalBool_False : WGPUOptionalBool_True,
        depthCompare: d.depth_compare != 0 ? d.depth_compare : WGPUCompareFunction_Less,
        stencilFront: _gpu_stencil_face(d.stencil_front), stencilBack: _gpu_stencil_face(back),
        stencilReadMask: d.stencil_read_mask != 0 ? d.stencil_read_mask : (uint32)0xFF,
        stencilWriteMask: d.stencil_write_mask != 0 ? d.stencil_write_mask : (uint32)0xFF,
        depthBias: d.depth_bias, depthBiasSlopeScale: d.depth_bias_slope};
    if (dfmt == WGPUTextureFormat_Stencil8) {
        ds.depthWriteEnabled = WGPUOptionalBool_False;
        ds.depthCompare = WGPUCompareFunction_Always;
    }
    WGPURenderPipelineDescriptor rd = WGPURenderPipelineDescriptor{layout: p.pipeline_layout,
        vertex: WGPUVertexState{module: p.module, entryPoint: gpu_str(d.vertex), bufferCount: (uint64)nbuf, buffers: &vb[0]},
        primitive: WGPUPrimitiveState{topology: d.topology != 0 ? d.topology : WGPUPrimitiveTopology_TriangleList,
            frontFace: WGPUFrontFace_CCW, cullMode: d.cull != 0 ? d.cull : WGPUCullMode_None},
        multisample: WGPUMultisampleState{count: d.samples != 0 ? d.samples : (uint32)1, mask: 0xFFFFFFFF},
        fragment: &frag};
    if (d.fragment == null) rd.fragment = null;
    if (d.depth) rd.depthStencil = &ds;
    _gpu_push(self);
    p.handle = wgpuDeviceCreateRenderPipeline(self.device, &rd);
    err = _gpu_pop(self, "pipeline");
    if (err != null) {
        GpuPipeline_release(&p);
        return Err<GpuPipeline, string>(err);
    }
    return Ok<GpuPipeline, string>(p);
}

// Sets entry e.binding in entries, replacing an entry of the same binding.
void _gpu_set_entry(List<WGPUBindGroupEntry>* entries, WGPUBindGroupEntry e) {
    for (i in 0..entries.size) {
        if (entries.data[i].binding == e.binding) {
            entries.data[i] = e;
            return;
        }
    }
    List_push(entries, e);
}

void _gpu_pipeline_entry(*GpuPipeline self, WGPUBindGroupEntry e) {
    if (self.layout == null) self.layout = wgpuRenderPipelineGetBindGroupLayout(self.handle, 0);
    _gpu_set_entry(&self.entries, e);
    self.group_stale = true;
}

// Binds the whole of b (a uniform or storage buffer) to @binding(binding) of group 0,
// replacing what was bound there, for the next draws with this pipeline.
void GpuPipeline_bind(*GpuPipeline self, uint32 binding, *GpuBuffer b) {
    _gpu_pipeline_entry(self, WGPUBindGroupEntry{binding: binding, buffer: b.handle, size: b.size});
}

// Binds the texture's own view (the whole texture) to @binding(binding) of group 0.
void GpuPipeline_bind_texture(*GpuPipeline self, uint32 binding, *GpuTexture t) {
    _gpu_pipeline_entry(self, WGPUBindGroupEntry{binding: binding, textureView: t.view});
}

// Binds a texture view (one layer, a cube, a texture in another format).
void GpuPipeline_bind_view(*GpuPipeline self, uint32 binding, *GpuTextureView v) {
    _gpu_pipeline_entry(self, WGPUBindGroupEntry{binding: binding, textureView: v.view});
}

// Binds s to @binding(binding) of group 0.
void GpuPipeline_bind_sampler(*GpuPipeline self, uint32 binding, *GpuSampler s) {
    _gpu_pipeline_entry(self, WGPUBindGroupEntry{binding: binding, sampler: s.handle});
}

// Releases the pipeline, its shader module, layouts and bind group, and the list of
// bindings (not the bound resources).
void GpuPipeline_release(*GpuPipeline self) {
    if (self.group != null) wgpuBindGroupRelease(self.group);
    if (self.layout != null) wgpuBindGroupLayoutRelease(self.layout);
    if (self.handle != null) wgpuRenderPipelineRelease(self.handle);
    if (self.pipeline_layout != null) wgpuPipelineLayoutRelease(self.pipeline_layout);
    if (self.module != null) wgpuShaderModuleRelease(self.module);
    List_free(&self.entries);
    self.group = null;
    self.layout = null;
    self.handle = null;
    self.pipeline_layout = null;
    self.module = null;
}

// An empty bind group layout; add its entries, then name it in
// GpuPipelineDesc.groups and make groups from it with group().
GpuBindLayout Gpu_bind_layout(*Gpu self) {
    GpuBindLayout l;
    l.gpu = *self;
    return l;
}

WGPUShaderStage _gpu_visibility(WGPUShaderStage v) {
    return v != 0 ? v : WGPUShaderStage_Vertex | WGPUShaderStage_Fragment;
}

// A uniform buffer (var<uniform>) at binding.
void GpuBindLayout_uniform(*GpuBindLayout self, uint32 binding, WGPUShaderStage visibility) {
    List_push(&self.entries, WGPUBindGroupLayoutEntry{binding: binding, visibility: _gpu_visibility(visibility),
        buffer: WGPUBufferBindingLayout{type_: WGPUBufferBindingType_Uniform}});
}

// A storage buffer (var<storage, read> when read_only, else read_write; the
// vertex stage may only read).
void GpuBindLayout_storage(*GpuBindLayout self, uint32 binding, WGPUShaderStage visibility, bool read_only) {
    WGPUBufferBindingType t = read_only ? WGPUBufferBindingType_ReadOnlyStorage : WGPUBufferBindingType_Storage;
    List_push(&self.entries, WGPUBindGroupLayoutEntry{binding: binding, visibility: _gpu_visibility(visibility),
        buffer: WGPUBufferBindingLayout{type_: t}});
}

// A texture; sample_type is a WGPUTextureSampleType (0 is Float, the
// filterable kind; UnfilterableFloat goes with a NonFiltering sampler; Depth
// is a depth texture, texture_depth_2d in WGSL, sampled with a Comparison or
// NonFiltering sampler) and dimension a WGPUTextureViewDimension (2D when
// left out or 0; 2DArray for texture_2d_array and texture_depth_2d_array;
// Cube for texture_cube).
void GpuBindLayout_texture(*GpuBindLayout self, uint32 binding, WGPUShaderStage visibility, WGPUTextureSampleType sample_type, WGPUTextureViewDimension dimension = WGPUTextureViewDimension_2D) {
    List_push(&self.entries, WGPUBindGroupLayoutEntry{binding: binding, visibility: _gpu_visibility(visibility),
        texture: WGPUTextureBindingLayout{sampleType: sample_type != 0 ? sample_type : WGPUTextureSampleType_Float,
            viewDimension: dimension != 0 ? dimension : WGPUTextureViewDimension_2D}});
}

// A sampler; kind is a WGPUSamplerBindingType (0 is Filtering; NonFiltering
// for nearest-only samplers over unfilterable textures; Comparison).
void GpuBindLayout_sampler(*GpuBindLayout self, uint32 binding, WGPUShaderStage visibility, WGPUSamplerBindingType kind) {
    List_push(&self.entries, WGPUBindGroupLayoutEntry{binding: binding, visibility: _gpu_visibility(visibility),
        sampler: WGPUSamplerBindingLayout{type_: kind != 0 ? kind : WGPUSamplerBindingType_Filtering}});
}

// Makes the WebGPU layout the first time it is needed.
Result<int, string> _gpu_bind_layout_make(*GpuBindLayout self) {
    if (self.handle != null) return Ok<int, string>(0);
    _gpu_push(&self.gpu);
    WGPUBindGroupLayoutDescriptor d = WGPUBindGroupLayoutDescriptor{entryCount: (uint64)self.entries.size, entries: self.entries.data};
    self.handle = wgpuDeviceCreateBindGroupLayout(self.gpu.device, &d);
    string err = _gpu_pop(&self.gpu, "bind layout");
    if (err != null) {
        if (self.handle != null) wgpuBindGroupLayoutRelease(self.handle);
        self.handle = null;
        return Err<int, string>(err);
    }
    return Ok<int, string>(0);
}

// A bind group for this layout, to fill with buffer(), texture() and
// sampler(). It keeps the layout alive.
Result<GpuBindGroup, string> GpuBindLayout_group(*GpuBindLayout self) {
    _gpu_bind_layout_make(self)?;
    wgpuBindGroupLayoutAddRef(self.handle);
    GpuBindGroup g;
    g.gpu = self.gpu;
    g.layout = self.handle;
    return Ok<GpuBindGroup, string>(g);
}

// Releases the layout and its entry list. Pipelines and bind groups made from it hold
// their own reference, so it can be released before them.
void GpuBindLayout_release(*GpuBindLayout self) {
    if (self.handle != null) wgpuBindGroupLayoutRelease(self.handle);
    List_free(&self.entries);
    self.handle = null;
}

// Sets the whole of b to binding binding, replacing what was there; the bind group is
// rebuilt at its next use.
void GpuBindGroup_buffer(*GpuBindGroup self, uint32 binding, *GpuBuffer b) {
    _gpu_set_entry(&self.entries, WGPUBindGroupEntry{binding: binding, buffer: b.handle, size: b.size});
    self.stale = true;
}

// Sets the texture's own view (the whole texture) to binding binding; the bind group is
// rebuilt at its next use.
void GpuBindGroup_texture(*GpuBindGroup self, uint32 binding, *GpuTexture t) {
    _gpu_set_entry(&self.entries, WGPUBindGroupEntry{binding: binding, textureView: t.view});
    self.stale = true;
}

// Sets a texture view (one layer, a cube, a texture in another format).
void GpuBindGroup_view(*GpuBindGroup self, uint32 binding, *GpuTextureView v) {
    _gpu_set_entry(&self.entries, WGPUBindGroupEntry{binding: binding, textureView: v.view});
    self.stale = true;
}

// Sets s to binding binding; the bind group is rebuilt at its next use.
void GpuBindGroup_sampler(*GpuBindGroup self, uint32 binding, *GpuSampler s) {
    _gpu_set_entry(&self.entries, WGPUBindGroupEntry{binding: binding, sampler: s.handle});
    self.stale = true;
}

// Releases the bind group, its reference to the layout, and the entry list (not the
// resources in it).
void GpuBindGroup_release(*GpuBindGroup self) {
    if (self.handle != null) wgpuBindGroupRelease(self.handle);
    if (self.layout != null) wgpuBindGroupLayoutRelease(self.layout);
    List_free(&self.entries);
    self.handle = null;
    self.layout = null;
}

// The bind group for layout and entries: cached in *group, rebuilt when stale.
// A replaced group is kept by the pass until it ends, since the commands
// recorded so far may use it.
void _gpu_group_for(*GpuPass self, WGPUBindGroupLayout layout, List<WGPUBindGroupEntry>* entries, *WGPUBindGroup group, *bool stale) {
    if (*group != null && !*stale) return;
    if (*group != null) List_push(&self.groups, *group);
    WGPUBindGroupDescriptor bd = WGPUBindGroupDescriptor{layout: layout, entryCount: (uint64)entries.size, entries: entries.data};
    *group = wgpuDeviceCreateBindGroup(self.gpu.device, &bd);
    *stale = false;
}

// A command encoder for several passes and one submission.
GpuEncoder Gpu_encoder(*Gpu self) {
    GpuEncoder e;
    e.gpu = *self;
    _gpu_push(self);
    e.enc = wgpuDeviceCreateCommandEncoder(self.device, null);
    return e;
}

WGPURenderPassColorAttachment _gpu_color_attachment(GpuColorAttachment a) {
    return WGPURenderPassColorAttachment{view: a.view, depthSlice: WGPU_DEPTH_SLICE_UNDEFINED,
        resolveTarget: a.resolve, loadOp: a.load ? WGPULoadOp_Load : WGPULoadOp_Clear,
        storeOp: a.discard ? WGPUStoreOp_Discard : WGPUStoreOp_Store, clearValue: a.clear};
}

void _gpu_begin(*GpuPass p, WGPUTextureView target, *GpuPassOptions o) {
    WGPURenderPassColorAttachment[8] colors;
    uint32 ncolors = 0;
    if (o.color_count > 8) {
        p.err = "pass: more than 8 color attachments";
    } else if (o.color_count > 0 && target != null) {
        p.err = "pass: a target and colors given; with colors, pass a null target";
    } else if (o.color_count > 0) {
        for (i in 0..o.color_count) colors[i] = _gpu_color_attachment(o.colors[i]);
        ncolors = o.color_count;
    } else if (target != null) {
        colors[0] = _gpu_color_attachment(GpuColorAttachment{target, o.clear, o.load, o.resolve, o.discard});
        ncolors = 1;
    }
    WGPURenderPassDepthStencilAttachment da;
    WGPURenderPassDescriptor rd = WGPURenderPassDescriptor{colorAttachmentCount: (uint64)ncolors, colorAttachments: &colors[0]};
    if (o.depth != null || o.depth_view != null) {
        // Each aspect's ops are given only when the format has it: ops for a
        // missing aspect are a validation error.
        WGPUTextureFormat df = o.depth_view != null ? o.depth_view.format : o.depth.format;
        da = WGPURenderPassDepthStencilAttachment{view: o.depth_view != null ? o.depth_view.view : o.depth.view};
        p.depth_format = df;
        if (df != WGPUTextureFormat_Stencil8) {
            da.depthLoadOp = o.depth_load ? WGPULoadOp_Load : WGPULoadOp_Clear;
            da.depthStoreOp = WGPUStoreOp_Store;
            da.depthClearValue = 1.0;
        }
        if (_gpu_has_stencil(df)) {
            da.stencilLoadOp = o.stencil_load ? WGPULoadOp_Load : WGPULoadOp_Clear;
            da.stencilStoreOp = WGPUStoreOp_Store;
            da.stencilClearValue = o.stencil_clear;
        }
        rd.depthStencilAttachment = &da;
    }
    p.pass = wgpuCommandEncoderBeginRenderPass(p.enc, &rd);
}

// A pass recorded into the encoder: end() closes it, and the encoder's
// submit() sends it with the others and reports its errors.
GpuPass GpuEncoder_pass(*GpuEncoder self, WGPUTextureView target, GpuColor clear, *GpuTexture depth) {
    GpuPassOptions o = GpuPassOptions{clear: clear, depth: depth};
    return GpuEncoder_pass_with(self, target, &o);
}

// GpuEncoder_pass with every attachment setting of GpuPassOptions (load instead of clear,
// stencil, multisample resolve, several color targets).
GpuPass GpuEncoder_pass_with(*GpuEncoder self, WGPUTextureView target, *GpuPassOptions o) {
    GpuPass p;
    p.gpu = self.gpu;
    p.enc = self.enc;
    p.encoder = self;
    _gpu_begin(&p, target, o);
    return p;
}

// Sends the passes to the GPU and reports the errors of the whole frame.
Result<int, string> GpuEncoder_submit(*GpuEncoder self) {
    string err = _gpu_finish(&self.gpu, self.enc, "frame");
    self.enc = null;
    for (i in 0..self.groups.size) wgpuBindGroupRelease(self.groups.data[i]);
    List_free(&self.groups);
    if (err != null) return Err<int, string>(err);
    return Ok<int, string>(0);
}

// Finishes enc and pops the error scope pushed when it was made; the commands
// are submitted only when they are valid (wgpu-native aborts on submitting
// invalid ones). Releases enc.
string _gpu_finish(*Gpu g, WGPUCommandEncoder enc, string what) {
    WGPUCommandBuffer cmd = wgpuCommandEncoderFinish(enc, null);
    wgpuCommandEncoderRelease(enc);
#ifdef __EMSCRIPTEN__
    // The wait for the scope lets the browser run, and a canvas texture expires at the
    // next display refresh: the work goes to the queue before that wait.
    if (cmd != null) wgpuQueueSubmit(g.queue, 1, &cmd);
    string err = _gpu_pop(g, what);
#else
    string err = _gpu_pop(g, what);
    if (err == null && cmd != null) wgpuQueueSubmit(g.queue, 1, &cmd);
#endif
    if (cmd != null) wgpuCommandBufferRelease(cmd);
    return err;
}

// Starts a render pass that clears target to clear (and depth, when given, to
// 1.0). Errors in the pass are reported by end().
GpuPass Gpu_pass(*Gpu self, WGPUTextureView target, GpuColor clear, *GpuTexture depth) {
    GpuPassOptions o = GpuPassOptions{clear: clear, depth: depth};
    return Gpu_pass_with(self, target, &o);
}

// Gpu_pass with load ops per attachment: a pass that draws over what an
// earlier pass left (a UI over the scene).
GpuPass Gpu_pass_with(*Gpu self, WGPUTextureView target, *GpuPassOptions o) {
    GpuPass p;
    p.gpu = *self;
    _gpu_push(self);
    p.enc = wgpuDeviceCreateCommandEncoder(self.device, null);
    _gpu_begin(&p, target, o);
    return p;
}

void _gpu_pass_setup(*GpuPass self, *GpuPipeline pipe, *GpuBuffer vertices) {
    wgpuRenderPassEncoderSetPipeline(self.pass, pipe.handle);
    if (pipe.entries.size > 0) {
        _gpu_group_for(self, pipe.layout, &pipe.entries, &pipe.group, &pipe.group_stale);
        wgpuRenderPassEncoderSetBindGroup(self.pass, 0, pipe.group, 0, null);
    }
    if (vertices != null) wgpuRenderPassEncoderSetVertexBuffer(self.pass, 0, vertices.handle, 0, vertices.size);
}

// Sets bind group index for the draws that follow (it stays set across
// pipelines whose layouts agree on it).
void GpuPass_set_group(*GpuPass self, uint32 index, *GpuBindGroup g) {
    _gpu_group_for(self, g.layout, &g.entries, &g.handle, &g.stale);
    wgpuRenderPassEncoderSetBindGroup(self.pass, index, g.handle, 0, null);
}

// Sets vertex buffer slot for the draws that follow; slot 0 is also set by
// the vertices argument of draw() when it is not null.
void GpuPass_set_vertices(*GpuPass self, uint32 slot, *GpuBuffer b) {
    wgpuRenderPassEncoderSetVertexBuffer(self.pass, slot, b.handle, 0, b.size);
}

// Clips the draws that follow to a rectangle of the target, in pixels from
// the top left.
void GpuPass_set_scissor(*GpuPass self, uint32 x, uint32 y, uint32 width, uint32 height) {
    wgpuRenderPassEncoderSetScissorRect(self.pass, x, y, width, height);
}

// Maps clip space to a rectangle of the target, in pixels from the top left,
// and depth to min_depth..max_depth.
void GpuPass_set_viewport(*GpuPass self, float x, float y, float width, float height, float min_depth = 0.0, float max_depth = 1.0) {
    wgpuRenderPassEncoderSetViewport(self.pass, x, y, width, height, min_depth, max_depth);
}

// The reference value of the stencil tests (and of the Replace op) for the
// draws that follow; 0 when the pass starts.
void GpuPass_set_stencil_reference(*GpuPass self, uint32 reference) {
    wgpuRenderPassEncoderSetStencilReference(self.pass, reference);
}

// The constant of the GPU_BLEND_CONSTANT preset and of WGPUBlendFactor_Constant.
void GpuPass_set_blend_constant(*GpuPass self, GpuColor c) {
    wgpuRenderPassEncoderSetBlendConstant(self.pass, &c);
}

// Draws count vertices instances times; vertices may be null for a shader
// that makes its own (from @builtin(vertex_index)) or for buffers set with
// set_vertices().
void GpuPass_draw(*GpuPass self, *GpuPipeline pipe, *GpuBuffer vertices, uint32 count, uint32 instances) {
    _gpu_pass_setup(self, pipe, vertices);
    wgpuRenderPassEncoderDraw(self.pass, count, instances, 0, 0);
}

// GpuPass_draw from vertex first and instance first_instance.
void GpuPass_draw_range(*GpuPass self, *GpuPipeline pipe, *GpuBuffer vertices, uint32 first, uint32 count, uint32 first_instance, uint32 instances) {
    _gpu_pass_setup(self, pipe, vertices);
    wgpuRenderPassEncoderDraw(self.pass, count, instances, first, first_instance);
}

// Draws count indices from the uint32 index buffer indices, instances times, with the
// vertices of vertices (or of the buffers set with set_vertices() when vertices is null).
void GpuPass_draw_indexed(*GpuPass self, *GpuPipeline pipe, *GpuBuffer vertices, *GpuBuffer indices, uint32 count, uint32 instances) {
    _gpu_pass_setup(self, pipe, vertices);
    wgpuRenderPassEncoderSetIndexBuffer(self.pass, indices.handle, WGPUIndexFormat_Uint32, 0, indices.size);
    wgpuRenderPassEncoderDrawIndexed(self.pass, count, instances, 0, 0, 0);
}

// Ends the pass and submits it; a pass from a GpuEncoder is submitted (and
// its errors reported) by the encoder's submit().
Result<int, string> GpuPass_end(*GpuPass self) {
    *Gpu g = &self.gpu;
    wgpuRenderPassEncoderEnd(self.pass);
    wgpuRenderPassEncoderRelease(self.pass);
    self.pass = null;
    if (self.encoder != null) {
        for (i in 0..self.groups.size) List_push(&self.encoder.groups, self.groups.data[i]);
        List_free(&self.groups);
        if (self.err != null) return Err<int, string>(_gpu_fail(self.err, null));
        return Ok<int, string>(0);
    }
    string err = _gpu_finish(g, self.enc, "render pass");
    self.enc = null;
    for (i in 0..self.groups.size) wgpuBindGroupRelease(self.groups.data[i]);
    List_free(&self.groups);
    if (self.err != null) return Err<int, string>(_gpu_fail(self.err, null));
    if (err != null) return Err<int, string>(err);
    return Ok<int, string>(0);
}

string _gpu_mip_shader =
    "@group(0) @binding(0) var src: texture_2d<f32>;\n"
    "@vertex fn vs(@builtin(vertex_index) i: u32) -> @builtin(position) vec4<f32> {\n"
    "    let p = vec2<f32>(f32((i << 1u) & 2u), f32(i & 2u));\n"
    "    return vec4<f32>(p * 2.0 - 1.0, 0.0, 1.0);\n"
    "}\n"
    "@fragment fn fs(@builtin(position) pos: vec4<f32>) -> @location(0) vec4<f32> {\n"
    "    let last = vec2<i32>(textureDimensions(src)) - vec2<i32>(1, 1);\n"
    "    let o = vec2<i32>(pos.xy) * 2;\n"
    "    let a = textureLoad(src, min(o, last), 0);\n"
    "    let b = textureLoad(src, min(o + vec2<i32>(1, 0), last), 0);\n"
    "    let c = textureLoad(src, min(o + vec2<i32>(0, 1), last), 0);\n"
    "    let d = textureLoad(src, min(o + vec2<i32>(1, 1), last), 0);\n"
    "    return (a + b + c + d) * 0.25;\n"
    "}\n";

// Fills mip levels 1 and up of every layer (and cube face) from level 0, on
// the GPU: each texel of a level is the average of the 2x2 texels under it
// (the last row or column repeats for odd sizes), in linear light for sRGB
// formats. WebGPU has no mipmap call, so it is a render pass per level and
// layer; the texture needs RenderAttachment and TextureBinding usage (the
// Gpu_texture_with default for renderable formats) and a renderable float or
// normalized format (RGBA8, BGRA8, sRGB, RGBA16Float, RGBA32Float...).
// Call it after writing or rendering level 0, such as an environment cube.
Result<int, string> GpuTexture_generate_mips(*GpuTexture self) {
    if (self.mips <= 1) return Ok<int, string>(0);
    *Gpu g = &self.gpu;
    if (!_gpu_renderable(self.format) || _gpu_is_integer(self.format) || self.samples > 1) {
        return Err<int, string>(_gpu_fail("generate_mips: the format cannot be rendered into and filtered", null));
    }
    WGPUTextureUsage need = WGPUTextureUsage_RenderAttachment | WGPUTextureUsage_TextureBinding;
    if (self.usage != 0 && (self.usage & need) != need) {
        return Err<int, string>(_gpu_fail("generate_mips: the texture needs RenderAttachment and TextureBinding usage", null));
    }
#ifdef __EMSCRIPTEN__
    // WebGL2 cannot sample one layer of a cube or array texture as a 2D texture, so the
    // backend makes the levels itself, with the same 2x2 box filter.
    if (g.webgl2) {
        _gpu_push(g);
        wgpuTextureSetLabel(self.handle, gpu_str("__gpu_generate_mipmap"));
        string merr = _gpu_pop(g, "generate_mips");
        if (merr != null) return Err<int, string>(merr);
        return Ok<int, string>(0);
    }
#endif
    GpuBindLayout bl = Gpu_bind_layout(g);
    defer GpuBindLayout_release(&bl);
    GpuBindLayout_texture(&bl, 0, WGPUShaderStage_Fragment, WGPUTextureSampleType_UnfilterableFloat);
    *GpuBindLayout[1] groups = {&bl};
    GpuPipelineDesc d = GpuPipelineDesc{wgsl: _gpu_mip_shader, vertex: "vs", fragment: "fs", format: self.format,
        groups: &groups[0], group_count: 1};
    GpuPipeline pipe = Gpu_pipeline(g, &d)?;
    defer GpuPipeline_release(&pipe);
    List<WGPUTextureView> views;
    List<WGPUBindGroup> made;
    _gpu_push(g);
    WGPUCommandEncoder enc = wgpuDeviceCreateCommandEncoder(g.device, null);
    uint32 layers = self.layers != 0 ? self.layers : (uint32)1;
    for (layer in 0..layers) {
        for (level in 1..self.mips) {
            WGPUTextureViewDescriptor sd = WGPUTextureViewDescriptor{format: self.format, dimension: WGPUTextureViewDimension_2D,
                baseMipLevel: level - 1, mipLevelCount: 1, baseArrayLayer: layer, arrayLayerCount: 1, aspect: WGPUTextureAspect_All};
            WGPUTextureView src = wgpuTextureCreateView(self.handle, &sd);
            sd.baseMipLevel = level;
            WGPUTextureView dst = wgpuTextureCreateView(self.handle, &sd);
            List_push(&views, src);
            List_push(&views, dst);
            WGPUBindGroupEntry e = WGPUBindGroupEntry{binding: 0, textureView: src};
            WGPUBindGroupDescriptor bd = WGPUBindGroupDescriptor{layout: bl.handle, entryCount: 1, entries: &e};
            WGPUBindGroup bg = wgpuDeviceCreateBindGroup(g.device, &bd);
            List_push(&made, bg);
            WGPURenderPassColorAttachment color = _gpu_color_attachment(GpuColorAttachment{view: dst});
            WGPURenderPassDescriptor rd = WGPURenderPassDescriptor{colorAttachmentCount: 1, colorAttachments: &color};
            WGPURenderPassEncoder pass = wgpuCommandEncoderBeginRenderPass(enc, &rd);
            wgpuRenderPassEncoderSetPipeline(pass, pipe.handle);
            wgpuRenderPassEncoderSetBindGroup(pass, 0, bg, 0, null);
            wgpuRenderPassEncoderDraw(pass, 3, 1, 0, 0);
            wgpuRenderPassEncoderEnd(pass);
            wgpuRenderPassEncoderRelease(pass);
        }
    }
    string err = _gpu_finish(g, enc, "generate_mips");
    for (i in 0..made.size) {
        if (made.data[i] != null) wgpuBindGroupRelease(made.data[i]);
    }
    for (i in 0..views.size) {
        if (views.data[i] != null) wgpuTextureViewRelease(views.data[i]);
    }
    List_free(&made);
    List_free(&views);
    if (err != null) return Err<int, string>(err);
    return Ok<int, string>(0);
}

// The WebGPU format of a Vulkan format number (a KTX2 file's vkFormat), or
// Undefined for one without an equivalent here.
WGPUTextureFormat gpu_vk_format(uint32 vk) {
    if (vk >= 133 && vk <= 146) return (WGPUTextureFormat)(0x32 + vk - 133);
    if (vk == 131 || vk == 132) return (WGPUTextureFormat)(0x32 + vk - 131);
    if (vk >= 147 && vk <= 156) return (WGPUTextureFormat)(0x40 + vk - 147);
    if (vk >= 157 && vk <= 184) return (WGPUTextureFormat)(0x4A + vk - 157);
    if (vk == 9) return WGPUTextureFormat_R8Unorm;
    if (vk == 10) return WGPUTextureFormat_R8Snorm;
    if (vk == 16) return WGPUTextureFormat_RG8Unorm;
    if (vk == 17) return WGPUTextureFormat_RG8Snorm;
    if (vk == 37) return WGPUTextureFormat_RGBA8Unorm;
    if (vk == 38) return WGPUTextureFormat_RGBA8Snorm;
    if (vk == 43) return WGPUTextureFormat_RGBA8UnormSrgb;
    if (vk == 44) return WGPUTextureFormat_BGRA8Unorm;
    if (vk == 50) return WGPUTextureFormat_BGRA8UnormSrgb;
    if (vk == 64) return WGPUTextureFormat_RGB10A2Unorm;
    if (vk == 76) return WGPUTextureFormat_R16Float;
    if (vk == 83) return WGPUTextureFormat_RG16Float;
    if (vk == 97) return WGPUTextureFormat_RGBA16Float;
    if (vk == 100) return WGPUTextureFormat_R32Float;
    if (vk == 103) return WGPUTextureFormat_RG32Float;
    if (vk == 109) return WGPUTextureFormat_RGBA32Float;
    if (vk == 122) return WGPUTextureFormat_RG11B10Ufloat;
    if (vk == 123) return WGPUTextureFormat_RGB9E5Ufloat;
    return WGPUTextureFormat_Undefined;
}

// An Err when the device cannot make textures of a block-compressed format.
string _gpu_format_missing(*Gpu g, WGPUTextureFormat f) {
    uint32 v = (uint32)f;
    if (v >= 0x32 && v <= 0x3F && !g.bc) return "texture: this device has no texture-compression-bc (Gpu.bc)";
    if (v >= 0x40 && v <= 0x49 && !g.etc2) return "texture: this device has no texture-compression-etc2 (Gpu.etc2)";
    if (v >= 0x4A && v <= 0x65 && !g.astc) return "texture: this device has no texture-compression-astc (Gpu.astc)";
    return null;
}

// A texture holding a KTX2 file's images (<gpu/ktx2>): its format, layers,
// cube faces and mip levels. A file that asks for mip levels to be made gets
// them from generate_mips when its format is renderable. A block-compressed
// format needs the device feature (Gpu.bc, etc2, astc), else an Err.
Result<GpuTexture, string> Gpu_ktx2(*Gpu self, *Ktx2 k) {
    WGPUTextureFormat f = gpu_vk_format(k.vk_format);
    if (f == WGPUTextureFormat_Undefined) return Err<GpuTexture, string>(_gpu_fail("ktx2: no WebGPU format for this vkFormat", null));
    string missing = _gpu_format_missing(self, f);
    if (missing != null) return Err<GpuTexture, string>(_gpu_fail(missing, null));
    bool make = k.want_mips && _gpu_renderable(f) && !_gpu_is_integer(f);
    GpuTextureDesc d = GpuTextureDesc{width: k.width, height: k.height, format: f, layers: k.layers * k.faces,
        cube: k.faces == 6, mips: k.levels, mipmaps: make};
    GpuTexture t = Gpu_texture_with(self, &d)?;
    for (level in 0..k.levels) {
        for (layer in 0..k.layers) {
            for (face in 0..k.faces) {
                Result<int, string> w = GpuTexture_write_level(&t, layer * k.faces + face, level, Ktx2_image(k, level, layer, face));
                if (!w.ok) {
                    GpuTexture_release(&t);
                    return Err<GpuTexture, string>(w.error);
                }
            }
        }
    }
    if (make) {
        Result<int, string> m = GpuTexture_generate_mips(&t);
        if (!m.ok) {
            GpuTexture_release(&t);
            return Err<GpuTexture, string>(m.error);
        }
    }
    return Ok<GpuTexture, string>(t);
}

Result<GpuSurface, string> _gpu_surface(*Gpu self, *WGPUChainedStruct source) {
    WGPUSurfaceDescriptor d = WGPUSurfaceDescriptor{nextInChain: source};
    WGPUSurface s = wgpuInstanceCreateSurface(self.instance, &d);
    if (s == null) return Err<GpuSurface, string>(_gpu_fail("surface", null));
    WGPUSurfaceCapabilities caps;
    wgpuSurfaceGetCapabilities(s, self.adapter, &caps);
    WGPUTextureFormat format = WGPUTextureFormat_BGRA8Unorm;
    for (i in 0..caps.formatCount) {
        if (caps.formats[i] == WGPUTextureFormat_BGRA8Unorm || caps.formats[i] == WGPUTextureFormat_RGBA8Unorm) {
            format = caps.formats[i];
            break;
        }
    }
    wgpuSurfaceCapabilitiesFreeMembers(caps);
    return Ok<GpuSurface, string>(GpuSurface{*self, s, format, 0, 0, WGPUTextureFormat_Undefined});
}

#ifdef __EMSCRIPTEN__
extern int emscripten_get_canvas_element_size(string target, *int width, *int height);
extern int emscripten_request_animation_frame(*void callback, *void user_data);

bool _gpu_on_animation_frame(double time, *void u) {
    *(*int)u = 1;
    return false;
}

Result<GpuSurface, string> _gpu_native_only(string what) {
    String_clear(&_gpu_err);
    String_appendf(&_gpu_err, "%s: not in a browser (use Gpu_surface_canvas)", what);
    return Err<GpuSurface, string>(_gpu_err.data);
}
#endif

// A surface over a CAMetalLayer (macOS, iOS).
Result<GpuSurface, string> Gpu_surface_metal(*Gpu self, *void layer) {
#ifdef __EMSCRIPTEN__
    return _gpu_native_only("surface_metal");
#else
    WGPUSurfaceSourceMetalLayer src = WGPUSurfaceSourceMetalLayer{chain: WGPUChainedStruct{null, WGPUSType_SurfaceSourceMetalLayer}, layer: layer};
    return _gpu_surface(self, (*WGPUChainedStruct)&src);
#endif
}

// A surface over an X11 window (display is the Display*).
Result<GpuSurface, string> Gpu_surface_x11(*Gpu self, *void display, uint64 window) {
#ifdef __EMSCRIPTEN__
    return _gpu_native_only("surface_x11");
#else
    WGPUSurfaceSourceXlibWindow src = WGPUSurfaceSourceXlibWindow{chain: WGPUChainedStruct{null, WGPUSType_SurfaceSourceXlibWindow}, display: display, window: window};
    return _gpu_surface(self, (*WGPUChainedStruct)&src);
#endif
}

// A surface over a Wayland wl_surface (display is the wl_display*).
Result<GpuSurface, string> Gpu_surface_wayland(*Gpu self, *void display, *void surface) {
#ifdef __EMSCRIPTEN__
    return _gpu_native_only("surface_wayland");
#else
    WGPUSurfaceSourceWaylandSurface src = WGPUSurfaceSourceWaylandSurface{chain: WGPUChainedStruct{null, WGPUSType_SurfaceSourceWaylandSurface}, display: display, surface: surface};
    return _gpu_surface(self, (*WGPUChainedStruct)&src);
#endif
}

// A surface over a Win32 window.
Result<GpuSurface, string> Gpu_surface_win32(*Gpu self, *void hinstance, *void hwnd) {
#ifdef __EMSCRIPTEN__
    return _gpu_native_only("surface_win32");
#else
    WGPUSurfaceSourceWindowsHWND src = WGPUSurfaceSourceWindowsHWND{chain: WGPUChainedStruct{null, WGPUSType_SurfaceSourceWindowsHWND}, hinstance: hinstance, hwnd: hwnd};
    return _gpu_surface(self, (*WGPUChainedStruct)&src);
#endif
}

// A surface over an Android ANativeWindow*.
Result<GpuSurface, string> Gpu_surface_android(*Gpu self, *void window) {
#ifdef __EMSCRIPTEN__
    return _gpu_native_only("surface_android");
#else
    WGPUSurfaceSourceAndroidNativeWindow src = WGPUSurfaceSourceAndroidNativeWindow{chain: WGPUChainedStruct{null, WGPUSType_SurfaceSourceAndroidNativeWindow}, window: window};
    return _gpu_surface(self, (*WGPUChainedStruct)&src);
#endif
}

// A surface over an HTML canvas in a browser, found by a CSS selector such as "#canvas",
// and configured to the canvas's size in pixels (its width and height attributes).
// Fails outside a browser (wasm32-unknown-emscripten). docs/web.md has the build flags.
Result<GpuSurface, string> Gpu_surface_canvas(*Gpu self, string selector) {
#ifdef __EMSCRIPTEN__
    WGPUEmscriptenSurfaceSourceCanvasHTMLSelector src = WGPUEmscriptenSurfaceSourceCanvasHTMLSelector{
        chain: WGPUChainedStruct{null, WGPUSType_EmscriptenSurfaceSourceCanvasHTMLSelector}, selector: gpu_str(selector)};
    GpuSurface s = _gpu_surface(self, (*WGPUChainedStruct)&src)?;
    int w = 0;
    int h = 0;
    emscripten_get_canvas_element_size(selector, &w, &h);
    GpuSurface_configure(&s, (uint32)(w > 0 ? w : 300), (uint32)(h > 0 ? h : 150));
    return Ok<GpuSurface, string>(s);
#else
    return Err<GpuSurface, string>(_gpu_fail("surface_canvas: only in a browser (wasm32-unknown-emscripten)", null));
#endif
}

// Sets the size of the surface's frames, in pixels; call it again when the
// window is resized.
void GpuSurface_configure(*GpuSurface self, uint32 width, uint32 height) {
    self.width = width;
    self.height = height;
    WGPUSurfaceConfiguration c = WGPUSurfaceConfiguration{device: self.gpu.device, format: self.format,
        usage: WGPUTextureUsage_RenderAttachment, width: width, height: height,
        alphaMode: WGPUCompositeAlphaMode_Auto, presentMode: WGPUPresentMode_Fifo};
    if (self.view_format != WGPUTextureFormat_Undefined) {
        c.viewFormatCount = 1;
        c.viewFormats = &self.view_format;
    }
    wgpuSurfaceConfigure(self.handle, &c);
}

// GpuSurface_configure with a second view format for the frames, the sRGB or
// linear twin of the surface's format (gpu_srgb_format(surface.format)): each
// frame then has alt_view, so a frame can draw a scene through the sRGB view
// and an interface through the linear one. Later configure() calls keep it.
// Whether a surface can take view formats depends on the platform: Metal can,
// Vulkan needs VK_KHR_swapchain_mutable_format.
void GpuSurface_configure_with(*GpuSurface self, uint32 width, uint32 height, WGPUTextureFormat view_format) {
    self.view_format = view_format;
    GpuSurface_configure(self, width, height);
}

// The next frame to draw into. An error means the surface needs configure()
// again (after a resize) or the frame was skipped.
Result<GpuFrame, string> GpuSurface_frame(*GpuSurface self) {
    WGPUSurfaceTexture st;
    wgpuSurfaceGetCurrentTexture(self.handle, &st);
    if (st.status != WGPUSurfaceGetCurrentTextureStatus_SuccessOptimal && st.status != WGPUSurfaceGetCurrentTextureStatus_SuccessSuboptimal) {
        if (st.texture != null) wgpuTextureRelease(st.texture);
        String_clear(&_gpu_err);
        String_appendf(&_gpu_err, "surface frame unavailable (status %d)", (int)st.status);
        return Err<GpuFrame, string>(_gpu_err.data);
    }
    GpuFrame f = GpuFrame{st.texture, wgpuTextureCreateView(st.texture, null), null};
    if (self.view_format != WGPUTextureFormat_Undefined) {
        WGPUTextureViewDescriptor vd = WGPUTextureViewDescriptor{format: self.view_format, dimension: WGPUTextureViewDimension_2D,
            mipLevelCount: 1, arrayLayerCount: 1, aspect: WGPUTextureAspect_All};
        f.alt_view = wgpuTextureCreateView(st.texture, &vd);
    }
    return Ok<GpuFrame, string>(f);
}

// Shows the frame and releases it. In a browser the canvas shows it at the next display
// refresh: present releases the frame and suspends the program until the browser's
// next animation frame, which keeps a frame loop at the display's rate.
void GpuSurface_present(*GpuSurface self, *GpuFrame frame) {
#ifndef __EMSCRIPTEN__
    wgpuSurfacePresent(self.handle);
#endif
    if (frame.alt_view != null) wgpuTextureViewRelease(frame.alt_view);
    wgpuTextureViewRelease(frame.view);
    wgpuTextureRelease(frame.texture);
#ifdef __EMSCRIPTEN__
    int shown = 0;
    emscripten_request_animation_frame((*void)_gpu_on_animation_frame, &shown);
    for (i in 0..1000) {
        if (shown != 0) break;
        emscripten_sleep(1);
    }
#endif
}

// Unconfigures and releases the surface; a second call does nothing. Present or drop the
// current frame first.
void GpuSurface_release(*GpuSurface self) {
    if (self.handle != null) {
        wgpuSurfaceUnconfigure(self.handle);
        wgpuSurfaceRelease(self.handle);
    }
    self.handle = null;
}
