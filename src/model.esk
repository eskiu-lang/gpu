// model.esk: drawing glTF models with physically based shading.
//
//     Gltf data = gltf_load("helmet.glb")?;
//     defer data.free();
//     GpuModel model = gpu.model(&data, surface.format)?;
//     defer model.release();
//     ...each frame:
//     data.animate(0, seconds);                 // optional
//     model.update(mat4_identity());
//     GpuPass pass = gpu.pass(frame.view, clear, &depth);
//     model.draw(&pass, &camera);
//     pass.end()?;
//
// The shading is glTF's metallic-roughness model with base color, metallic-
// roughness, normal, occlusion and emissive textures, vertex colors, alpha
// mask and blend, double-sided materials, KHR_materials_unlit and skinning,
// lit by one directional light (GpuModel.light) and a hemisphere ambient term,
// or by an environment (GpuModel_set_ibl, <gpu/ibl>) instead of that term.
// Morph targets are applied on the GPU with the node weights update() reads
// (or GpuModel_set_weights), before skinning. Shadows from the light are
// opt-in: GpuModel_enable_shadows, then render_shadows each frame before the
// pass that draws the model.
// The Gltf must outlive the model: update() reads its node poses. A model is
// drawn once per pass (its uniforms hold one pose and one camera). OBJ files
// load into the same Gltf (obj_load, or model_load for either kind).

import <io>;
import <mem>;
import <string>;
import <list>;
import <result>;
import <libc>;
import <gpu/raw>;
import <gpu/core>;
import <gpu/render>;
import <gpu/math>;
import <gpu/gltf>;
import <gpu/obj>;
import <gpu/image>;
import <gpu/ibl>;

// A camera: view and proj are the view and projection matrices (WebGPU clip space) and eye
// is the camera's position in world space, which the specular shading needs. gpu_camera
// and GpuModel_camera make one.
struct GpuCamera {
    Mat4 view;
    Mat4 proj;
    Vec3 eye;
}

// direction points from the light toward the scene; ambient is the sky color
// of the hemisphere term (the ground gets a third of it).
struct GpuLight {
    Vec3 direction;
    Vec3 color;
    float intensity;
    Vec3 ambient;
}

struct _GpuDraw {
    int node;
    int mesh;
    int prim;
    int material;
    int pipeline;
    GpuBuffer uniforms;
    GpuBuffer joints;
    bool skinned;
    float depth;
    GpuBuffer weights;
    int targets;
}

struct _GpuPrim {
    GpuBuffer vertices;
    GpuBuffer indices;
    uint32 index_count;
    bool drawable;
    GpuBuffer morph;
    int targets;
    uint32 vertex_count;
}

struct _GpuMat {
    GpuBuffer uniforms;
    int[5] tex;
    int[5] samp;
    int pipeline;
    bool blend;
}

struct _GpuTexKey {
    int image;
    bool srgb;
    int slot;
}

// A glTF model on the GPU, made by Gpu_model. data is the Gltf it draws (not owned). light
// is the directional light and ambient term; transform is the model matrix update() was
// last given. encode_srgb says the shader writes sRGB values itself because the target
// format is not an sRGB one. ibl is the environment set with GpuModel_set_ibl or null.
// shadows, shadow and the shadow_ fields are the state GpuModel_enable_shadows sets up,
// with light_view_proj the light's matrix of the last render_shadows. world holds each
// node's world matrix from the last update(). The other fields are the model's pipelines,
// textures, samplers, buffers and draw list.
struct GpuModel {
    Gpu gpu;
    *Gltf data;
    GpuLight light;
    GpuBuffer frame;
    List<GpuPipeline> pipelines;
    List<GpuTexture> textures;
    List<_GpuTexKey> texture_keys;
    List<GpuSampler> samplers;
    List<_GpuMat> materials;
    List<_GpuPrim> prims;
    List<int> prim_start;
    List<_GpuDraw> draws;
    *Mat4 world;
    *bool shown;
    int material_version;
    Mat4 transform;
    bool encode_srgb;
    *GpuIbl ibl;
    bool shadows;
    GpuShadowOptions shadow;
    GpuTexture shadow_map;
    GpuPipeline shadow_pipeline;
    GpuSampler shadow_sampler;
    Mat4 light_view_proj;
    GpuBuffer _no_morph;
    float[4] _shadow_params;
    GpuTexture _no_cube;
    GpuTexture _no_shadow;
}

// Shadows from GpuModel.light (GpuModel_enable_shadows). Each 0 picks the
// default:
// - size: the shadow map's width and height in texels (2048).
// - bias: subtracted from a point's depth from the light before the test, in
//   the light box's depth units (0 to 1 from its near to its far side): 0.002.
// - normal_bias: how far each point moves along its normal before the test,
//   in shadow map texels (1.5).
// - slope_bias: the shadow pipeline's depth bias slope scale (1.0).
// - radius and center: the box the light sees, a cube of half-size radius
//   around center; radius 0 fits the model's bounds (with its transform) at
//   each render_shadows.
struct GpuShadowOptions {
    uint32 size;
    float bias;
    float normal_bias;
    float slope_bias;
    float radius;
    Vec3 center;
}

const int _GM_VERTEX_FLOATS = 26;

string _gpu_model_shader =
    "struct Frame { view_proj: mat4x4<f32>, eye: vec4<f32>, light_dir: vec4<f32>, light_color: vec4<f32>, ambient: vec4<f32>,\n"
    "    light_vp: mat4x4<f32>, shadow: vec4<f32>, ibl: vec4<f32> };\n"
    "struct Draw { model: mat4x4<f32>, normal: mat4x4<f32>, flags: vec4<f32> };\n"
    "struct Material { base: vec4<f32>, emissive: vec4<f32>, params: vec4<f32>, tc: vec4<f32>, misc: vec4<f32>,\n"
    "    tf: array<vec4<f32>, 10> };\n"
    "@group(0) @binding(0) var<uniform> frame: Frame;\n"
    "@group(0) @binding(1) var<uniform> draw: Draw;\n"
    "@group(0) @binding(2) var<uniform> mat: Material;\n"
    "@group(0) @binding(3) var<storage, read> joints: array<mat4x4<f32>>;\n"
    "@group(0) @binding(4) var base_tex: texture_2d<f32>;\n"
    "@group(0) @binding(5) var base_samp: sampler;\n"
    "@group(0) @binding(6) var mr_tex: texture_2d<f32>;\n"
    "@group(0) @binding(7) var mr_samp: sampler;\n"
    "@group(0) @binding(8) var normal_tex: texture_2d<f32>;\n"
    "@group(0) @binding(9) var normal_samp: sampler;\n"
    "@group(0) @binding(10) var occ_tex: texture_2d<f32>;\n"
    "@group(0) @binding(11) var occ_samp: sampler;\n"
    "@group(0) @binding(12) var em_tex: texture_2d<f32>;\n"
    "@group(0) @binding(13) var em_samp: sampler;\n"
    "@group(0) @binding(14) var<storage, read> morph: array<vec4<f32>>;\n"
    "@group(0) @binding(15) var<storage, read> morph_w: array<f32>;\n"
    "@group(0) @binding(16) var irr_tex: texture_cube<f32>;\n"
    "@group(0) @binding(17) var spec_tex: texture_cube<f32>;\n"
    "@group(0) @binding(18) var brdf_tex: texture_2d<f32>;\n"
    "@group(0) @binding(19) var ibl_samp: sampler;\n"
    "@group(0) @binding(20) var shadow_map: texture_depth_2d;\n"
    "@group(0) @binding(21) var shadow_samp: sampler_comparison;\n"
    "struct In { @location(0) pos: vec3<f32>, @location(1) normal: vec3<f32>, @location(2) uv0: vec2<f32>,\n"
    "    @location(3) uv1: vec2<f32>, @location(4) tangent: vec4<f32>, @location(5) color: vec4<f32>,\n"
    "    @location(6) joint: vec4<f32>, @location(7) weight: vec4<f32>, @builtin(vertex_index) vi: u32 };\n"
    "struct V { @builtin(position) clip: vec4<f32>, @location(0) world: vec3<f32>, @location(1) normal: vec3<f32>,\n"
    "    @location(2) uv0: vec2<f32>, @location(3) uv1: vec2<f32>, @location(4) tangent: vec4<f32>, @location(5) color: vec4<f32> };\n"
    "struct Shape { pos: vec3<f32>, normal: vec3<f32>, tangent: vec3<f32>, skin: mat4x4<f32> };\n"
    "fn shape(v: In) -> Shape {\n"
    "    var s: Shape;\n"
    "    s.pos = v.pos;\n"
    "    s.normal = v.normal;\n"
    "    s.tangent = v.tangent.xyz;\n"
    "    let nt = u32(draw.flags.y);\n"
    "    let vc = u32(draw.flags.z);\n"
    "    for (var t = 0u; t < nt; t++) {\n"
    "        let w = morph_w[t];\n"
    "        if (w != 0.0) {\n"
    "            let at = (t * vc + v.vi) * 3u;\n"
    "            s.pos += morph[at].xyz * w;\n"
    "            s.normal += morph[at + 1u].xyz * w;\n"
    "            s.tangent += morph[at + 2u].xyz * w;\n"
    "        }\n"
    "    }\n"
    "    s.skin = mat4x4<f32>(vec4(1.0, 0.0, 0.0, 0.0), vec4(0.0, 1.0, 0.0, 0.0), vec4(0.0, 0.0, 1.0, 0.0), vec4(0.0, 0.0, 0.0, 1.0));\n"
    "    if (draw.flags.x > 0.5) {\n"
    "        s.skin = joints[u32(v.joint.x)] * v.weight.x + joints[u32(v.joint.y)] * v.weight.y\n"
    "             + joints[u32(v.joint.z)] * v.weight.z + joints[u32(v.joint.w)] * v.weight.w;\n"
    "    }\n"
    "    return s;\n"
    "}\n"
    "@vertex fn vs_shadow(v: In) -> @builtin(position) vec4<f32> {\n"
    "    let s = shape(v);\n"
    "    return frame.light_vp * (draw.model * (s.skin * vec4(s.pos, 1.0)));\n"
    "}\n"
    "@vertex fn vs(v: In) -> V {\n"
    "    let s = shape(v);\n"
    "    let skin = s.skin;\n"
    "    let local = skin * vec4(s.pos, 1.0);\n"
    "    let world = draw.model * local;\n"
    "    var out: V;\n"
    "    out.clip = frame.view_proj * world;\n"
    "    out.world = world.xyz;\n"
    "    let nm = mat3x3<f32>(draw.normal[0].xyz, draw.normal[1].xyz, draw.normal[2].xyz);\n"
    "    let sm = mat3x3<f32>(skin[0].xyz, skin[1].xyz, skin[2].xyz);\n"
    "    out.normal = nm * (sm * s.normal);\n"
    "    let mm = mat3x3<f32>(draw.model[0].xyz, draw.model[1].xyz, draw.model[2].xyz);\n"
    "    out.tangent = vec4(mm * (sm * s.tangent), v.tangent.w);\n"
    "    out.uv0 = v.uv0;\n"
    "    out.uv1 = v.uv1;\n"
    "    out.color = v.color;\n"
    "    return out;\n"
    "}\n"
    "const PI = 3.14159265;\n"
    "fn pick(v: V, which: f32) -> vec2<f32> { return select(v.uv0, v.uv1, which > 0.5); }\n"
    "fn tuv(v: V, which: f32, k: u32) -> vec2<f32> {\n"
    "    let uv = pick(v, which);\n"
    "    let m = mat.tf[k * 2u];\n"
    "    let o = mat.tf[k * 2u + 1u];\n"
    "    return vec2(m.x * uv.x + m.y * uv.y + o.x, m.z * uv.x + m.w * uv.y + o.y);\n"
    "}\n"
    "fn to_srgb(c: vec3<f32>) -> vec3<f32> {\n"
    "    let lo = c * 12.92;\n"
    "    let hi = 1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055;\n"
    "    return select(hi, lo, c <= vec3(0.0031308));\n"
    "}\n"
    "fn shadow_at(world: vec3<f32>, n: vec3<f32>) -> f32 {\n"
    "    if (frame.shadow.x < 0.5) { return 1.0; }\n"
    "    let p = frame.light_vp * vec4(world + n * frame.shadow.z, 1.0);\n"
    "    let c = p.xyz / p.w;\n"
    "    let uv = vec2(c.x * 0.5 + 0.5, 0.5 - c.y * 0.5);\n"
    "    if (uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0 || c.z > 1.0) { return 1.0; }\n"
    "    let d = c.z - frame.shadow.y;\n"
    "    var lit = 0.0;\n"
    "    for (var y = -1; y <= 1; y++) {\n"
    "        for (var x = -1; x <= 1; x++) {\n"
    "            lit += textureSampleCompareLevel(shadow_map, shadow_samp, uv + vec2(f32(x), f32(y)) * frame.shadow.w, d);\n"
    "        }\n"
    "    }\n"
    "    return lit / 9.0;\n"
    "}\n"
    "@fragment fn fs(v: V, @builtin(front_facing) front: bool) -> @location(0) vec4<f32> {\n"
    "    let base_s = textureSample(base_tex, base_samp, tuv(v, mat.tc.x, 0u));\n"
    "    let mr_s = textureSample(mr_tex, mr_samp, tuv(v, mat.tc.y, 1u));\n"
    "    let n_s = textureSample(normal_tex, normal_samp, tuv(v, mat.tc.z, 2u)).xyz;\n"
    "    let occ_s = textureSample(occ_tex, occ_samp, tuv(v, mat.tc.w, 3u)).r;\n"
    "    let em_s = textureSample(em_tex, em_samp, tuv(v, mat.misc.z, 4u)).rgb;\n"
    "    let uv = tuv(v, mat.tc.z, 2u);\n"
    "    let dp1 = dpdx(v.world);\n"
    "    let dp2 = dpdy(v.world);\n"
    "    let duv1 = dpdx(uv);\n"
    "    let duv2 = dpdy(uv);\n"
    "    var n = normalize(v.normal);\n"
    "    if (!front) { n = -n; }\n"
    "    let geo_n = n;\n"
    "    let dp2perp = cross(dp2, n);\n"
    "    let dp1perp = cross(n, dp1);\n"
    "    var t = dp2perp * duv1.x + dp1perp * duv2.x;\n"
    "    var b = dp2perp * duv1.y + dp1perp * duv2.y;\n"
    "    let inv = inverseSqrt(max(max(dot(t, t), dot(b, b)), 1e-20));\n"
    "    t = t * inv;\n"
    "    b = b * inv;\n"
    "    if (abs(v.tangent.w) > 0.5) {\n"
    "        t = normalize(v.tangent.xyz - n * dot(n, v.tangent.xyz));\n"
    "        b = cross(n, t) * v.tangent.w;\n"
    "    }\n"
    "    var base = mat.base * v.color * base_s;\n"
    "    if (mat.misc.x > 0.5 && mat.misc.x < 1.5 && base.a < mat.emissive.w) { discard; }\n"
    "    if (mat.misc.y > 0.5) {\n"
    "        let c = select(base.rgb, to_srgb(base.rgb), frame.ambient.w > 0.5);\n"
    "        return vec4(c, select(1.0, base.a, mat.misc.x > 1.5));\n"
    "    }\n"
    "    if (mat.params.z > 0.0) {\n"
    "        let tn = (n_s * 2.0 - 1.0) * vec3(mat.params.z, mat.params.z, 1.0);\n"
    "        n = normalize(t * tn.x + b * tn.y + n * tn.z);\n"
    "    }\n"
    "    let metallic = clamp(mat.params.x * mr_s.b, 0.0, 1.0);\n"
    "    let rough = clamp(mat.params.y * mr_s.g, 0.04, 1.0);\n"
    "    let a = rough * rough;\n"
    "    let view = normalize(frame.eye.xyz - v.world);\n"
    "    let l = normalize(-frame.light_dir.xyz);\n"
    "    let h = normalize(view + l);\n"
    "    let nl = max(dot(n, l), 0.0);\n"
    "    let nv = max(dot(n, view), 1e-4);\n"
    "    let nh = max(dot(n, h), 0.0);\n"
    "    let vh = max(dot(view, h), 0.0);\n"
    "    let f0 = mix(vec3(0.04), base.rgb, metallic);\n"
    "    let f = f0 + (1.0 - f0) * pow(1.0 - vh, 5.0);\n"
    "    let a2 = a * a;\n"
    "    let dn = nh * nh * (a2 - 1.0) + 1.0;\n"
    "    let d = a2 / (PI * dn * dn);\n"
    "    let gv = nl * sqrt(nv * nv * (1.0 - a2) + a2);\n"
    "    let gl = nv * sqrt(nl * nl * (1.0 - a2) + a2);\n"
    "    let vis = 0.5 / max(gv + gl, 1e-5);\n"
    "    let spec = f * d * vis;\n"
    "    let diffuse = (1.0 - f) * (1.0 - metallic) * base.rgb / PI;\n"
    "    let radiance = frame.light_color.rgb * frame.light_dir.w;\n"
    "    var color = (diffuse + spec) * radiance * nl;\n"
    "    if (frame.shadow.x > 0.5) { color = color * shadow_at(v.world, geo_n); }\n"
    "    let sky = mix(frame.ambient.rgb / 3.0, frame.ambient.rgb, n.y * 0.5 + 0.5);\n"
    "    let fa = f0 + (max(vec3(1.0 - rough), f0) - f0) * pow(1.0 - nv, 5.0);\n"
    "    let occ = 1.0 + mat.params.w * (occ_s - 1.0);\n"
    "    if (frame.ibl.x > 0.5) {\n"
    "        let irr = textureSampleLevel(irr_tex, ibl_samp, n, 0.0).rgb;\n"
    "        let pre = textureSampleLevel(spec_tex, ibl_samp, reflect(-view, n), rough * frame.ibl.z).rgb;\n"
    "        let ab = textureSampleLevel(brdf_tex, ibl_samp, vec2(nv, rough), 0.0).rg;\n"
    "        color = color + (irr * base.rgb * (1.0 - metallic) * (1.0 - fa) + pre * (f0 * ab.x + ab.y)) * occ * frame.ibl.y;\n"
    "    } else {\n"
    "        color = color + (base.rgb * (1.0 - metallic) * (1.0 - fa) + fa * 0.5) * sky * occ;\n"
    "    }\n"
    "    color = color + em_s * mat.emissive.rgb;\n"
    "    color = color / (1.0 + max(max(color.r, color.g), color.b) * 0.0) ;\n"
    "    color = clamp(color, vec3(0.0), vec3(1.0));\n"
    "    let outc = select(color, to_srgb(color), frame.ambient.w > 0.5);\n"
    "    return vec4(outc, select(1.0, base.a, mat.misc.x > 1.5));\n"
    "}\n";

// Loads a model file: Wavefront OBJ when the name ends in .obj (any case),
// glTF (.gltf or .glb) otherwise.
Result<Gltf, string> model_load(string path) {
    int n = (int)strlen(path);
    if (n > 4 && path[n - 4] == '.' && (path[n - 3] | 32) == 'o' && (path[n - 2] | 32) == 'b' && (path[n - 1] | 32) == 'j') {
        return obj_load(path);
    }
    return gltf_load(path);
}

bool _gpu_is_srgb(WGPUTextureFormat f) {
    return f == WGPUTextureFormat_RGBA8UnormSrgb || f == WGPUTextureFormat_BGRA8UnormSrgb;
}

GpuSamplerOptions _gpu_gltf_sampler(*GltfSampler s) {
    GpuSamplerOptions o = GpuSamplerOptions{mipmaps: true, anisotropy: 8};
    if (s == null) return o;
    if (s.mag_filter == 9728) o.nearest = true;
    if (s.min_filter == 9728 || s.min_filter == 9729) o.mipmaps = false;
    WGPUAddressMode[2] w;
    int[2] wraps = {s.wrap_s, s.wrap_t};
    for (i in 0..2) {
        w[i] = WGPUAddressMode_Repeat;
        if (wraps[i] == 33071) w[i] = WGPUAddressMode_ClampToEdge;
        if (wraps[i] == 33648) w[i] = WGPUAddressMode_MirrorRepeat;
    }
    o.wrap_u = w[0];
    o.wrap_v = w[1];
    return o;
}

// The model's texture slot for image (decoded on first use), or the fallback
// slot when the image is missing or does not decode.
int _gpu_model_texture(*GpuModel self, int image, bool srgb, int fallback) {
    if (image < 0 || image >= self.data.images.size) return fallback;
    for (i in 0..self.texture_keys.size) {
        if (self.texture_keys.data[i].image == image && self.texture_keys.data[i].srgb == srgb) return self.texture_keys.data[i].slot;
    }
    GltfImage* img = &self.data.images.data[image];
    if (img.data == null || img.len == 0) return fallback;
    Result<Bitmap, string> dec = image_decode(img.data, img.len);
    if (!dec.ok) return fallback;
    Bitmap pic = dec.value;
    GpuImageOptions o = GpuImageOptions{srgb: srgb, mipmaps: true};
    Result<GpuTexture, string> t = Gpu_image_with(&self.gpu, pic.width, pic.height, pic.rgba, &o);
    Bitmap_free(&pic);
    if (!t.ok) return fallback;
    List_push(&self.textures, t.value);
    int slot = self.textures.size - 1;
    List_push(&self.texture_keys, _GpuTexKey{image, srgb, slot});
    return slot;
}

// Interleaves a primitive's attributes (missing ones get defaults; missing
// normals are averaged from the faces around each vertex).
*float _gpu_model_vertices(*GltfPrimitive p) {
    uint32 n = p.vertex_count;
    *float v = alloc<float>((int64)n * _GM_VERTEX_FLOATS + 1);
    *float normals = p.normals;
    *float made = null;
    if (normals == null) {
        made = alloc<float>((int64)n * 3 + 1);
        for (t in 0..p.index_count / 3) {
            uint32 i0 = p.indices[t * 3];
            uint32 i1 = p.indices[t * 3 + 1];
            uint32 i2 = p.indices[t * 3 + 2];
            Vec3 a = Vec3{p.positions[i0 * 3], p.positions[i0 * 3 + 1], p.positions[i0 * 3 + 2]};
            Vec3 b = Vec3{p.positions[i1 * 3], p.positions[i1 * 3 + 1], p.positions[i1 * 3 + 2]};
            Vec3 c = Vec3{p.positions[i2 * 3], p.positions[i2 * 3 + 1], p.positions[i2 * 3 + 2]};
            Vec3 fn_ = (b - a).cross(c - a);
            uint32[3] ids = {i0, i1, i2};
            for (k in 0..3) {
                made[ids[k] * 3] += fn_.x;
                made[ids[k] * 3 + 1] += fn_.y;
                made[ids[k] * 3 + 2] += fn_.z;
            }
        }
        for (i in 0..n) {
            Vec3 m = Vec3{made[i * 3], made[i * 3 + 1], made[i * 3 + 2]}.normalize();
            made[i * 3] = m.x;
            made[i * 3 + 1] = m.y;
            made[i * 3 + 2] = m.z;
        }
        normals = made;
    }
    for (i in 0..n) {
        *float o = v + (int64)i * _GM_VERTEX_FLOATS;
        for (k in 0..3) o[k] = p.positions[i * 3 + k];
        for (k in 0..3) o[3 + k] = normals[i * 3 + k];
        if (p.uvs != null) {
            o[6] = p.uvs[i * 2];
            o[7] = p.uvs[i * 2 + 1];
        }
        if (p.uvs1 != null) {
            o[8] = p.uvs1[i * 2];
            o[9] = p.uvs1[i * 2 + 1];
        }
        if (p.tangents != null) {
            for (k in 0..4) o[10 + k] = p.tangents[i * 4 + k];
        }
        for (k in 0..4) o[14 + k] = p.colors != null ? p.colors[i * 4 + k] : 1.0;
        if (p.joints != null && p.weights != null) {
            for (k in 0..4) {
                o[18 + k] = (float)p.joints[i * 4 + k];
                o[22 + k] = p.weights[i * 4 + k];
            }
        }
    }
    if (made != null) free(made);
    return v;
}

void _gpu_model_layout(*GpuVertexLayout layout) {
    layout.add(WGPUVertexFormat_Float32x3, 0);
    layout.add(WGPUVertexFormat_Float32x3, 12);
    layout.add(WGPUVertexFormat_Float32x2, 24);
    layout.add(WGPUVertexFormat_Float32x2, 32);
    layout.add(WGPUVertexFormat_Float32x4, 40);
    layout.add(WGPUVertexFormat_Float32x4, 56);
    layout.add(WGPUVertexFormat_Float32x4, 72);
    layout.add(WGPUVertexFormat_Float32x4, 88);
}

// A primitive's morph target deltas for the shader: three vec4 (position,
// normal, tangent) for each target and vertex, target-major.
*float _gpu_model_morph(*GltfPrimitive p) {
    int64 n = (int64)p.target_count * p.vertex_count;
    *float out = alloc<float>(n * 12 + 4);
    *float[3] src = {p.target_positions, p.target_normals, p.target_tangents};
    for (i in 0..n) {
        for (k in 0..3) {
            if (src[k] == null) continue;
            for (c in 0..3) out[i * 12 + k * 4 + c] = src[k][i * 3 + c];
        }
    }
    return out;
}

Result<int, string> _gpu_model_pipelines(*GpuModel self, WGPUTextureFormat format) {
    GpuVertexLayout layout = GpuVertexLayout{stride: (uint64)_GM_VERTEX_FLOATS * 4};
    defer layout.release();
    _gpu_model_layout(&layout);
    for (i in 0..4) {
        bool blend = i >= 2;
        bool two_sided = i % 2 == 1;
        GpuPipelineDesc d = GpuPipelineDesc{wgsl: _gpu_model_shader, vertex: "vs", fragment: "fs", format: format,
            layout: &layout, depth: true, depth_read_only: blend, blend: blend,
            cull: two_sided ? WGPUCullMode_None : WGPUCullMode_Back};
        GpuPipeline p = Gpu_pipeline(&self.gpu, &d)?;
        List_push(&self.pipelines, p);
    }
    return Ok<int, string>(0);
}

// A material's uniform (60 floats): its factors, each texture's UV set, alpha mode and
// unlit flag, then each texture's KHR_texture_transform as two vec4s, (a, b, c, d) and
// (tx, ty): u' = a u + b v + tx, v' = c u + d v + ty (T * R * S, as virocore applies it).
void _gpu_model_material_floats(*GltfMaterial gm, *float u) {
    GltfTextureRef[5] refs = {gm.base_color_texture, gm.metallic_roughness_texture, gm.normal_texture,
        gm.occlusion_texture, gm.emissive_texture};
    float normal_scale = refs[2].texture >= 0 ? refs[2].scale : 0.0;
    float occlusion = refs[3].texture >= 0 ? refs[3].scale : 0.0;
    float[20] head = {gm.base_color.x, gm.base_color.y, gm.base_color.z, gm.base_color.w,
        gm.emissive.x, gm.emissive.y, gm.emissive.z, gm.alpha_cutoff,
        gm.metallic, gm.roughness, normal_scale, occlusion,
        (float)refs[0].texcoord, (float)refs[1].texcoord, (float)refs[2].texcoord, (float)refs[3].texcoord,
        (float)gm.alpha_mode, gm.unlit ? 1.0 : 0.0, (float)refs[4].texcoord, 0.0};
    for (k in 0..20) u[k] = head[k];
    for (k in 0..5) {
        *float f = u + 20 + k * 8;
        GltfTextureRef r = refs[k];
        float c = 1.0;
        float sn = 0.0;
        float sx = 1.0;
        float sy = 1.0;
        float ox = 0.0;
        float oy = 0.0;
        if (r.has_transform) {
            c = (float)cos((double)r.rotation);
            sn = (float)sin((double)r.rotation);
            sx = r.tscale.x;
            sy = r.tscale.y;
            ox = r.offset.x;
            oy = r.offset.y;
        }
        f[0] = c * sx;
        f[1] = sn * sy;
        f[2] = -sn * sx;
        f[3] = c * sy;
        f[4] = ox;
        f[5] = oy;
        f[6] = 0.0;
        f[7] = 0.0;
    }
}

// Which nodes draw: a node hidden by KHR_node_visibility hides its descendants too.
void _gpu_model_visibility(*GpuModel self) {
    *Gltf g = self.data;
    for (i in 0..g.nodes.size) {
        bool on = true;
        int n = i;
        int guard = 0;
        while (n >= 0 && n < g.nodes.size && guard < 4096) {
            if (g.nodes.data[n].hidden) { on = false; break; }
            n = g.nodes.data[n].parent;
            guard++;
        }
        self.shown[i] = on;
    }
}

// Uploads data's meshes, materials and textures and builds the pipelines for color targets
// of format (an sRGB format or not: the shader encodes sRGB itself when it is not). The
// pipelines test against a Depth24Plus depth texture (Gpu_depth). Point and line
// primitives are skipped. data must outlive the model. The light
// starts as a warm white sun from above (intensity 3) with a gray-blue ambient.
Result<GpuModel, string> Gpu_model(*Gpu self, *Gltf data, WGPUTextureFormat format) {
    GpuModel m;
    m.gpu = *self;
    m.data = data;
    m.light = GpuLight{Vec3{-0.4, -1.0, -0.6}, Vec3{1.0, 0.97, 0.92}, 3.0, Vec3{0.35, 0.38, 0.42}};
    m.transform = mat4_identity();
    m.encode_srgb = !_gpu_is_srgb(format);
    Result<int, string> pr = _gpu_model_pipelines(&m, format);
    if (!pr.ok) {
        GpuModel_release(&m);
        return Err<GpuModel, string>(pr.error);
    }
    Result<GpuBuffer, string> fb = Gpu_uniform(self, null, 224);
    if (!fb.ok) {
        GpuModel_release(&m);
        return Err<GpuModel, string>(fb.error);
    }
    m.frame = fb.value;
    Result<int, string> nr = _gpu_model_fallbacks(&m);
    if (!nr.ok) {
        GpuModel_release(&m);
        return Err<GpuModel, string>(nr.error);
    }

    uint8[4] white = {255, 255, 255, 255};
    uint8[4] flat = {128, 128, 255, 255};
    GpuImageOptions srgb = GpuImageOptions{srgb: true};
    List_push(&m.textures, Gpu_image_with(self, 1, 1, &white, &srgb).value);
    List_push(&m.textures, Gpu_image(self, 1, 1, &white).value);
    List_push(&m.textures, Gpu_image(self, 1, 1, &flat).value);
    GpuSamplerOptions dso = _gpu_gltf_sampler(null);
    List_push(&m.samplers, Gpu_sampler_with(self, &dso).value);
    for (i in 0..data.samplers.size) {
        GpuSamplerOptions so = _gpu_gltf_sampler(&data.samplers.data[i]);
        List_push(&m.samplers, Gpu_sampler_with(self, &so).value);
    }

    int nmat = data.materials.size;
    for (i in 0..nmat + 1) {
        GltfMaterial gm;
        if (i < nmat) gm = data.materials.data[i];
        else gm = GltfMaterial{base_color: Vec4{1.0, 1.0, 1.0, 1.0}, metallic: 0.0, roughness: 0.8,
            base_color_texture: GltfTextureRef{-1, 0, 1.0}, metallic_roughness_texture: GltfTextureRef{-1, 0, 1.0},
            normal_texture: GltfTextureRef{-1, 0, 1.0}, occlusion_texture: GltfTextureRef{-1, 0, 1.0},
            emissive_texture: GltfTextureRef{-1, 0, 1.0}, alpha_cutoff: 0.5};
        _GpuMat mat;
        GltfTextureRef[5] refs = {gm.base_color_texture, gm.metallic_roughness_texture, gm.normal_texture,
            gm.occlusion_texture, gm.emissive_texture};
        bool[5] is_srgb = {true, false, false, false, true};
        int[5] fallback = {0, 1, 2, 1, 0};
        for (k in 0..5) {
            mat.tex[k] = fallback[k];
            mat.samp[k] = 0;
            int ti = refs[k].texture;
            if (ti >= 0 && ti < data.textures.size) {
                GltfTexture* tx = &data.textures.data[ti];
                mat.tex[k] = _gpu_model_texture(&m, tx.image, is_srgb[k], fallback[k]);
                if (tx.sampler >= 0) mat.samp[k] = tx.sampler + 1;
            }
        }
        float[60] u;
        _gpu_model_material_floats(&gm, &u[0]);
        Result<GpuBuffer, string> ub = Gpu_uniform(self, &u, sizeof(u));
        if (!ub.ok) {
            GpuModel_release(&m);
            return Err<GpuModel, string>(ub.error);
        }
        mat.uniforms = ub.value;
        mat.blend = gm.alpha_mode == GLTF_BLEND;
        mat.pipeline = (mat.blend ? 2 : 0) + (gm.double_sided ? 1 : 0);
        List_push(&m.materials, mat);
    }

    for (i in 0..data.meshes.size) {
        List_push(&m.prim_start, m.prims.size);
        GltfMesh* mesh = &data.meshes.data[i];
        for (p in 0..mesh.primitives.size) {
            GltfPrimitive* gp = &mesh.primitives.data[p];
            _GpuPrim prim;
            prim.drawable = gp.mode == GLTF_TRIANGLES && gp.index_count >= 3 && gp.vertex_count > 0;
            if (prim.drawable) {
                *float verts = _gpu_model_vertices(gp);
                Result<GpuBuffer, string> vb = Gpu_vertices(self, verts, (uint64)gp.vertex_count * _GM_VERTEX_FLOATS * 4);
                free(verts);
                Result<GpuBuffer, string> ib = Gpu_indices(self, gp.indices, (uint64)gp.index_count);
                if (!vb.ok || !ib.ok) {
                    GpuModel_release(&m);
                    return Err<GpuModel, string>(!vb.ok ? vb.error : ib.error);
                }
                prim.vertices = vb.value;
                prim.indices = ib.value;
                prim.index_count = gp.index_count;
                prim.vertex_count = gp.vertex_count;
                if (gp.target_count > 0) {
                    *float deltas = _gpu_model_morph(gp);
                    Result<GpuBuffer, string> mb = Gpu_buffer(self, (uint64)gp.target_count * gp.vertex_count * 48,
                        WGPUBufferUsage_Storage | WGPUBufferUsage_CopyDst);
                    if (mb.ok) mb.value.write(0, deltas, (uint64)gp.target_count * gp.vertex_count * 48);
                    free(deltas);
                    if (!mb.ok) {
                        prim.vertices.release();
                        prim.indices.release();
                        GpuModel_release(&m);
                        return Err<GpuModel, string>(mb.error);
                    }
                    prim.morph = mb.value;
                    prim.targets = gp.target_count;
                }
            }
            List_push(&m.prims, prim);
        }
    }

    Mat4 ident = mat4_identity();
    for (i in 0..data.nodes.size) {
        GltfNode* node = &data.nodes.data[i];
        if (node.mesh < 0) continue;
        GltfMesh* mesh = &data.meshes.data[node.mesh];
        for (p in 0..mesh.primitives.size) {
            int pi = m.prim_start.data[node.mesh] + p;
            if (!m.prims.data[pi].drawable) continue;
            _GpuDraw d;
            d.node = i;
            d.mesh = node.mesh;
            d.prim = pi;
            int mi = mesh.primitives.data[p].material;
            d.material = mi >= 0 && mi < nmat ? mi : nmat;
            d.pipeline = m.materials.data[d.material].pipeline;
            Result<GpuBuffer, string> ub = Gpu_uniform(self, null, 144);
            int njoints = 1;
            d.skinned = node.skin >= 0 && node.skin < data.skins.size && mesh.primitives.data[p].joints != null;
            if (d.skinned) njoints = data.skins.data[node.skin].joints.size;
            if (njoints < 1) njoints = 1;
            Result<GpuBuffer, string> jb = Gpu_buffer(self, (uint64)njoints * 64, WGPUBufferUsage_Storage | WGPUBufferUsage_CopyDst);
            if (!ub.ok || !jb.ok) {
                GpuModel_release(&m);
                return Err<GpuModel, string>(!ub.ok ? ub.error : jb.error);
            }
            d.uniforms = ub.value;
            d.joints = jb.value;
            if (!d.skinned) d.joints.write(0, &ident, 64);
            d.targets = m.prims.data[pi].targets;
            if (d.targets > 0) {
                Result<GpuBuffer, string> wb = Gpu_buffer(self, (uint64)((d.targets + 3) / 4 * 16),
                    WGPUBufferUsage_Storage | WGPUBufferUsage_CopyDst);
                if (!wb.ok) {
                    d.uniforms.release();
                    d.joints.release();
                    GpuModel_release(&m);
                    return Err<GpuModel, string>(wb.error);
                }
                d.weights = wb.value;
            }
            List_push(&m.draws, d);
        }
    }
    m.world = alloc<Mat4>(data.nodes.size + 1);
    m.shown = alloc<bool>(data.nodes.size + 1);
    m.material_version = data.material_version;
    GpuModel_update(&m, ident);
    return Ok<GpuModel, string>(m);
}

// Recomputes the node and joint matrices from the Gltf's current pose (after
// Gltf_animate, or after changing nodes by hand) and places the whole model
// with transform.
void GpuModel_update(*GpuModel self, Mat4 transform) {
    self.transform = transform;
    Gltf_world(self.data, self.world);
    _gpu_model_visibility(self);
    if (self.material_version != self.data.material_version) {
        // Animation pointer channels changed materials: write their uniforms again.
        self.material_version = self.data.material_version;
        for (i in 0..self.data.materials.size) {
            if (i >= self.materials.size) break;
            float[60] mu;
            _gpu_model_material_floats(&self.data.materials.data[i], &mu[0]);
            self.materials.data[i].uniforms.write(0, &mu, sizeof(mu));
        }
    }
    *Mat4 jm = null;
    int jcap = 0;
    for (i in 0..self.draws.size) {
        _GpuDraw* d = &self.draws.data[i];
        Mat4 model = transform * self.world[d.node];
        float skinned = 0.0;
        if (d.skinned) {
            model = transform;
            skinned = 1.0;
            int skin = self.data.nodes.data[d.node].skin;
            int n = self.data.skins.data[skin].joints.size;
            if (n > jcap) {
                if (jm != null) free(jm);
                jm = alloc<Mat4>(n);
                jcap = n;
            }
            Gltf_joint_matrices(self.data, skin, self.world, jm);
            d.joints.write(0, jm, (uint64)n * 64);
        }
        Mat4 normal = model.inverse().transpose();
        float[36] u;
        for (k in 0..16) {
            u[k] = model.m[k];
            u[16 + k] = normal.m[k];
        }
        u[32] = skinned;
        if (d.targets > 0) {
            u[33] = (float)d.targets;
            u[34] = (float)self.prims.data[d.prim].vertex_count;
            _gpu_model_upload_weights(self, d);
        }
        d.uniforms.write(0, &u, 144);
    }
    if (jm != null) free(jm);
}

void _gpu_model_upload_weights(*GpuModel self, _GpuDraw* d) {
    List<float>* w = &self.data.nodes.data[d.node].weights;
    float[64] small;
    *float buf = d.targets <= 64 ? &small[0] : alloc<float>(d.targets);
    for (k in 0..d.targets) buf[k] = k < w.size ? w.data[k] : 0.0;
    d.weights.write(0, buf, (uint64)d.targets * 4);
    if (d.targets > 64) free(buf);
}

// Sets node's morph target weights (as Gltf_set_weights) and sends them to
// the GPU at once, without a full update().
void GpuModel_set_weights(*GpuModel self, int node, *float weights, int count) {
    Gltf_set_weights(self.data, node, weights, count);
    for (i in 0..self.draws.size) {
        _GpuDraw* d = &self.draws.data[i];
        if (d.node == node && d.targets > 0) _gpu_model_upload_weights(self, d);
    }
}

// Lights the model with ibl (diffuse and specular ambient, scaled by
// ibl.intensity) instead of the hemisphere ambient of GpuModel.light; null
// goes back to it. ibl must outlive its use by the model.
void GpuModel_set_ibl(*GpuModel self, *GpuIbl ibl) {
    self.ibl = ibl;
}

// The textures bound when a feature is off: a zero storage buffer, a 1x1
// cube and a 1x1 depth texture.
Result<int, string> _gpu_model_fallbacks(*GpuModel self) {
    self._no_morph = Gpu_buffer(&self.gpu, 48, WGPUBufferUsage_Storage | WGPUBufferUsage_CopyDst)?;
    GpuTextureDesc cd = GpuTextureDesc{width: 1, height: 1, format: WGPUTextureFormat_RGBA16Float, cube: true};
    self._no_cube = Gpu_texture_with(&self.gpu, &cd)?;
    self._no_shadow = Gpu_depth_texture(&self.gpu, 1, 1, 0, 1)?;
    GpuSamplerOptions so = GpuSamplerOptions{wrap_u: WGPUAddressMode_ClampToEdge, wrap_v: WGPUAddressMode_ClampToEdge,
        compare: WGPUCompareFunction_LessEqual};
    self.shadow_sampler = Gpu_sampler_with(&self.gpu, &so)?;
    return Ok<int, string>(0);
}

// Turns on shadows from GpuModel.light (see GpuShadowOptions; null for the
// defaults). Each frame, after update() and before the pass that draws the
// model, render the shadow map with render_shadows (or render_shadows_in).
Result<int, string> GpuModel_enable_shadows(*GpuModel self, *GpuShadowOptions o) {
    GpuShadowOptions so;
    if (o != null) so = *o;
    if (so.size == 0) so.size = 2048;
    if (so.bias == 0.0) so.bias = 0.002;
    if (so.normal_bias == 0.0) so.normal_bias = 1.5;
    if (so.slope_bias == 0.0) so.slope_bias = 1.0;
    GpuModel_disable_shadows(self);
    GpuTexture map = Gpu_depth_texture(&self.gpu, so.size, so.size, WGPUTextureFormat_Depth32Float, 1)?;
    GpuVertexLayout layout = GpuVertexLayout{stride: (uint64)_GM_VERTEX_FLOATS * 4};
    defer layout.release();
    _gpu_model_layout(&layout);
    GpuPipelineDesc d = GpuPipelineDesc{wgsl: _gpu_model_shader, vertex: "vs_shadow", fragment: null, layout: &layout,
        depth: true, depth_format: WGPUTextureFormat_Depth32Float, depth_bias_slope: so.slope_bias};
    Result<GpuPipeline, string> p = Gpu_pipeline(&self.gpu, &d);
    if (!p.ok) {
        map.release();
        return Err<int, string>(p.error);
    }
    self.shadow = so;
    self.shadow_map = map;
    self.shadow_pipeline = p.value;
    self.shadows = true;
    return Ok<int, string>(0);
}

// Turns shadows off and releases the shadow map and its pipeline; does nothing when they
// are off.
void GpuModel_disable_shadows(*GpuModel self) {
    if (!self.shadows) return;
    self.shadow_map.release();
    self.shadow_pipeline.release();
    self.shadows = false;
}

// The light's view and orthographic projection around the model (or around
// GpuShadowOptions.center), and the shader's shadow settings, into the frame
// uniforms.
void _gpu_model_light(*GpuModel self) {
    Vec3 dir = self.light.direction.normalize();
    Vec3 c = self.shadow.center;
    float r = self.shadow.radius;
    if (r <= 0.0) {
        Vec3 lo;
        Vec3 hi;
        Gltf_bounds(self.data, &lo, &hi);
        Vec3 a;
        Vec3 b;
        for (k in 0..8) {
            Vec3 p = self.transform.point(Vec3{(k & 1) != 0 ? hi.x : lo.x, (k & 2) != 0 ? hi.y : lo.y, (k & 4) != 0 ? hi.z : lo.z});
            if (k == 0) {
                a = p;
                b = p;
            }
            a = Vec3{p.x < a.x ? p.x : a.x, p.y < a.y ? p.y : a.y, p.z < a.z ? p.z : a.z};
            b = Vec3{p.x > b.x ? p.x : b.x, p.y > b.y ? p.y : b.y, p.z > b.z ? p.z : b.z};
        }
        c = (a + b) * 0.5;
        r = (b - a).length() * 0.5;
        if (r <= 0.0) r = 1.0;
    }
    Vec3 up = dir.y > 0.99 || dir.y < -0.99 ? Vec3{0.0, 0.0, 1.0} : Vec3{0.0, 1.0, 0.0};
    Mat4 view = mat4_look_at(c - dir * (r * 2.0), c, up);
    self.light_view_proj = mat4_ortho(-r, r, -r, r, 0.0, r * 4.0) * view;
    self._shadow_params[0] = 1.0;
    self._shadow_params[1] = self.shadow.bias;
    self._shadow_params[2] = self.shadow.normal_bias * 2.0 * r / (float)self.shadow.size;
    self._shadow_params[3] = 1.0 / (float)self.shadow.size;
    float[20] f;
    for (k in 0..16) f[k] = self.light_view_proj.m[k];
    for (k in 0..4) f[16 + k] = self._shadow_params[k];
    self.frame.write(128, &f, sizeof(f));
}

void _gpu_model_shadow_draws(*GpuModel self, *GpuPass pass) {
    GpuPipeline* pipe = &self.shadow_pipeline;
    for (i in 0..self.draws.size) {
        _GpuDraw* d = &self.draws.data[i];
        if (self.materials.data[d.material].blend || !self.shown[d.node]) continue;
        _GpuPrim* pr = &self.prims.data[d.prim];
        pipe.bind(0, &self.frame);
        pipe.bind(1, &d.uniforms);
        pipe.bind(3, &d.joints);
        pipe.bind(14, d.targets > 0 ? &pr.morph : &self._no_morph);
        pipe.bind(15, d.targets > 0 ? &d.weights : &self._no_morph);
        pass.draw_indexed(pipe, &pr.vertices, &pr.indices, pr.index_count, 1);
    }
}

// Renders the shadow map from the light, in a submission of its own. The
// opaque and masked parts cast shadows (masks as if opaque), blended ones do
// not. Does nothing when shadows are off.
Result<int, string> GpuModel_render_shadows(*GpuModel self) {
    if (!self.shadows) return Ok<int, string>(0);
    _gpu_model_light(self);
    GpuPassOptions o = GpuPassOptions{depth: &self.shadow_map};
    GpuPass pass = Gpu_pass_with(&self.gpu, null, &o);
    _gpu_model_shadow_draws(self, &pass);
    return pass.end();
}

// GpuModel_render_shadows as a pass of enc, before the pass that draws the
// model in the same submission.
Result<int, string> GpuModel_render_shadows_in(*GpuModel self, *GpuEncoder enc) {
    if (!self.shadows) return Ok<int, string>(0);
    _gpu_model_light(self);
    GpuPassOptions o = GpuPassOptions{depth: &self.shadow_map};
    GpuPass pass = GpuEncoder_pass_with(enc, null, &o);
    _gpu_model_shadow_draws(self, &pass);
    return pass.end();
}

void _gpu_model_bind(*GpuModel self, *GpuPipeline pipe, _GpuDraw* d) {
    _GpuMat* mat = &self.materials.data[d.material];
    pipe.bind(0, &self.frame);
    pipe.bind(1, &d.uniforms);
    pipe.bind(2, &mat.uniforms);
    pipe.bind(3, &d.joints);
    for (k in 0..5) {
        pipe.bind_texture((uint32)(4 + k * 2), &self.textures.data[mat.tex[k]]);
        pipe.bind_sampler((uint32)(5 + k * 2), &self.samplers.data[mat.samp[k]]);
    }
    _GpuPrim* pr = &self.prims.data[d.prim];
    pipe.bind(14, d.targets > 0 ? &pr.morph : &self._no_morph);
    pipe.bind(15, d.targets > 0 ? &d.weights : &self._no_morph);
    pipe.bind_texture(16, self.ibl != null ? &self.ibl.irradiance : &self._no_cube);
    pipe.bind_texture(17, self.ibl != null ? &self.ibl.specular : &self._no_cube);
    pipe.bind_texture(18, self.ibl != null ? &self.ibl.brdf : &self.textures.data[1]);
    pipe.bind_sampler(19, self.ibl != null ? &self.ibl.sampler : &self.samplers.data[0]);
    pipe.bind_texture(20, self.shadows ? &self.shadow_map : &self._no_shadow);
    pipe.bind_sampler(21, &self.shadow_sampler);
}

// Draws the model into pass (which needs a depth texture) as seen by camera:
// opaque and masked parts first, then blended parts from back to front.
void GpuModel_draw(*GpuModel self, *GpuPass pass, *GpuCamera camera) {
    Mat4 vp = camera.proj * camera.view;
    Vec3 dir = self.light.direction.normalize();
    float[56] f;
    for (k in 0..16) f[k] = vp.m[k];
    f[16] = camera.eye.x;
    f[17] = camera.eye.y;
    f[18] = camera.eye.z;
    f[19] = 1.0;
    f[20] = dir.x;
    f[21] = dir.y;
    f[22] = dir.z;
    f[23] = self.light.intensity;
    f[24] = self.light.color.x;
    f[25] = self.light.color.y;
    f[26] = self.light.color.z;
    f[27] = 1.0;
    f[28] = self.light.ambient.x;
    f[29] = self.light.ambient.y;
    f[30] = self.light.ambient.z;
    f[31] = self.encode_srgb ? 1.0 : 0.0;
    if (self.shadows) {
        for (k in 0..16) f[32 + k] = self.light_view_proj.m[k];
        for (k in 0..4) f[48 + k] = self._shadow_params[k];
    }
    if (self.ibl != null) {
        f[52] = 1.0;
        f[53] = self.ibl.intensity;
        f[54] = GpuIbl_max_lod(self.ibl);
    }
    self.frame.write(0, &f, sizeof(f));
    List<int> blended;
    defer List_free(&blended);
    for (i in 0..self.draws.size) {
        _GpuDraw* d = &self.draws.data[i];
        if (!self.shown[d.node]) continue;
        if (self.materials.data[d.material].blend) {
            Vec3 c = (self.transform * self.world[d.node]).point(Vec3{0.0, 0.0, 0.0});
            d.depth = (camera.view.point(c)).z;
            List_push(&blended, i);
            continue;
        }
        GpuPipeline* pipe = &self.pipelines.data[d.pipeline];
        _gpu_model_bind(self, pipe, d);
        _GpuPrim* pr = &self.prims.data[d.prim];
        pass.draw_indexed(pipe, &pr.vertices, &pr.indices, pr.index_count, 1);
    }
    for (a in 0..blended.size) {
        for (b in a + 1..blended.size) {
            if (self.draws.data[blended.data[b]].depth < self.draws.data[blended.data[a]].depth) {
                int t = blended.data[a];
                blended.data[a] = blended.data[b];
                blended.data[b] = t;
            }
        }
    }
    for (i in 0..blended.size) {
        _GpuDraw* d = &self.draws.data[blended.data[i]];
        GpuPipeline* pipe = &self.pipelines.data[d.pipeline];
        _gpu_model_bind(self, pipe, d);
        _GpuPrim* pr = &self.prims.data[d.prim];
        pass.draw_indexed(pipe, &pr.vertices, &pr.indices, pr.index_count, 1);
    }
}

// A camera at eye looking at target, with a perspective of fovy radians.
GpuCamera gpu_camera(Vec3 eye, Vec3 target, float fovy, float aspect, float near, float far) {
    return GpuCamera{mat4_look_at(eye, target, Vec3{0.0, 1.0, 0.0}), mat4_perspective(fovy, aspect, near, far), eye};
}

// A camera that frames the whole model from the front, a little above.
GpuCamera GpuModel_camera(*GpuModel self, float aspect) {
    Vec3 lo;
    Vec3 hi;
    Gltf_bounds(self.data, &lo, &hi);
    Vec3 center = self.transform.point((lo + hi) * 0.5);
    float radius = (hi - lo).length() * 0.5;
    if (radius <= 0.0) radius = 1.0;
    Vec3 eye = center + Vec3{0.0, radius * 0.35, radius * 2.4};
    return gpu_camera(eye, center, 0.8, aspect, radius * 0.05, radius * 20.0);
}

// Releases every GPU object of the model and its buffers of matrices. It does not free the
// Gltf or the GpuIbl.
void GpuModel_release(*GpuModel self) {
    for (i in 0..self.pipelines.size) self.pipelines.data[i].release();
    for (i in 0..self.textures.size) self.textures.data[i].release();
    for (i in 0..self.samplers.size) self.samplers.data[i].release();
    for (i in 0..self.materials.size) self.materials.data[i].uniforms.release();
    for (i in 0..self.prims.size) {
        if (self.prims.data[i].drawable) {
            self.prims.data[i].vertices.release();
            self.prims.data[i].indices.release();
        }
    }
    for (i in 0..self.prims.size) {
        if (self.prims.data[i].targets > 0) self.prims.data[i].morph.release();
    }
    for (i in 0..self.draws.size) {
        self.draws.data[i].uniforms.release();
        self.draws.data[i].joints.release();
        if (self.draws.data[i].targets > 0) self.draws.data[i].weights.release();
    }
    GpuModel_disable_shadows(self);
    self._no_morph.release();
    self._no_cube.release();
    self._no_shadow.release();
    self.shadow_sampler.release();
    self.frame.release();
    List_free(&self.pipelines);
    List_free(&self.textures);
    List_free(&self.texture_keys);
    List_free(&self.samplers);
    List_free(&self.materials);
    List_free(&self.prims);
    List_free(&self.prim_start);
    List_free(&self.draws);
    if (self.world != null) free(self.world);
    self.world = null;
    if (self.shown != null) free(self.shown);
    self.shown = null;
}

// A skin's joint matrices in a GPU buffer, for skinning in your own shader:
// joint j's matrix (joint world matrix times inverse bind matrix) is the
// mat4x4<f32> at byte j * 64. Gpu_joints makes a storage buffer
// (var<storage, read> joints: array<mat4x4<f32>>); Gpu_joints_uniform a
// uniform buffer of capacity matrices (var<uniform> joints:
// array<mat4x4<f32>, capacity>), for targets without vertex storage buffers.
// As in glTF, a skinned mesh ignores its own node's transform:
//
//     let skin = joints[j.x] * w.x + joints[j.y] * w.y + joints[j.z] * w.z + joints[j.w] * w.w;
//     out.pos = view_proj * skin * vec4(p, 1.0);
//
// update() recomputes the matrices from the Gltf's current pose.
struct GpuJoints {
    GpuBuffer buffer;
    int skin;
    int count;
    *Mat4 world;
    *Mat4 matrices;
}

// The joint matrices of skin (an index into data.skins) in a storage buffer, filled from
// data's current pose. Fails when the skin does not exist.
Result<GpuJoints, string> Gpu_joints(*Gpu self, *Gltf data, int skin) {
    return _gpu_joints(self, data, skin, 0, WGPUBufferUsage_Storage);
}

// The joint matrices of skin in a uniform buffer of capacity matrices (the unused ones are
// identity). Fails when the skin does not exist or has more joints than capacity.
Result<GpuJoints, string> Gpu_joints_uniform(*Gpu self, *Gltf data, int skin, int capacity) {
    return _gpu_joints(self, data, skin, capacity, WGPUBufferUsage_Uniform);
}

Result<GpuJoints, string> _gpu_joints(*Gpu self, *Gltf data, int skin, int capacity, WGPUBufferUsage usage) {
    if (skin < 0 || skin >= data.skins.size) return Err<GpuJoints, string>(_gpu_fail("joints: no such skin", null));
    GpuJoints j;
    j.skin = skin;
    j.count = data.skins.data[skin].joints.size;
    if (capacity > 0 && capacity < j.count) return Err<GpuJoints, string>(_gpu_fail("joints: the skin has more joints than capacity", null));
    int n = capacity > 0 ? capacity : j.count;
    if (n < 1) n = 1;
    j.buffer = Gpu_buffer(self, (uint64)n * 64, usage | WGPUBufferUsage_CopyDst | WGPUBufferUsage_CopySrc)?;
    j.world = alloc<Mat4>(data.nodes.size + 1);
    j.matrices = alloc<Mat4>(n);
    for (i in 0..n) j.matrices[i] = mat4_identity();
    j.buffer.write(0, j.matrices, (uint64)n * 64);
    GpuJoints_update(&j, data);
    return Ok<GpuJoints, string>(j);
}

// Recomputes the joint matrices from data's current pose (after Gltf_animate) and writes
// them to the buffer. data must be the Gltf the joints were made from.
void GpuJoints_update(*GpuJoints self, *Gltf data) {
    Gltf_world(data, self.world);
    Gltf_joint_matrices(data, self.skin, self.world, self.matrices);
    if (self.count > 0) self.buffer.write(0, self.matrices, (uint64)self.count * 64);
}

// Releases the buffer and frees the matrices.
void GpuJoints_release(*GpuJoints self) {
    self.buffer.release();
    if (self.world != null) free(self.world);
    if (self.matrices != null) free(self.matrices);
    self.world = null;
    self.matrices = null;
}
