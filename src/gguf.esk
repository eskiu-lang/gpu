// gguf.esk: GGUF model files (the llama.cpp format): metadata, tensors, and
// dequantization of the common block formats.
//
//     Gguf f = gguf_load("llama-2-7b.Q4_0.gguf")?;
//     defer f.free();
//     int64 dim = f.int("llama.embedding_length", 0);
//     GgufTensor* wq = f.tensor("blk.0.attn_q.weight");
//
// The file is read into memory once; tensors point into it. dequantize()
// turns any supported type into floats: F32, F16, BF16, Q4_0, Q4_1, Q5_0,
// Q5_1, Q8_0, Q2_K, Q3_K, Q4_K, Q5_K and Q6_K.

import <io>;
import <mem>;
import <string>;
import <list>;
import <result>;
import <fs>;
import <libc>;

const int GGML_F32 = 0;
const int GGML_F16 = 1;
const int GGML_Q4_0 = 2;
const int GGML_Q4_1 = 3;
const int GGML_Q5_0 = 6;
const int GGML_Q5_1 = 7;
const int GGML_Q8_0 = 8;
const int GGML_Q2_K = 10;
const int GGML_Q3_K = 11;
const int GGML_Q4_K = 12;
const int GGML_Q5_K = 13;
const int GGML_Q6_K = 14;
const int GGML_BF16 = 30;

const int _GGUF_U8 = 0;
const int _GGUF_I8 = 1;
const int _GGUF_U16 = 2;
const int _GGUF_I16 = 3;
const int _GGUF_U32 = 4;
const int _GGUF_I32 = 5;
const int _GGUF_F32 = 6;
const int _GGUF_BOOL = 7;
const int _GGUF_STRING = 8;
const int _GGUF_ARRAY = 9;
const int _GGUF_U64 = 10;
const int _GGUF_I64 = 11;
const int _GGUF_F64 = 12;

// A metadata value: a number (num, inum), a string, or an array of elem_type
// values that starts at data in the file.
struct GgufValue {
    String key;
    int type;
    double num;
    int64 inum;
    String str;
    int elem_type;
    uint64 count;
    *uint8 data;
}

// ne[0] is the fastest-varying dimension (the row length of a matrix).
struct GgufTensor {
    String name;
    int type;
    int ndims;
    uint64[4] ne;
    uint64 count;
    *uint8 data;
    uint64 size;
}

struct Gguf {
    *uint8 file;
    uint64 len;
    List<GgufValue> meta;
    List<GgufTensor> tensors;
}

struct _GgufReader {
    *uint8 p;
    *uint8 end;
    bool bad;
}

String _gguf_err;

string _gguf_fail(string a, string b) {
    String_clear(&_gguf_err);
    String_append(&_gguf_err, "gguf: ");
    String_append(&_gguf_err, a);
    if (b != null) String_append(&_gguf_err, b);
    return _gguf_err.data;
}

bool _gguf_need(*_GgufReader r, uint64 n) {
    if (r.bad || (uint64)(r.end - r.p) < n) {
        r.bad = true;
        return false;
    }
    return true;
}

uint64 _gguf_u64(*_GgufReader r) {
    if (!_gguf_need(r, 8)) return 0;
    uint64 v = 0;
    memcpy(&v, r.p, 8);
    r.p = r.p + 8;
    return v;
}

uint32 _gguf_u32(*_GgufReader r) {
    if (!_gguf_need(r, 4)) return 0;
    uint32 v = 0;
    memcpy(&v, r.p, 4);
    r.p = r.p + 4;
    return v;
}

void _gguf_string(*_GgufReader r, String* out) {
    uint64 n = _gguf_u64(r);
    if (!_gguf_need(r, n)) return;
    for (i in 0..n) String_push(out, (char)r.p[i]);
    if (out.data == null) String_append(out, "");
    r.p = r.p + n;
}

int _gguf_size(int type) {
    if (type == _GGUF_U8 || type == _GGUF_I8 || type == _GGUF_BOOL) return 1;
    if (type == _GGUF_U16 || type == _GGUF_I16) return 2;
    if (type == _GGUF_U32 || type == _GGUF_I32 || type == _GGUF_F32) return 4;
    if (type == _GGUF_U64 || type == _GGUF_I64 || type == _GGUF_F64) return 8;
    return 0;
}

// Reads a scalar of type at the reader into v.
void _gguf_scalar(*_GgufReader r, int type, GgufValue* v) {
    int n = _gguf_size(type);
    if (n == 0 || !_gguf_need(r, (uint64)n)) {
        r.bad = true;
        return;
    }
    *uint8 p = r.p;
    if (type == _GGUF_U8 || type == _GGUF_BOOL) v.inum = (int64)p[0];
    if (type == _GGUF_I8) v.inum = (int64)(int8)p[0];
    if (type == _GGUF_U16) v.inum = (int64)((uint32)p[0] | (uint32)p[1] << 8);
    if (type == _GGUF_I16) v.inum = (int64)(int16)((uint32)p[0] | (uint32)p[1] << 8);
    if (type == _GGUF_U32) {
        uint32 x = 0;
        memcpy(&x, p, 4);
        v.inum = (int64)x;
    }
    if (type == _GGUF_I32) {
        int x = 0;
        memcpy(&x, p, 4);
        v.inum = (int64)x;
    }
    if (type == _GGUF_U64 || type == _GGUF_I64) memcpy(&v.inum, p, 8);
    v.num = (double)v.inum;
    if (type == _GGUF_F32) {
        float f = 0.0;
        memcpy(&f, p, 4);
        v.num = (double)f;
        v.inum = (int64)f;
    }
    if (type == _GGUF_F64) {
        memcpy(&v.num, p, 8);
        v.inum = (int64)v.num;
    }
    r.p = r.p + n;
}

// Skips one value of type (for array elements); false when it runs past the
// end.
bool _gguf_skip(*_GgufReader r, int type) {
    if (type == _GGUF_STRING) {
        uint64 n = _gguf_u64(r);
        if (!_gguf_need(r, n)) return false;
        r.p = r.p + n;
        return true;
    }
    if (type == _GGUF_ARRAY) {
        int et = (int)_gguf_u32(r);
        uint64 n = _gguf_u64(r);
        for (i in 0..n) {
            if (!_gguf_skip(r, et)) return false;
        }
        return !r.bad;
    }
    int sz = _gguf_size(type);
    if (sz == 0) {
        r.bad = true;
        return false;
    }
    if (!_gguf_need(r, (uint64)sz)) return false;
    r.p = r.p + sz;
    return true;
}

// Bytes per block and values per block of a tensor type; 0 when unknown.
void _ggml_block(int type, *uint64 bytes, *uint64 values) {
    *bytes = 0;
    *values = 1;
    if (type == GGML_F32) *bytes = 4;
    if (type == GGML_F16 || type == GGML_BF16) *bytes = 2;
    if (type == GGML_Q4_0) {
        *bytes = 18;
        *values = 32;
    }
    if (type == GGML_Q4_1) {
        *bytes = 20;
        *values = 32;
    }
    if (type == GGML_Q5_0) {
        *bytes = 22;
        *values = 32;
    }
    if (type == GGML_Q5_1) {
        *bytes = 24;
        *values = 32;
    }
    if (type == GGML_Q8_0) {
        *bytes = 34;
        *values = 32;
    }
    if (type == GGML_Q2_K) {
        *bytes = 84;
        *values = 256;
    }
    if (type == GGML_Q3_K) {
        *bytes = 110;
        *values = 256;
    }
    if (type == GGML_Q4_K) {
        *bytes = 144;
        *values = 256;
    }
    if (type == GGML_Q5_K) {
        *bytes = 176;
        *values = 256;
    }
    if (type == GGML_Q6_K) {
        *bytes = 210;
        *values = 256;
    }
}

Result<Gguf, string> gguf_load(string path) {
    int64 n = 0;
    *uint8 data = fs_read_all(path, &n);
    if (data == null) return Err<Gguf, string>(_gguf_fail("cannot read ", path));
    Result<Gguf, string> r = gguf_parse(data, (uint64)n);
    if (!r.ok) free(data);
    return r;
}

// Parses a GGUF file held in memory; the Gguf owns data from then on.
Result<Gguf, string> gguf_parse(*uint8 data, uint64 len) {
    Gguf g;
    g.file = data;
    g.len = len;
    _GgufReader r = _GgufReader{data, data + len, false};
    if (_gguf_u32(&r) != 0x46554747) return Err<Gguf, string>(_gguf_fail("not a GGUF file", null));
    uint32 version = _gguf_u32(&r);
    if (version < 2 || version > 3) return Err<Gguf, string>(_gguf_fail("unsupported version", null));
    uint64 ntensors = _gguf_u64(&r);
    uint64 nkv = _gguf_u64(&r);
    if (ntensors > len / 16 || nkv > len / 16) return Err<Gguf, string>(_gguf_fail("the header is corrupt", null));
    uint64 alignment = 32;
    for (i in 0..nkv) {
        GgufValue v;
        _gguf_string(&r, &v.key);
        v.type = (int)_gguf_u32(&r);
        if (v.type == _GGUF_STRING) _gguf_string(&r, &v.str);
        else if (v.type == _GGUF_ARRAY) {
            v.elem_type = (int)_gguf_u32(&r);
            v.count = _gguf_u64(&r);
            v.data = r.p;
            for (k in 0..v.count) {
                if (!_gguf_skip(&r, v.elem_type)) break;
            }
        } else _gguf_scalar(&r, v.type, &v);
        if (r.bad) {
            String_free(&v.key);
            String_free(&v.str);
            Gguf_free_meta(&g);
            return Err<Gguf, string>(_gguf_fail("the metadata is truncated", null));
        }
        if (v.key.data != null && strcmp(v.key.data, "general.alignment") == 0 && v.inum > 0) alignment = (uint64)v.inum;
        List_push(&g.meta, v);
    }
    for (i in 0..ntensors) {
        GgufTensor t;
        _gguf_string(&r, &t.name);
        t.ndims = (int)_gguf_u32(&r);
        if (t.ndims < 1 || t.ndims > 4) r.bad = true;
        t.count = 1;
        for (d in 0..4) t.ne[d] = 1;
        for (d in 0..t.ndims) {
            if (r.bad) break;
            t.ne[d] = _gguf_u64(&r);
            if (t.ne[d] == 0 || t.ne[d] > ((uint64)1 << 40) / t.count) r.bad = true;
            else t.count = t.count * t.ne[d];
        }
        t.type = (int)_gguf_u32(&r);
        uint64 offset = _gguf_u64(&r);
        t.size = offset;
        uint64 bb = 0;
        uint64 bv = 1;
        _ggml_block(t.type, &bb, &bv);
        if (r.bad || bb == 0 || t.count % bv != 0) {
            string err = _gguf_fail(r.bad ? "the tensor table is truncated" : "unsupported tensor type in ", r.bad ? null : t.name.data);
            String_free(&t.name);
            Gguf_free_meta(&g);
            return Err<Gguf, string>(err);
        }
        List_push(&g.tensors, t);
    }
    uint64 header = (uint64)(r.p - data);
    uint64 base = (header + alignment - 1) / alignment * alignment;
    for (i in 0..g.tensors.size) {
        GgufTensor* t = &g.tensors.data[i];
        uint64 bb = 0;
        uint64 bv = 1;
        _ggml_block(t.type, &bb, &bv);
        uint64 bytes = t.count / bv * bb;
        uint64 offset = t.size;
        if (base > len || offset > len - base || bytes > len - base - offset) {
            string err = _gguf_fail("tensor data past the end of the file: ", t.name.data);
            Gguf_free_meta(&g);
            return Err<Gguf, string>(err);
        }
        t.data = data + base + offset;
        t.size = bytes;
    }
    return Ok<Gguf, string>(g);
}

GgufValue* Gguf_value(*Gguf self, string key) {
    for (i in 0..self.meta.size) {
        if (strcmp(self.meta.data[i].key.data, key) == 0) return &self.meta.data[i];
    }
    return null;
}

int64 Gguf_int(*Gguf self, string key, int64 dflt) {
    GgufValue* v = Gguf_value(self, key);
    if (v == null || v.type == _GGUF_STRING || v.type == _GGUF_ARRAY) return dflt;
    return v.inum;
}

double Gguf_float(*Gguf self, string key, double dflt) {
    GgufValue* v = Gguf_value(self, key);
    if (v == null || v.type == _GGUF_STRING || v.type == _GGUF_ARRAY) return dflt;
    return v.num;
}

string Gguf_string(*Gguf self, string key) {
    GgufValue* v = Gguf_value(self, key);
    if (v == null || v.type != _GGUF_STRING) return null;
    return v.str.data;
}

// The strings of an array value, appended to out (empty when the key is not
// a string array).
void Gguf_strings(*Gguf self, string key, List<String>* out) {
    GgufValue* v = Gguf_value(self, key);
    if (v == null || v.type != _GGUF_ARRAY || v.elem_type != _GGUF_STRING) return;
    _GgufReader r = _GgufReader{v.data, self.file + self.len, false};
    for (i in 0..v.count) {
        String s;
        _gguf_string(&r, &s);
        if (r.bad) {
            String_free(&s);
            return;
        }
        List_push(out, s);
    }
}

// The numbers of an array value as floats, into out (which holds count
// values); returns how many were read.
uint64 Gguf_floats(*Gguf self, string key, *float out, uint64 count) {
    GgufValue* v = Gguf_value(self, key);
    if (v == null || v.type != _GGUF_ARRAY || v.elem_type == _GGUF_STRING || v.elem_type == _GGUF_ARRAY) return 0;
    _GgufReader r = _GgufReader{v.data, self.file + self.len, false};
    uint64 n = v.count < count ? v.count : count;
    for (i in 0..n) {
        GgufValue x;
        _gguf_scalar(&r, v.elem_type, &x);
        if (r.bad) return i;
        out[i] = (float)x.num;
    }
    return n;
}

GgufTensor* Gguf_tensor(*Gguf self, string name) {
    for (i in 0..self.tensors.size) {
        if (strcmp(self.tensors.data[i].name.data, name) == 0) return &self.tensors.data[i];
    }
    return null;
}

void Gguf_free_meta(*Gguf self) {
    for (i in 0..self.meta.size) {
        String_free(&self.meta.data[i].key);
        String_free(&self.meta.data[i].str);
    }
    for (i in 0..self.tensors.size) String_free(&self.tensors.data[i].name);
    List_free(&self.meta);
    List_free(&self.tensors);
}

void Gguf_free(*Gguf self) {
    Gguf_free_meta(self);
    if (self.file != null) free(self.file);
    self.file = null;
}

// ── Dequantization ───────────────────────────────────────────────────────────

float ggml_half(*uint8 p) {
    uint32 h = (uint32)p[0] | (uint32)p[1] << 8;
    uint32 sign = (h & 0x8000) << 16;
    uint32 exp = (h >> 10) & 0x1F;
    uint32 man = h & 0x3FF;
    uint32 bits = 0;
    if (exp == 0) {
        if (man != 0) {
            exp = 113;
            while ((man & 0x400) == 0) {
                man = man << 1;
                exp--;
            }
            bits = sign | (exp << 23) | ((man & 0x3FF) << 13);
        } else bits = sign;
    } else if (exp == 31) bits = sign | 0x7F800000 | (man << 13);
    else bits = sign | ((exp + 112) << 23) | (man << 13);
    float f = 0.0;
    memcpy(&f, &bits, 4);
    return f;
}

void _ggml_scale_min_k4(int j, *uint8 q, *uint8 d, *uint8 m) {
    if (j < 4) {
        *d = q[j] & 63;
        *m = q[j + 4] & 63;
    } else {
        *d = (q[j + 4] & 0xF) | ((q[j - 4] >> 6) << 4);
        *m = (q[j + 4] >> 4) | ((q[j] >> 6) << 4);
    }
}

// Writes the count values of a tensor of type stored at src into out.
void ggml_dequantize(int type, *uint8 src, *float out, uint64 count) {
    if (type == GGML_F32) {
        memcpy(out, src, (int64)(count * 4));
        return;
    }
    if (type == GGML_F16) {
        for (i in 0..count) out[i] = ggml_half(src + i * 2);
        return;
    }
    if (type == GGML_BF16) {
        for (i in 0..count) {
            uint32 bits = ((uint32)src[i * 2] | (uint32)src[i * 2 + 1] << 8) << 16;
            memcpy(&out[i], &bits, 4);
        }
        return;
    }
    uint64 bb = 0;
    uint64 bv = 1;
    _ggml_block(type, &bb, &bv);
    uint64 nb = count / bv;
    for (b in 0..nb) {
        *uint8 x = src + b * bb;
        *float y = out + b * bv;
        if (type == GGML_Q4_0) {
            float d = ggml_half(x);
            for (j in 0..16) {
                y[j] = (float)((int)(x[2 + j] & 0xF) - 8) * d;
                y[j + 16] = (float)((int)(x[2 + j] >> 4) - 8) * d;
            }
        } else if (type == GGML_Q4_1) {
            float d = ggml_half(x);
            float m = ggml_half(x + 2);
            for (j in 0..16) {
                y[j] = (float)(x[4 + j] & 0xF) * d + m;
                y[j + 16] = (float)(x[4 + j] >> 4) * d + m;
            }
        } else if (type == GGML_Q5_0 || type == GGML_Q5_1) {
            bool one = type == GGML_Q5_1;
            float d = ggml_half(x);
            float m = one ? ggml_half(x + 2) : 0.0;
            *uint8 qh = x + (one ? 4 : 2);
            *uint8 qs = qh + 4;
            uint32 h = (uint32)qh[0] | (uint32)qh[1] << 8 | (uint32)qh[2] << 16 | (uint32)qh[3] << 24;
            for (j in 0..16) {
                int x0 = (int)(qs[j] & 0xF) | (int)(((h >> j) & 1) << 4);
                int x1 = (int)(qs[j] >> 4) | (int)(((h >> (j + 16)) & 1) << 4);
                y[j] = one ? (float)x0 * d + m : (float)(x0 - 16) * d;
                y[j + 16] = one ? (float)x1 * d + m : (float)(x1 - 16) * d;
            }
        } else if (type == GGML_Q8_0) {
            float d = ggml_half(x);
            for (j in 0..32) y[j] = (float)(int8)x[2 + j] * d;
        } else if (type == GGML_Q2_K) {
            *uint8 scales = x;
            *uint8 q = x + 16;
            float d = ggml_half(x + 80);
            float dmin = ggml_half(x + 82);
            int is = 0;
            int at = 0;
            for (n in 0..2) {
                int shift = 0;
                for (j in 0..4) {
                    uint8 sc = scales[is];
                    is++;
                    float dl = d * (float)(sc & 0xF);
                    float ml = dmin * (float)(sc >> 4);
                    for (l in 0..16) {
                        y[at] = dl * (float)((q[n * 32 + l] >> shift) & 3) - ml;
                        at++;
                    }
                    sc = scales[is];
                    is++;
                    dl = d * (float)(sc & 0xF);
                    ml = dmin * (float)(sc >> 4);
                    for (l in 0..16) {
                        y[at] = dl * (float)((q[n * 32 + l + 16] >> shift) & 3) - ml;
                        at++;
                    }
                    shift += 2;
                }
            }
        } else if (type == GGML_Q3_K) {
            *uint8 hm = x;
            *uint8 q = x + 32;
            *uint8 sc = x + 96;
            float d_all = ggml_half(x + 108);
            uint32[4] aux;
            memcpy(&aux[0], sc, 12);
            uint32 tmp = aux[2];
            uint32 km1 = 0x03030303;
            uint32 km2 = 0x0f0f0f0f;
            aux[2] = ((aux[0] >> 4) & km2) | (((tmp >> 4) & km1) << 4);
            aux[3] = ((aux[1] >> 4) & km2) | (((tmp >> 6) & km1) << 4);
            aux[0] = (aux[0] & km2) | (((tmp >> 0) & km1) << 4);
            aux[1] = (aux[1] & km2) | (((tmp >> 2) & km1) << 4);
            *int8 scales = (*int8)&aux[0];
            int is = 0;
            int at = 0;
            uint8 m = 1;
            for (n in 0..2) {
                int shift = 0;
                for (j in 0..4) {
                    float dl = d_all * (float)((int)scales[is] - 32);
                    is++;
                    for (l in 0..16) {
                        int v = (int)((q[n * 32 + l] >> shift) & 3) - ((hm[l] & m) != 0 ? 0 : 4);
                        y[at] = dl * (float)v;
                        at++;
                    }
                    dl = d_all * (float)((int)scales[is] - 32);
                    is++;
                    for (l in 0..16) {
                        int v = (int)((q[n * 32 + l + 16] >> shift) & 3) - ((hm[l + 16] & m) != 0 ? 0 : 4);
                        y[at] = dl * (float)v;
                        at++;
                    }
                    shift += 2;
                    m = (uint8)(m << 1);
                }
            }
        } else if (type == GGML_Q4_K || type == GGML_Q5_K) {
            bool five = type == GGML_Q5_K;
            float d = ggml_half(x);
            float dmin = ggml_half(x + 2);
            *uint8 scales = x + 4;
            *uint8 qh = x + 16;
            *uint8 q = five ? x + 48 : x + 16;
            int is = 0;
            int at = 0;
            uint8 u1 = 1;
            uint8 u2 = 2;
            for (j in 0..4) {
                uint8 sc = 0;
                uint8 mm = 0;
                _ggml_scale_min_k4(is, scales, &sc, &mm);
                float d1 = d * (float)sc;
                float m1 = dmin * (float)mm;
                _ggml_scale_min_k4(is + 1, scales, &sc, &mm);
                float d2 = d * (float)sc;
                float m2 = dmin * (float)mm;
                for (l in 0..32) {
                    int v = (int)(q[j * 32 + l] & 0xF) + (five && (qh[l] & u1) != 0 ? 16 : 0);
                    y[at] = d1 * (float)v - m1;
                    at++;
                }
                for (l in 0..32) {
                    int v = (int)(q[j * 32 + l] >> 4) + (five && (qh[l] & u2) != 0 ? 16 : 0);
                    y[at] = d2 * (float)v - m2;
                    at++;
                }
                is += 2;
                u1 = (uint8)(u1 << 2);
                u2 = (uint8)(u2 << 2);
            }
        } else if (type == GGML_Q6_K) {
            *uint8 ql = x;
            *uint8 qh = x + 128;
            *int8 sc = (*int8)(x + 192);
            float d = ggml_half(x + 208);
            for (n in 0..2) {
                *uint8 l0 = ql + n * 64;
                *uint8 h0 = qh + n * 32;
                *int8 s0 = sc + n * 8;
                *float yy = y + n * 128;
                for (l in 0..32) {
                    int is = l / 16;
                    int q1 = (int)((l0[l] & 0xF) | (((h0[l] >> 0) & 3) << 4)) - 32;
                    int q2 = (int)((l0[l + 32] & 0xF) | (((h0[l] >> 2) & 3) << 4)) - 32;
                    int q3 = (int)((l0[l] >> 4) | (((h0[l] >> 4) & 3) << 4)) - 32;
                    int q4 = (int)((l0[l + 32] >> 4) | (((h0[l] >> 6) & 3) << 4)) - 32;
                    yy[l] = d * (float)s0[is] * (float)q1;
                    yy[l + 32] = d * (float)s0[is + 2] * (float)q2;
                    yy[l + 64] = d * (float)s0[is + 4] * (float)q3;
                    yy[l + 96] = d * (float)s0[is + 6] * (float)q4;
                }
            }
        }
    }
}

// The tensor's values as floats (out holds t.count values).
void GgufTensor_dequantize(*GgufTensor self, *float out) {
    ggml_dequantize(self.type, self.data, out, self.count);
}
