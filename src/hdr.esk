// hdr.esk: Radiance .hdr (RGBE) decoding to floats (imported by <gpu/image>).
//
// Reads the text header (FORMAT=32-bit_rle_rgbe; XYZE files are rejected),
// the resolution line (-Y H +X W, or +Y H +X W stored bottom-up) and the
// pixels: flat, run-length encoded per channel (the common "new" RLE) or with
// the old repeat-the-last-pixel runs. Each RGBE pixel becomes three floats,
// mantissa * 2^(exponent - 136), as Radiance and stb_image do, with alpha 1.
//
//     HdrBitmap sky = hdr_load("sky.hdr")?;
//     defer sky.free();
//     uint16* half = alloc<uint16>((int)(sky.width * sky.height * 4));
//     sky.to_half(half);   // for an RGBA16Float texture

import <mem>;
import <fs>;
import <math>;
import <string>;
import <result>;

// A float image: four floats per pixel (red, green, blue in linear light and
// an alpha of 1), rows packed with the top row first.
struct HdrBitmap {
    uint32 width;
    uint32 height;
    *float rgba;
}

void HdrBitmap_free(*HdrBitmap self) {
    if (self.rgba != null) free((*void)self.rgba);
    self.rgba = null;
    self.width = 0;
    self.height = 0;
}

// The IEEE half-precision bits of f, rounded to nearest even; values past the
// half range become infinity, NaN stays NaN.
uint16 image_f16(float f) {
    uint32 x = *(*uint32)&f;
    uint32 sign = (x >> 16) & 0x8000;
    int e = (int)((x >> 23) & 255);
    uint32 m = x & 0x7FFFFF;
    if (e == 255) return (uint16)(sign | 0x7C00 | (m != 0 ? (uint32)0x200 : (uint32)0));
    int he = e - 127 + 15;
    if (he >= 31) return (uint16)(sign | 0x7C00);
    if (he <= 0) {
        if (he < -10) return (uint16)sign;
        m = m | 0x800000;
        uint32 shift = (uint32)(14 - he);
        uint32 hm = m >> shift;
        uint32 rest = m & ((1 << shift) - 1);
        uint32 halfway = (uint32)1 << (shift - 1);
        if (rest > halfway || (rest == halfway && (hm & 1) != 0)) hm++;
        return (uint16)(sign | hm);
    }
    uint32 h = sign | ((uint32)he << 10) | (m >> 13);
    uint32 r = m & 0x1FFF;
    if (r > 0x1000 || (r == 0x1000 && (h & 1) != 0)) h++;
    return (uint16)h;
}

// Writes the image as half floats (four per pixel) to out, for an RGBA16Float
// texture.
void HdrBitmap_to_half(*HdrBitmap self, *uint16 out) {
    uint64 n = (uint64)self.width * self.height * 4;
    for (i in 0..n) out[i] = image_f16(self.rgba[i]);
}

struct _Hdr {
    *uint8 p;
    uint64 len;
    uint64 at;
}

// The next header line (without its newline) into line; false at the end of
// the data.
bool _hdr_line(*_Hdr h, *char line, int cap) {
    if (h.at >= h.len) return false;
    int n = 0;
    while (h.at < h.len && h.p[h.at] != 10) {
        if (n < cap - 1) {
            line[n] = (char)h.p[h.at];
            n++;
        }
        h.at++;
    }
    h.at++;
    line[n] = (char)0;
    return true;
}

bool _hdr_prefix(*char s, string pre) {
    return strncmp((string)s, pre, (int)strlen(pre)) == 0;
}

// Reads an unsigned number at s[*i], skipping spaces first; -1 when none.
int64 _hdr_num(*char s, *int i) {
    while (s[*i] == ' ') *i = *i + 1;
    if (s[*i] < '0' || s[*i] > '9') return -1;
    int64 v = 0;
    while (s[*i] >= '0' && s[*i] <= '9' && v < 100000000) {
        v = v * 10 + (int64)(s[*i] - '0');
        *i = *i + 1;
    }
    return v;
}

void _hdr_put(*float o, *uint8 rgbe, *double scale) {
    double f = rgbe[3] == 0 ? 0.0 : scale[(int)rgbe[3]];
    o[0] = (float)((double)rgbe[0] * f);
    o[1] = (float)((double)rgbe[1] * f);
    o[2] = (float)((double)rgbe[2] * f);
    o[3] = 1.0;
}

// Reads one scanline of w RGBE pixels into row (4 bytes per pixel).
bool _hdr_scanline(*_Hdr h, *uint8 row, uint32 w) {
    if (w >= 8 && w < 0x8000 && h.at + 4 <= h.len && h.p[h.at] == 2 && h.p[h.at + 1] == 2 && (h.p[h.at + 2] & 0x80) == 0) {
        uint32 n = ((uint32)h.p[h.at + 2] << 8) | (uint32)h.p[h.at + 3];
        if (n != w) return false;
        h.at += 4;
        for (c in 0..4) {
            uint32 x = 0;
            while (x < w) {
                if (h.at >= h.len) return false;
                uint32 count = (uint32)h.p[h.at];
                h.at++;
                if (count > 128) {
                    count -= 128;
                    if (count > w - x || h.at >= h.len) return false;
                    uint8 v = h.p[h.at];
                    h.at++;
                    for (k in 0..count) row[(x + k) * 4 + c] = v;
                } else {
                    if (count == 0 || count > w - x || h.at + count > h.len) return false;
                    for (k in 0..count) row[(x + k) * 4 + c] = h.p[h.at + k];
                    h.at += count;
                }
                x += count;
            }
        }
        return true;
    }
    // Flat pixels, with the old runs: (1, 1, 1, n) repeats the last pixel n
    // times, shifted left by 8 for each run that follows another.
    uint32 x = 0;
    int shift = 0;
    while (x < w) {
        if (h.at + 4 > h.len) return false;
        *uint8 q = h.p + h.at;
        h.at += 4;
        if (q[0] == 1 && q[1] == 1 && q[2] == 1) {
            if (x == 0) return false;
            uint32 count = (uint32)q[3] << shift;
            if (count > w - x) return false;
            for (k in 0..count) {
                for (c in 0..4) row[(x + k) * 4 + c] = row[(x - 1) * 4 + c];
            }
            x += count;
            shift += 8;
        } else {
            for (c in 0..4) row[x * 4 + c] = q[c];
            x++;
            shift = 0;
        }
    }
    return true;
}

// Decodes a Radiance .hdr file held in memory.
Result<HdrBitmap, string> hdr_decode(*uint8 data, uint64 len) {
    if (data == null || len < 2 || data[0] != '#' || data[1] != '?') return Err<HdrBitmap, string>("hdr: not a Radiance file");
    _Hdr h = _Hdr{data, len, 0};
    let line: char[256];
    _hdr_line(&h, &line[0], 256);
    while (true) {
        if (!_hdr_line(&h, &line[0], 256)) return Err<HdrBitmap, string>("hdr: truncated header");
        if (line[0] == (char)0) break;
        if (_hdr_prefix(&line[0], "FORMAT=") && !_hdr_prefix(&line[0], "FORMAT=32-bit_rle_rgbe")) {
            return Err<HdrBitmap, string>("hdr: only the 32-bit_rle_rgbe format is supported");
        }
    }
    if (!_hdr_line(&h, &line[0], 256)) return Err<HdrBitmap, string>("hdr: no resolution line");
    bool flip = false;
    if (_hdr_prefix(&line[0], "+Y ")) flip = true;
    else if (!_hdr_prefix(&line[0], "-Y ")) return Err<HdrBitmap, string>("hdr: unsupported orientation (only -Y and +Y rows of +X pixels)");
    int i = 3;
    int64 rows = _hdr_num(&line[0], &i);
    while (line[i] == ' ') i++;
    if (line[i] != '+' || line[i + 1] != 'X') return Err<HdrBitmap, string>("hdr: unsupported orientation (only -Y and +Y rows of +X pixels)");
    i += 2;
    int64 cols = _hdr_num(&line[0], &i);
    if (rows <= 0 || cols <= 0 || rows > 65536 || cols > 65536) return Err<HdrBitmap, string>("hdr: bad resolution");
    double[256] scale;
    for (e in 1..256) scale[e] = pow(2.0, (double)(e - 136));
    HdrBitmap img = HdrBitmap{(uint32)cols, (uint32)rows, alloc<float>((int)(cols * rows * 4))};
    *uint8 row = alloc<uint8>((int)(cols * 4));
    defer free((*void)row);
    for (y in 0..rows) {
        if (!_hdr_scanline(&h, row, (uint32)cols)) {
            HdrBitmap_free(&img);
            return Err<HdrBitmap, string>("hdr: truncated or corrupt pixel data");
        }
        int64 oy = flip ? rows - 1 - y : y;
        for (x in 0..cols) _hdr_put(img.rgba + (oy * cols + x) * 4, row + x * 4, &scale[0]);
    }
    return Ok<HdrBitmap, string>(img);
}

// Reads a file and decodes it.
Result<HdrBitmap, string> hdr_load(string path) {
    int64 n = 0;
    *uint8 data = fs_read_all(path, &n);
    if (data == null) return Err<HdrBitmap, string>("hdr: cannot read file");
    defer free((*void)data);
    return hdr_decode(data, (uint64)n);
}
